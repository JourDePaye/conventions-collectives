# Convention collective nationale des journalistes du 1er novembre 1976 (IDCC 1480).
#
# Version 2025.2: the grid of version 2025.1 (avenant n° 4 of 4 July 2025, journalists of press
# agencies), with the same effective date, which it replaces. It declares the extension and the
# form of press: the agencies' grid applies to the journalists of press agencies only; the other
# forms of press have their own salary accords, not modelled, so no minimum here.
# A released version is immutable: later corrections require a new version.

validFrom: 2025-09-01
extension: 2025-09-19
sources:
  - >-
    Avenant n° 4 du 4 juillet 2025 à l'accord du 3 juillet 2019 relatif à la classification
    et aux salaires minima des journalistes d'agences de presse, Légifrance, KALIARTI000052299406 :
    article 2 et annexe 1 (nouvelle annexe 4 de l'accord) pour les salaires mensuels bruts minima
    garantis des groupes 1 à 8 pour 35 heures, de 1 905,12 € à 3 612,64 € ; article 4, application
    au 1er septembre 2025 pour les entreprises adhérentes à l'organisation professionnelle
    d'employeurs signataire, et à partir du jour de la publication de l'arrêté d'extension pour les
    autres entreprises du champ de l'accord du 3 juillet 2019 (agences de presse).
  - >-
    Arrêté du 12 septembre 2025 portant extension de l'avenant n° 4,
    Journal officiel du 19 septembre 2025, NOR TSST2525479A, JORFTEXT000052260481.
  - >-
    Convention collective nationale des journalistes (KALICONT000005635444) : les autres formes de
    presse (presse quotidienne nationale et régionale, presse hebdomadaire régionale, presse
    magazine, presse d'information spécialisée, radiodiffusion…) ont leurs propres accords de
    salaires, que cette version ne modélise pas.
---
salarié . convention collective . journalistes:
  titre: Journalistes (IDCC 1480)
  valeur: convention collective = 'journalistes'

salarié . convention collective . journalistes . forme de presse:
  titre: Forme de presse de l'employeur
  description: |
    Les agences de presse relèvent de l'accord du 3 juillet 2019 et de son avenant n° 4 ; les
    autres formes de presse ont leurs propres accords de salaires, non modélisés.
  applicable si: convention collective = 'journalistes'
  une possibilité:
    - "'agences de presse'"
    - "'autres formes de presse'"
  par défaut: "'agences de presse'"

salarié . convention collective . journalistes . grille applicable:
  titre: La grille des agences de presse s'applique
  applicable si: convention collective = 'journalistes'
  valeur: forme de presse = 'agences de presse'

salarié . convention collective . journalistes . groupe:
  titre: Groupe de qualification
  description: Groupe 1 à 8 de la grille des salaires minima conventionnels des journalistes d'agences de presse.
  applicable si: convention collective = 'journalistes'
  par défaut: "'non renseigné'"

salarié . convention collective . journalistes . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: |
    Minimum mensuel brut à temps plein des journalistes d'agences de presse, proratisé selon la
    quotité de travail ; 0 pour les autres formes de presse.
  applicable si: convention collective = 'journalistes'
  unité: €/mois
  valeur: grille * contrat . temps de travail . quotité

salarié . convention collective . journalistes . salaire minimum conventionnel . grille:
  titre: Grille mensuelle à temps plein
  unité: €/mois
  variations:
    - si: grille applicable = non
      alors: 0 €/mois
    - si: groupe = '1'
      alors: 1905.12 €/mois
    - si: groupe = '2'
      alors: 2105.71 €/mois
    - si: groupe = '3'
      alors: 2299.90 €/mois
    - si: groupe = '4'
      alors: 2506.54 €/mois
    - si: groupe = '5'
      alors: 2752.38 €/mois
    - si: groupe = '6'
      alors: 3010.45 €/mois
    - si: groupe = '7'
      alors: 3252.50 €/mois
    - si: groupe = '8'
      alors: 3612.64 €/mois
    - sinon: 0 €/mois

salarié . convention collective . journalistes . groupe hors grille:
  titre: Groupe absent de la grille
  description: Le groupe n'existe pas dans la grille des agences de presse ; jamais pour les autres formes de presse.
  applicable si: convention collective = 'journalistes'
  valeur:
    toutes ces conditions:
      - grille applicable
      - salaire minimum conventionnel . grille = 0 €/mois
