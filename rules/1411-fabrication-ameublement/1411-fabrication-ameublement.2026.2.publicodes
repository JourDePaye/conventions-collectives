    - si: niveau = 'C33'
      alors: 4956.00 €/mois
    - sinon: 0 €/mois

salarié . convention collective . fabrication ameublement . niveau hors grille:
  titre: Échelon absent de la grille
  description: L'échelon n'existe pas dans la grille des salaires minima.
  applicable si: convention collective = 'fabrication ameublement'
  # « est non applicable » ne teste pas l'absence de valeur et dépend de l'ordre
  # d'évaluation : la grille vaut donc 0 €/mois pour un échelon inconnu.
  valeur: salaire minimum conventionnel . grille = 0 €/mois

salarié . convention collective . fabrication ameublement . cotisations:
  applicable si: convention collective = 'fabrication ameublement'
  valeur: oui

salarié . convention collective . fabrication ameublement . cotisations . formation professionnelle:
  applicable si: convention collective = 'fabrication ameublement'
  remplace: salarié . cotisations . formation professionnelle
  somme:
    - salarié . cotisations . formation professionnelle
    - contribution conventionnelle

salarié . convention collective . fabrication ameublement . cotisations . formation professionnelle . contribution conventionnelle:
  applicable si:
    toutes ces conditions:
      - convention collective = 'fabrication ameublement'
      - entreprise . salariés . effectif >= 10
  description: Contribution conventionnelle additionnelle de formation professionnelle de 0,50 % de l'assiette des cotisations pour les entreprises d'au moins 10 salariés.
  valeur: salarié . cotisations . assiette * 0.50%
