            alors: 2644.00 €/mois
          - si: ancienneté >= 3 an
            alors: 2629.00 €/mois
          - sinon: 0 €/mois
    - si: niveau = 'C'
      alors:
        variations:
          - si: ancienneté >= 18 an
            alors: 4130.00 €/mois
          - si: ancienneté >= 15 an
            alors: 4115.00 €/mois
          - si: ancienneté >= 12 an
            alors: 4100.00 €/mois
          - si: ancienneté >= 9 an
            alors: 4085.00 €/mois
          - si: ancienneté >= 6 an
            alors: 4070.00 €/mois
          - si: ancienneté >= 3 an
            alors: 4055.00 €/mois
          - sinon: 0 €/mois
    - si: niveau = 'D'
      alors:
