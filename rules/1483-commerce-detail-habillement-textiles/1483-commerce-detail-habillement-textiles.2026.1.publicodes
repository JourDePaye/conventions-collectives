salarié . convention collective . commerce de détail habillement . minimum d'encadrement selon l'ancienneté:
  titre: Minimum des agents de maîtrise B et des cadres selon l'ancienneté
  description: |
    Rémunération minima du personnel d'encadrement des catégories B, C et D à partir de 3 ans
    d'ancienneté (article 1, II), pour 151,67 heures par mois. Vaut 0 €/mois avant 3 ans et pour
    les autres catégories.
  applicable si: convention collective = 'commerce de détail habillement'
  unité: €/mois
  variations:
    - si: niveau = 'B'
      alors:
        variations:
          - si: ancienneté >= 18 an
            alors: 2704.00 €/mois
          - si: ancienneté >= 15 an
            alors: 2689.00 €/mois
          - si: ancienneté >= 12 an
            alors: 2674.00 €/mois
          - si: ancienneté >= 9 an
            alors: 2659.00 €/mois
          - si: ancienneté >= 6 an
            alors: 2644.00 €/mois
          - si: ancienneté >= 3 an
            alors: 2629.00 €/mois
          - sinon: 0 €/mois
    - si: niveau = 'C'
      alors:
        variations:
          - si: ancienneté >= 18 an
            alors: 4130.00 €/mois
          - si: ancienneté >= 15 an
            alors: 4115.00 €/mois
          - si: ancienneté >= 12 an
            alors: 4100.00 €/mois
          - si: ancienneté >= 9 an
            alors: 4085.00 €/mois
          - si: ancienneté >= 6 an
            alors: 4070.00 €/mois
          - si: ancienneté >= 3 an
            alors: 4055.00 €/mois
          - sinon: 0 €/mois
    - si: niveau = 'D'
      alors:
        variations:
          - si: ancienneté >= 18 an
            alors: 4289.00 €/mois
          - si: ancienneté >= 15 an
            alors: 4274.00 €/mois
          - si: ancienneté >= 12 an
            alors: 4259.00 €/mois
          - si: ancienneté >= 9 an
            alors: 4244.00 €/mois
          - si: ancienneté >= 6 an
            alors: 4229.00 €/mois
          - si: ancienneté >= 3 an
            alors: 4214.00 €/mois
          - sinon: 0 €/mois
    - sinon: 0 €/mois

salarié . convention collective . commerce de détail habillement . niveau hors grille:
  titre: Catégorie absente de la grille
  description: La catégorie n'existe pas dans le barème des rémunérations minima.
  applicable si: convention collective = 'commerce de détail habillement'
  # « est non applicable » ne teste pas l'absence de valeur et dépend de l'ordre
  # d'évaluation : le barème vaut donc 0 €/mois pour une catégorie inconnue.
  valeur: barème = 0 €/mois
