# Convention collective nationale des vins, cidres, jus de fruits, sirops, spiritueux et liqueurs de France du 13 février 1969 (IDCC 493, brochure 3029).
#
# Version 2026.2 : mêmes règles et même grille que 2026.1, qu'elle remplace (même date d'effet) ; corrige les
# sources (2026.1 citait un accord du 10 décembre 2025 et un arrêté qui ne sont pas ceux de cette grille) et
# déclare l'extension, à partir de laquelle l'avenant lie aussi les entreprises non adhérentes.

validFrom: 2026-02-01
extension: 2026-06-01
sources:
  - >-
    Avenant n° 31 du 13 février 2026 relatif aux salaires minima conventionnels, IDCC 493, Légifrance
    KALITEXT000054253980 : article 1er (salaires minima mensuels pour 151,67 heures à compter du 1er février
    2026 : 1A = 1 844 €, 1B = 1 879 €, 1C = 1 913 €, 2A = 1 923 €, 2B = 1 954 €, 2C = 1 986 €, 3A = 1 996 €,
    3B = 2 026 €, 3C = 2 057 €, 4A = 2 099 €, 4B = 2 151 €, 5A = 2 233 €, 5B = 2 315 €, 5C = 2 398 €,
    6A = 2 533 €, 6B = 2 688 €, 7A = 2 667 €, 8A = 2 874 €, 9A = 3 287 €, 9B = 4 145 €, 10A = 5 023 €) ;
    article 3 (entrée en vigueur le 1er février 2026 pour les membres des organisations signataires, et pour
    les autres entreprises le premier jour du mois civil suivant la publication de l'arrêté d'extension).
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000054253980
  - >-
    Arrêté du 4 mai 2026 portant extension de l'avenant n° 31, JORF n° 0108 du 8 mai 2026 : l'avenant lie les
    autres entreprises à compter du 1er juin 2026.
    https://www.legifrance.gouv.fr/jorf/id/JORFTEXT000054048652
  - >-
    Non modélisé : l'avenant n° 32 du 3 juillet 2026 relatif aux salaires minima conventionnels, étendu par
    arrêté du 22 septembre 2026 (JORF du 30 septembre 2026, JORFTEXT000054914142), publié au BOCC n° 2026/32,
    qui n'était pas en ligne au 18 octobre 2026 : sa grille n'a pas pu être lue.
---
salarié . convention collective . vins cidres spiritueux:
  titre: Vins, cidres, jus de fruits, sirops, spiritueux et liqueurs de France (IDCC 493)
  valeur: convention collective = 'vins cidres spiritueux'

salarié . convention collective . vins cidres spiritueux . position:
  titre: Position hiérarchique
  description: Position de la grille des salaires minima conventionnels pour l'année 2026.
  applicable si: convention collective = 'vins cidres spiritueux'
  par défaut: "0"

salarié . convention collective . vins cidres spiritueux . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Minimum mensuel garanti à temps complet, proratisé selon la quotité de travail.
  applicable si: convention collective = 'vins cidres spiritueux'
  unité: €/mois
  produit:
    - grille
    - contrat . temps de travail . quotité

salarié . convention collective . vins cidres spiritueux . grille:
  titre: Salaire minimum mensuel à temps plein
  description: Grille de l'accord du 10 décembre 2025 relatif aux salaires minima conventionnels pour l'année 2026.
  applicable si: convention collective = 'vins cidres spiritueux'
  unité: €/mois
  variations:
    - si: position = '1A'
      alors: 1844 €/mois
    - si: position = '1B'
      alors: 1879 €/mois
    - si: position = '1C'
      alors: 1913 €/mois
    - si: position = '2A'
      alors: 1923 €/mois
    - si: position = '2B'
      alors: 1954 €/mois
    - si: position = '2C'
      alors: 1986 €/mois
    - si: position = '3A'
      alors: 1996 €/mois
    - si: position = '3B'
      alors: 2026 €/mois
    - si: position = '3C'
      alors: 2057 €/mois
    - si: position = '4A'
      alors: 2099 €/mois
    - si: position = '4B'
      alors: 2151 €/mois
    - si: position = '5A'
      alors: 2233 €/mois
    - si: position = '5B'
      alors: 2315 €/mois
    - si: position = '5C'
      alors: 2398 €/mois
    - si: position = '6A'
      alors: 2533 €/mois
    - si: position = '6B'
      alors: 2688 €/mois
    - si: position = '7A'
      alors: 2667 €/mois
    - si: position = '8A'
      alors: 2874 €/mois
    - si: position = '9A'
      alors: 3287 €/mois
    - si: position = '9B'
      alors: 4145 €/mois
    - si: position = '10A'
      alors: 5023 €/mois
    - sinon: 0 €/mois

salarié . convention collective . vins cidres spiritueux . position hors grille:
  titre: Position absente de la grille conventionnelle
  description: La position n'existe pas dans la grille des salaires minima modélisée.
  applicable si: convention collective = 'vins cidres spiritueux'
  valeur: grille = 0 €/mois
