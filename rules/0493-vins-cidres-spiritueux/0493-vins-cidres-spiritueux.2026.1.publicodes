# Convention collective nationale des vins, cidres, jus de fruits, sirops, spiritueux et liqueurs de France du 13 février 1969 (IDCC 493, brochure 3029).
#
# Version 2026.1, fusionnée avec modele-social par @jourdepaye/payroll-core.
# Une version publiée ne se modifie plus : toute évolution passe par une nouvelle version.

validFrom: 2026-02-01
sources:
  - "Accord du 10 décembre 2025 relatif aux salaires minima conventionnels pour l'année 2026, texte officiel Légifrance : https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000053863733"
  - "Arrêté du 4 mai 2026 portant extension de l'accord, publié au Journal officiel : https://www.legifrance.gouv.fr/jorf/id/JORFTEXT000054322287 (NOR TRST2605158A)"
---
salarié . convention collective . vins cidres spiritueux:
  titre: Vins, cidres, jus de fruits, sirops, spiritueux et liqueurs de France (IDCC 493)
  valeur: convention collective = 'vins cidres spiritueux'

salarié . convention collective . vins cidres spiritueux . position:
  titre: Position hiérarchique
  description: Position de la grille des salaires minima conventionnels pour l'année 2026.
  applicable si: convention collective = 'vins cidres spiritueux'
  par défaut: "0"

salarié . convention collective . vins cidres spiritueux . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Minimum mensuel garanti à temps complet, proratisé selon la quotité de travail.
  applicable si: convention collective = 'vins cidres spiritueux'
  unité: €/mois
  produit:
    - grille
    - contrat . temps de travail . quotité

salarié . convention collective . vins cidres spiritueux . grille:
  titre: Salaire minimum mensuel à temps plein
  description: Grille de l'accord du 10 décembre 2025 relatif aux salaires minima conventionnels pour l'année 2026.
  applicable si: convention collective = 'vins cidres spiritueux'
  unité: €/mois
  variations:
    - si: position = '1A'
      alors: 1844 €/mois
    - si: position = '1B'
      alors: 1879 €/mois
    - si: position = '1C'
      alors: 1913 €/mois
    - si: position = '2A'
      alors: 1923 €/mois
    - si: position = '2B'
      alors: 1954 €/mois
    - si: position = '2C'
      alors: 1986 €/mois
    - si: position = '3A'
      alors: 1996 €/mois
    - si: position = '3B'
      alors: 2026 €/mois
    - si: position = '3C'
      alors: 2057 €/mois
    - si: position = '4A'
      alors: 2099 €/mois
    - si: position = '4B'
      alors: 2151 €/mois
    - si: position = '5A'
      alors: 2233 €/mois
    - si: position = '5B'
      alors: 2315 €/mois
    - si: position = '5C'
      alors: 2398 €/mois
    - si: position = '6A'
      alors: 2533 €/mois
    - si: position = '6B'
      alors: 2688 €/mois
    - si: position = '7A'
      alors: 2667 €/mois
    - si: position = '8A'
      alors: 2874 €/mois
    - si: position = '9A'
      alors: 3287 €/mois
    - si: position = '9B'
      alors: 4145 €/mois
    - si: position = '10A'
      alors: 5023 €/mois
    - sinon: 0 €/mois

salarié . convention collective . vins cidres spiritueux . position hors grille:
  titre: Position absente de la grille conventionnelle
  description: La position n'existe pas dans la grille des salaires minima modélisée.
  applicable si: convention collective = 'vins cidres spiritueux'
  valeur: grille = 0 €/mois
