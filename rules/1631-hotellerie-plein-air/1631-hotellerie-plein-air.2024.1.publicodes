# Convention collective nationale de l'hôtellerie de plein air (IDCC 1631).
# Version 2024.1 : avenant n° 44 du 19 juin 2024 relatif aux salaires minima, étendu.
validFrom: 2024-11-01
sources:
  - https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000051149881
  - https://www.legifrance.gouv.fr/conv_coll/id/KALIARTI000051149881
  - https://www.legifrance.gouv.fr/conv_coll/id/KALICONT000005635252
---
salarié . convention collective . hôtellerie de plein air:
  titre: Hôtellerie de plein air (IDCC 1631)
  valeur: convention collective = 'hôtellerie de plein air'
salarié . convention collective . hôtellerie de plein air . coefficient:
  titre: Coefficient de classification
  description: Coefficient fourni par l'application. Seuls les coefficients explicitement sourcés dans cette version sont modélisés.
  applicable si: convention collective = 'hôtellerie de plein air'
  par défaut: 0
salarié . convention collective . hôtellerie de plein air . salaire minimum conventionnel . grille:
  titre: Salaire minimum mensuel brut à temps plein
  description: Montants mensuels bruts de l'avenant n° 44, applicables à compter du 1er novembre 2024.
  applicable si: convention collective = 'hôtellerie de plein air'
  unité: €/mois
  variations:
    - si: coefficient = 285
      alors: 2112.73 €/mois
    - si: coefficient = 300
      alors: 2203.92 €/mois
    - si: coefficient = 325
      alors: 2595.82 €/mois
    - si: coefficient = 349
      alors: 2773.96 €/mois
    - si: coefficient = 420
      alors: 3581.52 €/mois
    - sinon: 0 €/mois
salarié . convention collective . hôtellerie de plein air . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Minimum mensuel brut de la grille modélisée, proratisé selon la quotité de travail. Les autres coefficients de l'avenant restent à fournir par l'appelant tant qu'ils ne sont pas intégrés dans une nouvelle version.
  applicable si:
    toutes ces conditions:
      - convention collective = 'hôtellerie de plein air'
      - salaire minimum conventionnel . grille > 0 €/mois
  unité: €/mois
  valeur: salaire minimum conventionnel . grille * salarié . contrat . temps de travail . quotité
