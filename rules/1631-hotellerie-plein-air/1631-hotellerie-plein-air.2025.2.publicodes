# Convention collective nationale de l'hôtellerie de plein air (IDCC 1631).
# Version 2025.2 : avenant n° 46 du 30 décembre 2024 relatif aux salaires, seconde étape, applicable au
# 1er octobre 2025 (valeur du point de 5,57 €).
validFrom: 2025-10-01
sources:
  - >-
    Avenant n° 46 du 30 décembre 2024 relatif aux salaires, annexe 1, colonne « à compter du
    1er octobre 2025 » : coefficient 100 à 1 836,88 € et valeur du point de 5,57 €. Étendu par arrêté
    du 25 février 2025 publié au Journal officiel du 18 mars 2025 (BO 2025-3). Légifrance
    KALITEXT000051314765 :
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000051314765
  - >-
    Convention collective nationale de l'hôtellerie de plein air du 2 juin 1993, IDCC 1631,
    conteneur Légifrance KALICONT000005635252 :
    https://www.legifrance.gouv.fr/conv_coll/id/KALICONT000005635252
---
salarié . convention collective . hôtellerie de plein air:
  titre: Hôtellerie de plein air (IDCC 1631)
  valeur: convention collective = 'hôtellerie de plein air'
salarié . convention collective . hôtellerie de plein air . coefficient:
  titre: Coefficient de classification
  description: Coefficient fourni par l'application. Seuls les coefficients explicitement sourcés dans cette version sont modélisés.
  applicable si: convention collective = 'hôtellerie de plein air'
  par défaut: 0
salarié . convention collective . hôtellerie de plein air . salaire minimum conventionnel . grille:
  titre: Salaire minimum mensuel brut à temps plein
  description: Montants mensuels bruts de l'annexe 1 de l'avenant n° 46 à compter du 1er octobre 2025 (valeur du point de 5,57 €).
  applicable si: convention collective = 'hôtellerie de plein air'
  unité: €/mois
  variations:
    - si: coefficient = 100
      alors: 1836.88 €/mois
    - si: coefficient = 105
      alors: 1864.73 €/mois
    - si: coefficient = 110
      alors: 1892.58 €/mois
    - si: coefficient = 115
      alors: 1920.43 €/mois
    - si: coefficient = 120
      alors: 1948.28 €/mois
    - si: coefficient = 125
      alors: 1976.13 €/mois
    - si: coefficient = 130
      alors: 2003.98 €/mois
    - si: coefficient = 135
      alors: 2031.83 €/mois
    - si: coefficient = 140
      alors: 2059.68 €/mois
    - si: coefficient = 145
      alors: 2087.53 €/mois
    - si: coefficient = 150
      alors: 2115.38 €/mois
    - si: coefficient = 155
      alors: 2143.23 €/mois
    - si: coefficient = 160
      alors: 2171.08 €/mois
    - si: coefficient = 165
      alors: 2198.93 €/mois
    - si: coefficient = 170
      alors: 2226.78 €/mois
    - si: coefficient = 175
      alors: 2254.63 €/mois
    - si: coefficient = 180
      alors: 2282.48 €/mois
    - si: coefficient = 185
      alors: 2310.33 €/mois
    - si: coefficient = 190
      alors: 2338.18 €/mois
    - si: coefficient = 195
      alors: 2366.03 €/mois
    - si: coefficient = 200
      alors: 2393.88 €/mois
    - si: coefficient = 205
      alors: 2421.73 €/mois
    - si: coefficient = 210
      alors: 2449.58 €/mois
    - si: coefficient = 215
      alors: 2477.43 €/mois
    - si: coefficient = 220
      alors: 2505.28 €/mois
    - si: coefficient = 225
      alors: 2533.13 €/mois
    - si: coefficient = 230
      alors: 2560.98 €/mois
    - si: coefficient = 235
      alors: 2588.83 €/mois
    - si: coefficient = 240
      alors: 2616.68 €/mois
    - si: coefficient = 245
      alors: 2644.53 €/mois
    - si: coefficient = 250
      alors: 2672.38 €/mois
    - si: coefficient = 255
      alors: 2700.23 €/mois
    - si: coefficient = 260
      alors: 2728.08 €/mois
    - si: coefficient = 265
      alors: 2755.93 €/mois
