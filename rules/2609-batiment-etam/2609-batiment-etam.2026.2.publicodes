validFrom: '2026-05-01'
sources:
  - https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000054337649
  - https://www.legifrance.gouv.fr/conv_coll/article/KALIARTI000054337654
  - https://www.cibtp.fr/actualite-/-presse/actualites/actualite/principales-revalorisations-pour-2026
  - https://www.cibtp.fr/documentation/reglementation
  - https://www.oppbtp.com/app/uploads/2025/12/arrete-2025-taux-2026.pdf
---
salarié . convention collective . bâtiment ETAM:
  titre: Bâtiment — ETAM (IDCC 2609)
  valeur: convention collective = 'bâtiment ETAM'
  description: >-
    Convention collective nationale des employés, techniciens et agents de
    maîtrise du bâtiment. Le salaire minimum est limité à la grille régionale
    Occitanie vérifiée dans cette version.
  rend non applicable: rémunération . indemnités CDD . congés payés
salarié . convention collective . bâtiment ETAM . catégorie:
  question: À quelle catégorie le salarié appartient-il ?
  une possibilité:
    - "'ETAM'"
    - "'cadre'"
  par défaut: "'ETAM'"
  avec:
    ETAM:
      titre: ETAM
    cadre:
      titre: Cadre
salarié . convention collective . bâtiment ETAM . région:
  question: Dans quelle région l'entreprise est-elle établie pour l'application de la grille ?
  par défaut: "'Occitanie'"
salarié . convention collective . bâtiment ETAM . niveau:
  question: Quel est le niveau de l'ETAM ?
  une possibilité:
    - "'A'"
    - "'B'"
    - "'C'"
    - "'D'"
    - "'E'"
    - "'F'"
    - "'G'"
    - "'H'"
  par défaut: "'A'"
salarié . convention collective . bâtiment ETAM . date de calcul:
  question: À quelle date le minimum conventionnel doit-il être vérifié ?
  par défaut: 01/05/2026
salarié . convention collective . bâtiment ETAM . caisse de rattachement:
  question: À quelle caisse CIBTP l'entreprise est-elle rattachée ?
  par défaut: "'à déterminer'"

salarié . convention collective . bâtiment ETAM . grille régionale:
  applicable si:
    toutes ces conditions:
      - convention collective = 'bâtiment ETAM'
      - catégorie = 'ETAM'
      - région = 'Occitanie'
      - date de calcul >= 01/05/2026
      - date de calcul <= 31/12/2026
  unité: €/mois
  variations:
    - si: niveau = 'A'
      alors: 1847.16 €/mois
    - si: niveau = 'B'
      alors: 1936.54 €/mois
    - si: niveau = 'C'
      alors: 2061.72 €/mois
    - si: niveau = 'D'
      alors: 2256.45 €/mois
    - si: niveau = 'E'
      alors: 2462.01 €/mois
    - si: niveau = 'F'
      alors: 2902.48 €/mois
    - si: niveau = 'G'
      alors: 3176.04 €/mois
    - si: niveau = 'H'
      alors: 3497.50 €/mois
    - sinon: 0 €/mois
salarié . convention collective . bâtiment ETAM . niveau hors grille:
  applicable si: convention collective = 'bâtiment ETAM'
  toutes ces conditions:
    - niveau != 'A'
    - niveau != 'B'
    - niveau != 'C'
    - niveau != 'D'
    - niveau != 'E'
    - niveau != 'F'
    - niveau != 'G'
    - niveau != 'H'
salarié . convention collective . bâtiment ETAM . région hors grille:
  applicable si: convention collective = 'bâtiment ETAM'
  valeur: région != 'Occitanie'
salarié . convention collective . bâtiment ETAM . catégorie hors champ:
  applicable si: convention collective = 'bâtiment ETAM'
  valeur: catégorie != 'ETAM'
salarié . convention collective . bâtiment ETAM . période hors couverture:
  applicable si: convention collective = 'bâtiment ETAM'
  une de ces conditions:
    - date de calcul < 01/05/2026
    - date de calcul > 31/12/2026
salarié . convention collective . bâtiment ETAM . calcul bloqué:
  applicable si: convention collective = 'bâtiment ETAM'
  une de ces conditions:
    - niveau hors grille
    - région hors grille
    - catégorie hors champ
    - période hors couverture
salarié . convention collective . bâtiment ETAM . salaire minimum conventionnel:
  applicable si:
    toutes ces conditions:
      - convention collective = 'bâtiment ETAM'
      - calcul bloqué = non
  unité: €/mois
  valeur: grille régionale

salarié . convention collective . bâtiment ETAM . cotisations employeur:
  remplace: cotisations . employeur
  somme:
    - cotisations . employeur
    - congés intempéries
    - chômage intempéries
    - OPPBTP
salarié . convention collective . bâtiment ETAM . congés intempéries:
  titre: cotisation congés payés CIBTP
  produit:
    - valeur: cotisations . assiette
    - 20.70%
  description: >-
    Taux de congés payés CIBTP 2026. La caisse de rattachement reste un
    paramètre déclaré et n'est pas déduite de la région.
salarié . convention collective . bâtiment ETAM . chômage intempéries:
  titre: cotisation chômage intempéries
  produit:
    - valeur: cotisations . assiette
      plafond: temps de travail . plafond sécurité sociale
    - taux
  description: >-
    Cotisation patronale CIBTP assise sur les salaires plafonnés au PMSS.
    L'abattement annuel est calculé par entreprise et ne peut pas être
    correctement imputé salarié par salarié dans ce modèle.
  références:
    CIBTP France, réglementation et conventions collectives: https://www.cibtp.fr/documentation/reglementation
salarié . convention collective . bâtiment ETAM . chômage intempéries . taux:
  unité: '%'
  variations:
    - si: secteur = 'gros œuvre'
      alors: 0.68%
    - si: secteur = 'second œuvre'
      alors: 0.13%
    - sinon: 0%
salarié . convention collective . bâtiment ETAM . chômage intempéries . secteur:
  question: Quelle est l'activité de l'entreprise pour la cotisation chômage intempéries ?
  une possibilité:
    - gros œuvre
    - second œuvre
    - non exposée
  par défaut: "'second œuvre'"
  avec:
    gros œuvre:
      titre: Gros œuvre ou travaux publics
    second œuvre:
      titre: Second œuvre
    non exposée:
      titre: Activité non exposée aux intempéries
salarié . convention collective . bâtiment ETAM . OPPBTP:
  produit:
    - contrat . salaire brut * 1.1314
    - 0.11%
  description: Cotisation OPPBTP 2026 au taux de 0,11 %.
