# Convention collective nationale de la distribution et du commerce de gros des papiers-cartons du 12 juillet 2017 (IDCC 3224).
# Version 2025.1: avenant n° 12 du 6 mars 2025, étendu le 1er août 2025.
validFrom: 2025-03-01
extension: 2025-08-01
sources:
  - >-
    Avenant n° 12 du 6 mars 2025 relatif aux salaires et minima conventionnels,
    applicable au 1er mars 2025, Légifrance, IDCC 3224, KALITEXT000051947672.
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000051947672?idConteneur=KALICONT000036605374
  - >-
    Arrêté du 21 juillet 2025 portant extension de l'accord du 6 mars 2025,
    publié au Journal officiel du 1er août 2025, JORFTEXT000052020326.
    https://www.legifrance.gouv.fr/jorf/id/JORFTEXT000052020326
---
salarié . convention collective . distribution commerce gros papiers cartons:
  titre: Distribution et commerce de gros des papiers-cartons (IDCC 3224)
  valeur: convention collective = 'distribution commerce gros papiers cartons'

salarié . convention collective . distribution commerce gros papiers cartons . niveau et échelon:
  titre: Niveau et échelon de classification
  description: Niveau et échelon de l'emploi selon la grille de l'avenant n° 12.
  applicable si: convention collective = 'distribution commerce gros papiers cartons'
  par défaut: "'I.1'"

salarié . convention collective . distribution commerce gros papiers cartons . salaire minimum conventionnel:
  titre: Salaire minimum mensuel garanti
  description: Minimum mensuel brut à temps plein, proratisé selon la quotité de travail.
  applicable si: convention collective = 'distribution commerce gros papiers cartons'
  unité: €/mois
  produit:
    - grille mensuelle
    - contrat . temps de travail . quotité

salarié . convention collective . distribution commerce gros papiers cartons . grille mensuelle:
  titre: SMMG brut à temps plein
  description: Grille de l'avenant n° 12 du 6 mars 2025, applicable au 1er mars 2025.
  applicable si: convention collective = 'distribution commerce gros papiers cartons'
  unité: €/mois
  variations:
    - si: niveau et échelon = 'I.1'
      alors: 1811.80 €/mois
    - si: niveau et échelon = 'I.2'
      alors: 1821.80 €/mois
    - si: niveau et échelon = 'II.1'
      alors: 1849.80 €/mois
    - si: niveau et échelon = 'II.2'
      alors: 1871.80 €/mois
    - si: niveau et échelon = 'III.1'
      alors: 1901.80 €/mois
    - si: niveau et échelon = 'III.2'
      alors: 1961.80 €/mois
    - si: niveau et échelon = 'III.3'
      alors: 2003.80 €/mois
    - si: niveau et échelon = 'IV.1'
      alors: 2050.80 €/mois
    - si: niveau et échelon = 'IV.2'
      alors: 2135.80 €/mois
    - si: niveau et échelon = 'IV.3'
      alors: 2209.80 €/mois
    - si: niveau et échelon = 'V.1'
      alors: 2721.80 €/mois
    - si: niveau et échelon = 'V.2'
      alors: 3772.80 €/mois
    - si: niveau et échelon = 'V.3'
      alors: 4516.80 €/mois
    - sinon: 0 €/mois

salarié . convention collective . distribution commerce gros papiers cartons . salaire minimum annuel conventionnel:
  titre: Garantie annuelle de rémunération brute
  description: Garantie annuelle brute à temps plein, proratisée selon la quotité de travail.
  applicable si: convention collective = 'distribution commerce gros papiers cartons'
  unité: €/an
  produit:
    - garantie annuelle
    - contrat . temps de travail . quotité

salarié . convention collective . distribution commerce gros papiers cartons . garantie annuelle:
  titre: Garantie annuelle brute à temps plein
  applicable si: convention collective = 'distribution commerce gros papiers cartons'
  unité: €/an
  variations:
    - si: niveau et échelon = 'I.1'
      alors: 22731.26 €/an
    - si: niveau et échelon = 'I.2'
      alors: 22856.06 €/an
    - si: niveau et échelon = 'II.1'
      alors: 23205.50 €/an
    - si: niveau et échelon = 'II.2'
      alors: 23480.06 €/an
    - si: niveau et échelon = 'III.1'
      alors: 23854.46 €/an
    - si: niveau et échelon = 'III.2'
      alors: 24603.26 €/an
    - si: niveau et échelon = 'III.3'
      alors: 25127.42 €/an
    - si: niveau et échelon = 'IV.1'
      alors: 25593.98 €/an
    - si: niveau et échelon = 'IV.2'
      alors: 26654.78 €/an
    - si: niveau et échelon = 'IV.3'
      alors: 27578.30 €/an
    - si: niveau et échelon = 'V.1'
      alors: 34621.30 €/an
    - si: niveau et échelon = 'V.2'
      alors: 47990.02 €/an
    - si: niveau et échelon = 'V.3'
