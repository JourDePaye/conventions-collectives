validFrom: 2026-03-01
sources:
  - >-
    Accord du 10 février 2026 relatif aux salaires minima conventionnels, étendu par arrêté du 4 mai
    2026 publié au Journal officiel du 10 mai 2026.
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000054253963
    https://www.legifrance.gouv.fr/jorf/id/JORFTEXT000054051154
---
salarié . convention collective . import-export:
  titre: Import-export (IDCC 0043)
  valeur: convention collective = 'import-export'

salarié . convention collective . import-export . coefficient:
  titre: Coefficient de classification
  description: Coefficient de la grille de l'accord salarial, au format E1 à E8, M9 à M12 ou C13 à C20.
  applicable si: convention collective = 'import-export'
  par défaut: "'non renseigné'"

salarié . convention collective . import-export . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Minimum mensuel brut pour 151,67 heures, proratisé selon la quotité de travail.
  applicable si: convention collective = 'import-export'
  unité: €/mois
  produit:
    - grille mensuelle
    - contrat . temps de travail . quotité

salarié . convention collective . import-export . grille mensuelle:
  titre: Grille mensuelle des minima
  applicable si: convention collective = 'import-export'
  unité: €/mois
  variations:
    - si: coefficient = 'E1'
      alors: 1879 €/mois
    - si: coefficient = 'E2'
      alors: 1882 €/mois
    - si: coefficient = 'E3'
      alors: 1886 €/mois
    - si: coefficient = 'E4'
      alors: 1896 €/mois
    - si: coefficient = 'E5'
      alors: 1903 €/mois
    - si: coefficient = 'E6'
      alors: 1935 €/mois
    - si: coefficient = 'E7'
      alors: 1996 €/mois
    - si: coefficient = 'E8'
      alors: 2065 €/mois
    - si: coefficient = 'M9'
      alors: 2104 €/mois
    - si: coefficient = 'M10'
      alors: 2310 €/mois
    - si: coefficient = 'M11'
      alors: 2549 €/mois
    - si: coefficient = 'M12'
      alors: 2724 €/mois
    - si: coefficient = 'C13'
      alors: 2666 €/mois
    - si: coefficient = 'C14'
      alors: 2906 €/mois
    - si: coefficient = 'C15'
      alors: 3121 €/mois
    - si: coefficient = 'C16'
      alors: 3564 €/mois
    - si: coefficient = 'C17'
      alors: 3996 €/mois
    - si: coefficient = 'C18'
      alors: 4808 €/mois
    - si: coefficient = 'C19'
      alors: 5232 €/mois
    - si: coefficient = 'C20'
      alors: 5668 €/mois
    - sinon: 0 €/mois

salarié . convention collective . import-export . coefficient hors grille:
  titre: Coefficient absent de la grille
  applicable si: convention collective = 'import-export'
  valeur:
    toutes ces conditions:
      - grille mensuelle = 0 €/mois
