# Convention collective nationale des commerces de détail de papeterie, fournitures de bureau,
# de bureautique et informatique, et de librairie (IDCC 1513, brochure 3252).
#
# Version 2026.1, fusionnée avec modele-social par @jourdepaye/payroll-core.
# Une version publiée ne se modifie plus (voir versions.lock.json) : toute évolution ou
# correction passe par une nouvelle version.
#
# Premier document : métadonnées de la version. Second document : règles publicodes, en
# français comme dans modele-social.

validFrom: 2026-08-01
sources:
  - Avenant n° 4 du 24 mars 2026 relatif aux salaires minima conventionnels (article 2,
    grille des coefficients 1 à 10 pour 151,67 heures mensuelles), applicable à compter du
    1er avril 2026 aux entreprises adhérant à une organisation d'employeurs signataire et,
    pour les autres entreprises, le premier jour du mois suivant la publication de l'arrêté
    d'extension ; étendu par arrêté du 30 juin 2026 (JORF du 7 juillet 2026, NOR TRST2617482A),
    avec effet au 1er août 2026 pour le champ étendu. Texte de l'avenant et arrêté consultés
    sur Légifrance, convention collective IDCC 1513.
---
salarié . convention collective . papeterie fournitures bureau bureautique informatique librairie:
  titre: Commerces de détail de papeterie, fournitures de bureau, bureautique, informatique et librairie (IDCC 1513)
  valeur: convention collective = 'papeterie fournitures bureau bureautique informatique librairie'

salarié . convention collective . papeterie fournitures bureau bureautique informatique librairie . coefficient:
  titre: Coefficient de classification
  description: Coefficient de 1 à 10 prévu par la grille de l'avenant salarial.
  applicable si: convention collective = 'papeterie fournitures bureau bureautique informatique librairie'
  par défaut: "'non renseigné'"

salarié . convention collective . papeterie fournitures bureau bureautique informatique librairie . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Salaire minimum mensuel pour 151,67 heures, proratisé pour un temps partiel. Vaut 0 €/mois si le coefficient n'existe pas dans la grille.
  applicable si: convention collective = 'papeterie fournitures bureau bureautique informatique librairie'
  unité: €/mois
  produit:
    - grille
    - contrat . temps de travail . quotité

salarié . convention collective . papeterie fournitures bureau bureautique informatique librairie . salaire minimum conventionnel . grille:
  titre: Salaire minimum mensuel à temps plein
  description: Grille de l'article 2 de l'avenant n° 4, pour 151,67 heures mensuelles.
  unité: €/mois
  variations:
    - si: coefficient = '1'
      alors: 1823 €/mois
    - si: coefficient = '2'
      alors: 1823 €/mois
    - si: coefficient = '3'
      alors: 1823 €/mois
    - si: coefficient = '4'
      alors: 1823 €/mois
    - si: coefficient = '5'
      alors: 1823 €/mois
    - si: coefficient = '6'
      alors: 1830 €/mois
    - si: coefficient = '7'
      alors: 1830 €/mois
    - si: coefficient = '8'
      alors: 1830 €/mois
    - si: coefficient = '9'
      alors: 1830 €/mois
    - si: coefficient = '10'
      alors: 1830 €/mois
    - sinon: 0 €/mois

salarié . convention collective . papeterie fournitures bureau bureautique informatique librairie . coefficient hors grille:
  titre: Coefficient absent de la grille
  description: Le coefficient n'existe pas dans la grille des salaires minima.
  applicable si: convention collective = 'papeterie fournitures bureau bureautique informatique librairie'
  valeur: salaire minimum conventionnel . grille = 0 €/mois
