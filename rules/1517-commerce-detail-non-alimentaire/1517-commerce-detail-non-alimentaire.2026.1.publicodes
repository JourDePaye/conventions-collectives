# Convention collective nationale des commerces de détail non alimentaires du 14 juin 1988
# (IDCC 1517, brochure 3251).
#
# Version 2026.1, fusionnée avec modele-social par @jourdepaye/payroll-core.
# Une version publiée ne se modifie plus (voir versions.lock.json) : toute évolution ou
# correction passe par une nouvelle version.
#
# Premier document : métadonnées de la version. Second document : règles publicodes, en
# français comme dans modele-social.

# Date d'entrée en vigueur de cette version : le premier jour du mois qui suit la publication
# de l'arrêté d'extension (10 mai 2026).
validFrom: 2026-06-01
sources:
  - Avenant n° 15 du 6 février 2026 portant revalorisation de la rémunération minimale (grille
    des salaires minima mensuels des niveaux 1 à 9 pour 151,67 heures), applicable à compter du
    premier jour du mois qui suit la publication de l'arrêté d'extension, étendu par arrêté du
    4 mai 2026 (JORF n° 0109 du 10 mai 2026, texte n° 80, NOR TRST2610662A), soit à compter du
    1er juin 2026. Texte de l'avenant consulté directement (exemplaires publiés par le CDNA
    et par juristique.org). Le tableau du niveau 2 y est de 1 838 €, et non 1 836 € comme sur
    une page de synthèse du CDNA.
---
salarié . convention collective . commerce de détail non alimentaire:
  titre: Commerce de détail non alimentaire (IDCC 1517)
  valeur: convention collective = 'commerce de détail non alimentaire'

salarié . convention collective . commerce de détail non alimentaire . niveau:
  titre: Niveau de classification
  description: |
    Niveau de 1 à 9 de la classification du chapitre XII de la convention collective.
  applicable si: convention collective = 'commerce de détail non alimentaire'
  par défaut: "'non renseigné'"

salarié . convention collective . commerce de détail non alimentaire . salaire minimum conventionnel:
  titre: Salaire minimum mensuel garanti
  description: |
    Salaire minimum mensuel du niveau pour 151,67 heures, proratisé pour un temps partiel. Vaut
    0 €/mois si le niveau n'existe pas dans la grille (voir « niveau hors grille »).
  applicable si: convention collective = 'commerce de détail non alimentaire'
  unité: €/mois
  produit:
    - grille
    - contrat . temps de travail . quotité

salarié . convention collective . commerce de détail non alimentaire . salaire minimum conventionnel . grille:
  titre: Salaire mensuel minimum à temps plein
  description: |
    Grille de l'avenant n° 15, de 1 829 € (niveau 1) à 4 034 € (niveau 9), pour 151,67 heures.
  unité: €/mois
  variations:
    - si: niveau = '1'
      alors: 1829.00 €/mois
    - si: niveau = '2'
      alors: 1838.00 €/mois
    - si: niveau = '3'
      alors: 1843.00 €/mois
    - si: niveau = '4'
      alors: 1867.00 €/mois
    - si: niveau = '5'
      alors: 1967.00 €/mois
    - si: niveau = '6'
      alors: 2146.00 €/mois
    - si: niveau = '7'
      alors: 2741.00 €/mois
    - si: niveau = '8'
      alors: 3583.00 €/mois
    - si: niveau = '9'
      alors: 4034.00 €/mois
    - sinon: 0 €/mois

salarié . convention collective . commerce de détail non alimentaire . niveau hors grille:
  titre: Niveau absent de la grille
  description: Le niveau n'existe pas dans la grille des salaires minima.
  applicable si: convention collective = 'commerce de détail non alimentaire'
  # « est non applicable » ne teste pas l'absence de valeur et dépend de l'ordre
  # d'évaluation : la grille vaut donc 0 €/mois pour un niveau inconnu.
  valeur: salaire minimum conventionnel . grille = 0 €/mois
