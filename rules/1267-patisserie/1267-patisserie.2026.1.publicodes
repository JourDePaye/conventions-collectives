# Convention collective nationale de la pâtisserie du 30 juin 1983
# (IDCC 1267, brochure 3210).
#
# Version 2026.1, fusionnée avec modele-social par @jourdepaye/payroll-core.
# Une version publiée ne se modifie plus (voir versions.lock.json) : toute évolution ou
# correction passe par une nouvelle version.
validFrom: 2026-01-01
sources:
  - >-
    Avenant n° 98 du 12 novembre 2025 relatif aux salaires minima conventionnels,
    applicable au 1er janvier 2026, texte KALI KALITEXT000053970120 et article
    KALIARTI000053970122.
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000053970120
    https://www.legifrance.gouv.fr/conv_coll/article/KALIARTI000053970122
  - >-
    Arrêté du 9 février 2026 portant extension d'un avenant à la convention collective
    nationale de la pâtisserie, publié au Journal officiel du 18 février 2026,
    JORFTEXT000053593452.
    https://www.legifrance.gouv.fr/jorf/id/JORFTEXT000053593452
  - >-
    Convention collective nationale de la pâtisserie du 30 juin 1983, classification
    des emplois et niveaux conventionnels.
    https://www.legifrance.gouv.fr/conv_coll/id/KALICONT000005635883
---
salarié . convention collective . pâtisserie:
  titre: Pâtisserie (IDCC 1267)
  valeur: convention collective = 'pâtisserie'

salarié . convention collective . pâtisserie . niveau:
  titre: Niveau de classification
  description: >-
    Niveau conventionnel déterminé par la classification du poste. La grille des salaires
    minima comporte les niveaux I à IX.
  applicable si: convention collective = 'pâtisserie'
  par défaut: '''hors grille'''

salarié . convention collective . pâtisserie . salaire minimum conventionnel:
  titre: Salaire minimum mensuel garanti
  description: >-
    Salaire brut mensuel minimum pour un temps plein, selon l'avenant n° 98 applicable au
    1er janvier 2026, proratisé selon la quotité de travail. Les majorations, primes et
    avantages qui ne sont pas inclus dans l'assiette conventionnelle ne sont pas ajoutés
    automatiquement.
  applicable si: convention collective = 'pâtisserie'
  unité: €/mois
  arrondi: 2 décimales
  valeur: grille mensuelle * contrat . temps de travail . quotité

salarié . convention collective . pâtisserie . grille mensuelle:
  titre: Salaire mensuel minimum à temps plein
  applicable si: convention collective = 'pâtisserie'
  unité: €/mois
  variations:
    - si: niveau = 'I'
      alors: 1830 €/mois
    - si: niveau = 'II'
      alors: 1834 €/mois
    - si: niveau = 'III'
      alors: 1844 €/mois
    - si: niveau = 'IV'
      alors: 1863 €/mois
    - si: niveau = 'V'
      alors: 1915 €/mois
    - si: niveau = 'VI'
      alors: 1989 €/mois
    - si: niveau = 'VII'
      alors: 2071 €/mois
    - si: niveau = 'VIII'
      alors: 2186 €/mois
    - si: niveau = 'IX'
      alors: 2461 €/mois
    - sinon: 0 €/mois

salarié . convention collective . pâtisserie . niveau hors grille:
  titre: Niveau absent de la grille
  description: Le niveau de classification n'existe pas dans la grille des salaires minima modélisée.
  applicable si: convention collective = 'pâtisserie'
  valeur: grille mensuelle = 0 €/mois
