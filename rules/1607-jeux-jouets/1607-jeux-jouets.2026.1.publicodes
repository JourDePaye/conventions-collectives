      alors: 1921 €/mois
    - si: coefficient = 143
      alors: 1929 €/mois
    - si: coefficient = 155
      alors: 1942 €/mois
    - si: coefficient = 170
      alors: 1986 €/mois
    - si: coefficient = 180
      alors: 2045 €/mois
    - si: coefficient = 190
      alors: 2092 €/mois
    - si: coefficient = 200
      alors: 2154 €/mois
    - si: coefficient = 212
      alors: 2240 €/mois
    - si: coefficient = 220
      alors: 2285 €/mois
    - si: coefficient = 255
      alors: 2532 €/mois
