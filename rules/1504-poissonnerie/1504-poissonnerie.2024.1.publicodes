# Convention collective nationale de la poissonnerie de détail, demi-gros et gros du 12 avril 1988 (IDCC 1504).
# Version 2024.1: avenant du 31 janvier 2024 relatif à la modification de la grille des rémunérations minimales, étendu le 15 avril 2024.
validFrom: 2024-05-01
sources:
  - Avenant du 31 janvier 2024 relatif à la modification de la grille des rémunérations minimales, IDCC 1504, KALIARTI000049439193.
  - Arrêté du 15 avril 2024 portant extension de l'avenant, JORFTEXT000049475104.
  - Convention collective nationale de la poissonnerie du 12 avril 1988, conteneur KALICONT000005635410.
---
salarié . convention collective . poissonnerie:
  titre: Poissonnerie (IDCC 1504)
  valeur: convention collective = 'poissonnerie'
  description: >-
    Modèle salarial borné à l'avenant étendu du 31 janvier 2024, applicable au
    1er mai 2024. Les montants sont des minima mensuels bruts pour 151,67 heures.

salarié . convention collective . poissonnerie . coefficient:
  titre: Coefficient de classification
  question: Quel est le coefficient conventionnel ?
  unité: unité
  applicable si: convention collective = 'poissonnerie'

salarié . convention collective . poissonnerie . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Minimum mensuel brut pour 151,67 heures, proratisé selon la quotité de travail.
  unité: €/mois
  applicable si: convention collective = 'poissonnerie'
  produit:
    - grille
    - contrat . temps de travail . quotité

salarié . convention collective . poissonnerie . grille:
  titre: Salaire minimum mensuel à temps plein
  unité: €/mois
  variations:
    - si: coefficient = 130
      alors: 1796.92 €/mois
    - si: coefficient = 135
      alors: 1858.83 €/mois
    - si: coefficient = 140
      alors: 1879.67 €/mois
    - si: coefficient = 145
      alors: 1904.10 €/mois
    - si: coefficient = 150
      alors: 1928.13 €/mois
    - si: coefficient = 160
      alors: 1956.14 €/mois
    - si: coefficient = 165
      alors: 1984.81 €/mois
    - si: coefficient = 170
      alors: 2010.61 €/mois
    - si: coefficient = 175
      alors: 2037.94 €/mois
    - si: coefficient = 180
      alors: 2056.80 €/mois
    - si: coefficient = 185
      alors: 2093.08 €/mois
    - si: coefficient = 190
      alors: 2112.03 €/mois
    - si: coefficient = 195
      alors: 2148.87 €/mois
    - si: coefficient = 200
      alors: 2168.30 €/mois
    - si: coefficient = 205
      alors: 2206.16 €/mois
    - si: coefficient = 210
      alors: 2285.35 €/mois
    - si: coefficient = 220
      alors: 2310.80 €/mois
    - si: coefficient = 230
      alors: 2365.09 €/mois
    - si: coefficient = 240
      alors: 2406.91 €/mois
    - si: coefficient = 250
      alors: 2446.59 €/mois
    - si: coefficient = 300
      alors: 3139.15 €/mois
    - si: coefficient = 350
      alors: 3461.65 €/mois
    - si: coefficient = 400
      alors: 3784.06 €/mois
    - si: coefficient = 450
      alors: 4104.62 €/mois
    - sinon: 0 €/mois

salarié . convention collective . poissonnerie . coefficient hors grille:
  titre: Coefficient absent de la grille
  applicable si: convention collective = 'poissonnerie'
  valeur: grille = 0 €/mois

salarié . convention collective . poissonnerie . audit paie:
  titre: Audit explicite des rubriques conventionnelles de paie
  description: >-
    Les textes officiels et avenants dédiés ont été recherchés pour les taux des
    cotisations salarié et employeur, assiettes, plafonds, tranches, forfaits,
    santé, prévoyance, retraite complémentaire et supplémentaire, formation,
    AT/MP, primes, indemnités, avantages en nature et frais. Seuls les minima
    salariaux de l'avenant du 31 janvier 2024 sont calculés. Aucun taux de
    cotisation, base conventionnelle supplémentaire, forfait, taux AT/MP, prime,
    avantage ou frais n'est inventé ou mis à zéro.
  applicable si: convention collective = 'poissonnerie'
  valeur: oui
