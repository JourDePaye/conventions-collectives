# Version 2024.1 : avenant du 17 janvier 2024, barèmes au 1er janvier 2024 ; mêmes clés.
validFrom: '2024-01-01'
sources:
  - https://www.legifrance.gouv.fr/conv_coll/id/KALICONT000005635490
  - >-
    Avenant du 17 janvier 2024 relatif aux barèmes nationaux de salaires minima (KALITEXT000049438690),
    annexe « Salaires minima hiérarchiques au 1er janvier 2024 ». Étendu par arrêté du 15 avril 2024 (JORF du
    26 avril 2024). L'accord paritaire du 17 janvier 2024 sur les salaires minima hiérarchiques
    (KALITEXT000049438672) n'a pas de grille propre ; il n'a pas été modélisé.
---
salarié . convention collective . pompes funèbres:
  titre: Entreprises de pompes funèbres (IDCC 759)
  valeur: convention collective = 'pompes funèbres'

salarié . convention collective . pompes funèbres . niveau:
  titre: Niveau de classification
  description: Niveau conventionnel attribué par l'employeur (I à VII).
  applicable si: convention collective = 'pompes funèbres'
  par défaut: '''I'''

salarié . convention collective . pompes funèbres . position:
  titre: Position de classification
  description: Position conventionnelle attribuée par l'employeur.
  applicable si: convention collective = 'pompes funèbres'
  par défaut: 0
  plancher: 0

salarié . convention collective . pompes funèbres . ancienneté dans l'emploi:
  titre: Ancienneté dans l'emploi
  description: Ancienneté révolue dans l'emploi, en années, utilisée par la grille.
  applicable si: convention collective = 'pompes funèbres'
  par défaut: 0
  plancher: 0

salarié . convention collective . pompes funèbres . salaire minimum conventionnel:
  titre: Salaire minimum conventionnel mensuel
  description: |
    Minimum mensuel brut à temps plein selon le niveau, la position et l'ancienneté dans l'emploi.
    La grille est celle de l'annexe du texte salarial applicable à la date d'effet de la version (voir les sources).
    Les primes d'ancienneté, heures supplémentaires, remboursements de frais et primes d'assiduité ne sont
    pas intégrés dans la comparaison conventionnelle ; le modèle calcule uniquement le minimum de grille.
  applicable si:
    toutes ces conditions:
      - convention collective = 'pompes funèbres'
      - position > 0
      - salaire minimum conventionnel temps plein > 0 €/mois
  unité: €/mois
  valeur: salaire minimum conventionnel temps plein * contrat . temps de travail . quotité

salarié . convention collective . pompes funèbres . salaire minimum conventionnel temps plein:
  applicable si:
    toutes ces conditions:
      - convention collective = 'pompes funèbres'
      - position > 0
  unité: €/mois
  variations:
    - si:
        toutes ces conditions:
          - niveau = 'I'
          - position = 1
      alors: 1800 €/mois + (ancienneté dans l'emploi >= 3) * 54 €/mois + (ancienneté dans l'emploi >= 5) * 19 €/mois + (ancienneté dans l'emploi >= 10) * 38 €/mois + (ancienneté dans l'emploi >= 15) * 39 €/mois + (ancienneté dans l'emploi >= 20) * 39 €/mois + (ancienneté dans l'emploi >= 25) * 40 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'II'
          - position = 1
      alors: 1806 €/mois + (ancienneté dans l'emploi >= 3) * 55 €/mois + (ancienneté dans l'emploi >= 5) * 19 €/mois + (ancienneté dans l'emploi >= 10) * 38 €/mois + (ancienneté dans l'emploi >= 15) * 39 €/mois + (ancienneté dans l'emploi >= 20) * 40 €/mois + (ancienneté dans l'emploi >= 25) * 40 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'II'
          - position = 2
      alors: 1825 €/mois + (ancienneté dans l'emploi >= 3) * 55 €/mois + (ancienneté dans l'emploi >= 5) * 19 €/mois + (ancienneté dans l'emploi >= 10) * 38 €/mois + (ancienneté dans l'emploi >= 15) * 39 €/mois + (ancienneté dans l'emploi >= 20) * 40 €/mois + (ancienneté dans l'emploi >= 25) * 41 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'III'
          - position = 1
      alors: 1843 €/mois + (ancienneté dans l'emploi >= 3) * 56 €/mois + (ancienneté dans l'emploi >= 5) * 19 €/mois + (ancienneté dans l'emploi >= 10) * 39 €/mois + (ancienneté dans l'emploi >= 15) * 40 €/mois + (ancienneté dans l'emploi >= 20) * 40 €/mois + (ancienneté dans l'emploi >= 25) * 41 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'III'
          - position = 2
      alors: 1861 €/mois + (ancienneté dans l'emploi >= 3) * 56 €/mois + (ancienneté dans l'emploi >= 5) * 20 €/mois + (ancienneté dans l'emploi >= 10) * 39 €/mois + (ancienneté dans l'emploi >= 15) * 40 €/mois + (ancienneté dans l'emploi >= 20) * 41 €/mois + (ancienneté dans l'emploi >= 25) * 42 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'IV'
          - position = 1
      alors: 1937 €/mois + (ancienneté dans l'emploi >= 3) * 59 €/mois + (ancienneté dans l'emploi >= 5) * 20 €/mois + (ancienneté dans l'emploi >= 10) * 41 €/mois + (ancienneté dans l'emploi >= 15) * 42 €/mois + (ancienneté dans l'emploi >= 20) * 42 €/mois + (ancienneté dans l'emploi >= 25) * 43 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'IV'
          - position = 2
      alors: 1992 €/mois + (ancienneté dans l'emploi >= 3) * 60 €/mois + (ancienneté dans l'emploi >= 5) * 21 €/mois + (ancienneté dans l'emploi >= 10) * 42 €/mois + (ancienneté dans l'emploi >= 15) * 43 €/mois + (ancienneté dans l'emploi >= 20) * 44 €/mois + (ancienneté dans l'emploi >= 25) * 45 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'V'
          - position = 1
      alors: 2415 €/mois + (ancienneté dans l'emploi >= 3) * 73 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'V'
          - position = 2
      alors: 2575 €/mois + (ancienneté dans l'emploi >= 3) * 78 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'VI'
          - position = 1
      alors: 2848 €/mois + (ancienneté dans l'emploi >= 3) * 86 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'VI'
          - position = 2
      alors: 3355 €/mois + (ancienneté dans l'emploi >= 3) * 101 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'VII'
          - position = 1
      alors: 4141 €/mois + (ancienneté dans l'emploi >= 3) * 125 €/mois
