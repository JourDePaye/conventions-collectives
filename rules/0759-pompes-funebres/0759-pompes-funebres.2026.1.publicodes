# Version 2026.1 : avenant du 13 janvier 2026, barèmes au 1er janvier 2026 ; mêmes clés.
validFrom: '2026-01-01'
extension: 2026-04-10
sources:
  - https://www.legifrance.gouv.fr/conv_coll/id/KALICONT000005635490
  - >-
    Avenant du 13 janvier 2026 relatif aux barèmes nationaux de salaires minima (KALITEXT000054040202, BO
    2026-6), annexe « Salaires minima hiérarchiques au 1er janvier 2026 », article 2 : barèmes applicables
    à compter du 1er janvier 2026. Étendu par arrêté du 7 avril 2026 (JORF du 10 avril 2026).
  - >-
    Un accord paritaire du 28 avril 2026 sur les classifications des emplois (KALITEXT000054871929) existe ; il
    n'a pas été lu et n'est pas modélisé.
---
salarié . convention collective . pompes funèbres:
  titre: Entreprises de pompes funèbres (IDCC 759)
  valeur: convention collective = 'pompes funèbres'

salarié . convention collective . pompes funèbres . niveau:
  titre: Niveau de classification
  description: Niveau conventionnel attribué par l'employeur (I à VII).
  applicable si: convention collective = 'pompes funèbres'
  par défaut: '''I'''

salarié . convention collective . pompes funèbres . position:
  titre: Position de classification
  description: Position conventionnelle attribuée par l'employeur.
  applicable si: convention collective = 'pompes funèbres'
  par défaut: 0
  plancher: 0

salarié . convention collective . pompes funèbres . ancienneté dans l'emploi:
  titre: Ancienneté dans l'emploi
  description: Ancienneté révolue dans l'emploi, en années, utilisée par la grille.
  applicable si: convention collective = 'pompes funèbres'
  par défaut: 0
  plancher: 0

salarié . convention collective . pompes funèbres . salaire minimum conventionnel:
  titre: Salaire minimum conventionnel mensuel
  description: |
    Minimum mensuel brut à temps plein selon le niveau, la position et l'ancienneté dans l'emploi.
    La grille est celle de l'annexe du texte salarial applicable à la date d'effet de la version (voir les sources).
    Les primes d'ancienneté, heures supplémentaires, remboursements de frais et primes d'assiduité ne sont
    pas intégrés dans la comparaison conventionnelle ; le modèle calcule uniquement le minimum de grille.
  applicable si:
    toutes ces conditions:
      - convention collective = 'pompes funèbres'
      - position > 0
      - salaire minimum conventionnel temps plein > 0 €/mois
  unité: €/mois
  valeur: salaire minimum conventionnel temps plein * contrat . temps de travail . quotité

salarié . convention collective . pompes funèbres . salaire minimum conventionnel temps plein:
  applicable si:
    toutes ces conditions:
      - convention collective = 'pompes funèbres'
      - position > 0
  unité: €/mois
  variations:
    - si:
        toutes ces conditions:
          - niveau = 'I'
          - position = 1
      alors: 1864 €/mois + (ancienneté dans l'emploi >= 3) * 57 €/mois + (ancienneté dans l'emploi >= 5) * 19 €/mois + (ancienneté dans l'emploi >= 10) * 40 €/mois + (ancienneté dans l'emploi >= 15) * 39 €/mois + (ancienneté dans l'emploi >= 20) * 41 €/mois + (ancienneté dans l'emploi >= 25) * 42 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'II'
          - position = 1
      alors: 1871 €/mois + (ancienneté dans l'emploi >= 3) * 57 €/mois + (ancienneté dans l'emploi >= 5) * 19 €/mois + (ancienneté dans l'emploi >= 10) * 40 €/mois + (ancienneté dans l'emploi >= 15) * 40 €/mois + (ancienneté dans l'emploi >= 20) * 41 €/mois + (ancienneté dans l'emploi >= 25) * 42 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'II'
          - position = 2
      alors: 1890 €/mois + (ancienneté dans l'emploi >= 3) * 57 €/mois + (ancienneté dans l'emploi >= 5) * 20 €/mois + (ancienneté dans l'emploi >= 10) * 39 €/mois + (ancienneté dans l'emploi >= 15) * 41 €/mois + (ancienneté dans l'emploi >= 20) * 41 €/mois + (ancienneté dans l'emploi >= 25) * 43 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'III'
          - position = 1
      alors: 1909 €/mois + (ancienneté dans l'emploi >= 3) * 58 €/mois + (ancienneté dans l'emploi >= 5) * 20 €/mois + (ancienneté dans l'emploi >= 10) * 40 €/mois + (ancienneté dans l'emploi >= 15) * 41 €/mois + (ancienneté dans l'emploi >= 20) * 42 €/mois + (ancienneté dans l'emploi >= 25) * 42 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'III'
          - position = 2
      alors: 1928 €/mois + (ancienneté dans l'emploi >= 3) * 58 €/mois + (ancienneté dans l'emploi >= 5) * 20 €/mois + (ancienneté dans l'emploi >= 10) * 41 €/mois + (ancienneté dans l'emploi >= 15) * 41 €/mois + (ancienneté dans l'emploi >= 20) * 43 €/mois + (ancienneté dans l'emploi >= 25) * 43 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'IV'
          - position = 1
      alors: 2006 €/mois + (ancienneté dans l'emploi >= 3) * 61 €/mois + (ancienneté dans l'emploi >= 5) * 21 €/mois + (ancienneté dans l'emploi >= 10) * 43 €/mois + (ancienneté dans l'emploi >= 15) * 43 €/mois + (ancienneté dans l'emploi >= 20) * 43 €/mois + (ancienneté dans l'emploi >= 25) * 45 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'IV'
          - position = 2
      alors: 2063 €/mois + (ancienneté dans l'emploi >= 3) * 63 €/mois + (ancienneté dans l'emploi >= 5) * 21 €/mois + (ancienneté dans l'emploi >= 10) * 44 €/mois + (ancienneté dans l'emploi >= 15) * 45 €/mois + (ancienneté dans l'emploi >= 20) * 45 €/mois + (ancienneté dans l'emploi >= 25) * 46 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'V'
          - position = 1
      alors: 2501 €/mois + (ancienneté dans l'emploi >= 3) * 76 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'V'
          - position = 2
      alors: 2667 €/mois + (ancienneté dans l'emploi >= 3) * 81 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'VI'
          - position = 1
      alors: 2949 €/mois + (ancienneté dans l'emploi >= 3) * 89 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'VI'
          - position = 2
      alors: 3475 €/mois + (ancienneté dans l'emploi >= 3) * 104 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'VII'
          - position = 1
      alors: 4288 €/mois + (ancienneté dans l'emploi >= 3) * 130 €/mois
