# Version 2023.1 : accord du 1er février 2023, barème au 1er janvier 2023 ; mêmes clés.
validFrom: '2023-01-01'
extension: 2023-04-13
sources:
  - https://www.legifrance.gouv.fr/conv_coll/id/KALICONT000005635490
  - >-
    Accord du 1er février 2023 relatif aux salaires minima conventionnels (KALITEXT000047463726), annexe
    « Salaires minima conventionnels au 1er janvier 2023 ». Étendu par arrêté du 3 avril 2023 (JORF du 13 avril 2023).
---
salarié . convention collective . pompes funèbres:
  titre: Entreprises de pompes funèbres (IDCC 759)
  valeur: convention collective = 'pompes funèbres'

salarié . convention collective . pompes funèbres . niveau:
  titre: Niveau de classification
  description: Niveau conventionnel attribué par l'employeur (I à VII).
  applicable si: convention collective = 'pompes funèbres'
  par défaut: '''I'''

salarié . convention collective . pompes funèbres . position:
  titre: Position de classification
  description: Position conventionnelle attribuée par l'employeur.
  applicable si: convention collective = 'pompes funèbres'
  par défaut: 0
  plancher: 0

salarié . convention collective . pompes funèbres . ancienneté dans l'emploi:
  titre: Ancienneté dans l'emploi
  description: Ancienneté révolue dans l'emploi, en années, utilisée par la grille.
  applicable si: convention collective = 'pompes funèbres'
  par défaut: 0
  plancher: 0

salarié . convention collective . pompes funèbres . salaire minimum conventionnel:
  titre: Salaire minimum conventionnel mensuel
  description: |
    Minimum mensuel brut à temps plein selon le niveau, la position et l'ancienneté dans l'emploi.
    La grille est celle de l'annexe du texte salarial applicable à la date d'effet de la version (voir les sources).
    Les primes d'ancienneté, heures supplémentaires, remboursements de frais et primes d'assiduité ne sont
    pas intégrés dans la comparaison conventionnelle ; le modèle calcule uniquement le minimum de grille.
  applicable si:
    toutes ces conditions:
      - convention collective = 'pompes funèbres'
      - position > 0
      - salaire minimum conventionnel temps plein > 0 €/mois
  unité: €/mois
  valeur: salaire minimum conventionnel temps plein * contrat . temps de travail . quotité

salarié . convention collective . pompes funèbres . salaire minimum conventionnel temps plein:
  applicable si:
    toutes ces conditions:
      - convention collective = 'pompes funèbres'
      - position > 0
  unité: €/mois
  variations:
    - si:
        toutes ces conditions:
          - niveau = 'I'
          - position = 1
      alors: 1714 €/mois + (ancienneté dans l'emploi >= 3) * 32 €/mois + (ancienneté dans l'emploi >= 5) * 18 €/mois + (ancienneté dans l'emploi >= 10) * 36 €/mois + (ancienneté dans l'emploi >= 15) * 36 €/mois + (ancienneté dans l'emploi >= 20) * 37 €/mois + (ancienneté dans l'emploi >= 25) * 38 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'II'
          - position = 1
      alors: 1728 €/mois + (ancienneté dans l'emploi >= 3) * 35 €/mois + (ancienneté dans l'emploi >= 5) * 18 €/mois + (ancienneté dans l'emploi >= 10) * 36 €/mois + (ancienneté dans l'emploi >= 15) * 37 €/mois + (ancienneté dans l'emploi >= 20) * 38 €/mois + (ancienneté dans l'emploi >= 25) * 38 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'II'
          - position = 2
      alors: 1746 €/mois + (ancienneté dans l'emploi >= 3) * 35 €/mois + (ancienneté dans l'emploi >= 5) * 18 €/mois + (ancienneté dans l'emploi >= 10) * 36 €/mois + (ancienneté dans l'emploi >= 15) * 37 €/mois + (ancienneté dans l'emploi >= 20) * 38 €/mois + (ancienneté dans l'emploi >= 25) * 39 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'III'
          - position = 1
      alors: 1763 €/mois + (ancienneté dans l'emploi >= 3) * 36 €/mois + (ancienneté dans l'emploi >= 5) * 18 €/mois + (ancienneté dans l'emploi >= 10) * 37 €/mois + (ancienneté dans l'emploi >= 15) * 38 €/mois + (ancienneté dans l'emploi >= 20) * 38 €/mois + (ancienneté dans l'emploi >= 25) * 39 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'III'
          - position = 2
      alors: 1780 €/mois + (ancienneté dans l'emploi >= 3) * 36 €/mois + (ancienneté dans l'emploi >= 5) * 19 €/mois + (ancienneté dans l'emploi >= 10) * 37 €/mois + (ancienneté dans l'emploi >= 15) * 38 €/mois + (ancienneté dans l'emploi >= 20) * 39 €/mois + (ancienneté dans l'emploi >= 25) * 39 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'IV'
          - position = 1
      alors: 1853 €/mois + (ancienneté dans l'emploi >= 3) * 10 €/mois + (ancienneté dans l'emploi >= 5) * 19 €/mois + (ancienneté dans l'emploi >= 10) * 38 €/mois + (ancienneté dans l'emploi >= 15) * 39 €/mois + (ancienneté dans l'emploi >= 20) * 40 €/mois + (ancienneté dans l'emploi >= 25) * 40 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'IV'
          - position = 2
      alors: 1906 €/mois + (ancienneté dans l'emploi >= 3) * 10 €/mois + (ancienneté dans l'emploi >= 5) * 20 €/mois + (ancienneté dans l'emploi >= 10) * 39 €/mois + (ancienneté dans l'emploi >= 15) * 40 €/mois + (ancienneté dans l'emploi >= 20) * 41 €/mois + (ancienneté dans l'emploi >= 25) * 42 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'V'
          - position = 1
      alors: 2311 €/mois + (ancienneté dans l'emploi >= 3) * 47 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'V'
          - position = 2
      alors: 2464 €/mois + (ancienneté dans l'emploi >= 3) * 50 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'VI'
          - position = 1
      alors: 2725 €/mois + (ancienneté dans l'emploi >= 3) * 55 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'VI'
          - position = 2
      alors: 3210 €/mois + (ancienneté dans l'emploi >= 3) * 65 €/mois
    - si:
        toutes ces conditions:
          - niveau = 'VII'
          - position = 1
      alors: 3962 €/mois + (ancienneté dans l'emploi >= 3) * 80 €/mois
