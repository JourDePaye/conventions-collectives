# Convention collective nationale du personnel au sol des entreprises de transport aérien du 22 mai 1959 (IDCC 1391).
# Version 2026.1 : minima mensuels publiés dans le texte salarial officiel consulté.
validFrom: 2026-01-01
sources:
  - https://www.legifrance.gouv.fr/conv_coll/id/KALICONT000005635473
  - https://www.legifrance.gouv.fr/conv_coll/article/KALIARTI000019151798
  - https://www.legifrance.gouv.fr/conv_coll/article/KALIARTI000019151799
---
salarié . convention collective . manutention nettoyage aéroports:
  titre: Personnel au sol des entreprises de transport aérien (IDCC 1391)
  valeur: convention collective = 'manutention nettoyage aéroports'

salarié . convention collective . manutention nettoyage aéroports . catégorie:
  titre: Catégorie professionnelle
  description: Catégorie professionnelle de la grille des minima mensuels du personnel au sol des entreprises de transport aérien.
  applicable si: convention collective = 'manutention nettoyage aéroports'
  par défaut: "'non renseigné'"

salarié . convention collective . manutention nettoyage aéroports . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Minimum mensuel brut à temps plein, proratisé selon la quotité de travail.
  applicable si:
    toutes ces conditions:
      - convention collective = 'manutention nettoyage aéroports'
      - grille > 0 €/mois
  unité: €/mois
  produit:
    - grille
    - contrat . temps de travail . quotité

salarié . convention collective . manutention nettoyage aéroports . grille:
  titre: Salaire mensuel minimum à temps plein
  unité: €/mois
  applicable si: convention collective = 'manutention nettoyage aéroports'
  variations:
    - si: catégorie = 'A'
      alors: 2384 €/mois
    - si: catégorie = 'B'
      alors: 2450 €/mois
    - si: catégorie = 'C'
      alors: 2602 €/mois
    - si: catégorie = 'D'
      alors: 2937 €/mois
    - si: catégorie = 'E'
      alors: 3649 €/mois
    - sinon: 0 €/mois

salarié . convention collective . manutention nettoyage aéroports . catégorie hors grille:
  titre: Catégorie absente de la grille
  description: La catégorie fournie ne correspond pas à une ligne modélisée de la grille.
  applicable si: convention collective = 'manutention nettoyage aéroports'
  valeur: grille = 0 €/mois
