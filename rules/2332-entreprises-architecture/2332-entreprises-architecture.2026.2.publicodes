salarié . convention collective . entreprises d'architecture . zone:
  titre: Zone du territoire
  description: >-
    Zone 1 ou 2 en Île-de-France (zone 1 : 75, 92, 93, 94) et en Rhône-Alpes (zone 1 : 01, 38, 69, 73,
    74 ; zone 2 : 07, 26, 42), CUTM ou hors CUTM en Midi-Pyrénées, aucune ailleurs.
  applicable si: convention collective = 'entreprises d'architecture'
  variations:
    - si: territoire = 'Île-de-France'
      alors:
        variations:
          - si:
              une de ces conditions:
                - département = '75'
                - département = '92'
                - département = '93'
                - département = '94'
            alors: "'zone 1'"
          - sinon: "'zone 2'"
    - si: territoire = 'Rhône-Alpes'
      alors:
        variations:
          - si:
              une de ces conditions:
                - département = '01'
                - département = '38'
                - département = '69'
                - département = '73'
                - département = '74'
            alors: "'zone 1'"
          - sinon: "'zone 2'"
    - si: territoire = 'Midi-Pyrénées'
      alors:
        variations:
          - si: Toulouse Métropole
            alors: "'CUTM'"
          - sinon: "'hors CUTM'"
    - sinon: "'aucune'"

salarié . convention collective . entreprises d'architecture . coefficient:
  titre: Coefficient hiérarchique
  description: Coefficient de la grille de classification (article V.1.10 de la CCN), de 200 à 600 de 20 en 20.
  applicable si: convention collective = 'entreprises d'architecture'
  par défaut: 0

salarié . convention collective . entreprises d'architecture . valeur du point:
  titre: Valeur du point du territoire
  applicable si: convention collective = 'entreprises d'architecture'
  unité: €/point
  variations:
    - si: territoire = 'Alsace'
      alors:
        variations:
          - si: date >= 01/04/2026
            alors:
              9.09 €/point
          - sinon:
              9 €/point
    - si: territoire = 'Aquitaine'
      alors:
        variations:
          - si: date >= 01/04/2026
            alors:
              9.28 €/point
          - sinon:
              9.19 €/point
    - si: territoire = 'Auvergne'
      alors:
        variations:
          - si: date >= 01/04/2026
            alors:
              9.2 €/point
          - sinon:
              9.11 €/point
    - si: territoire = 'Basse-Normandie'
      alors:
        variations:
          - si: date >= 01/04/2026
            alors:
              variations:
                - si: coefficient <= 300
                  alors: 9.34 €/point
                - sinon: 9.14 €/point
          - sinon:
              variations:
                - si: coefficient <= 300
                  alors: 9.25 €/point
                - sinon: 9.03 €/point
    - si: territoire = 'Bourgogne'
      alors:
        variations:
          - si: date >= 01/04/2026
            alors:
              9.21 €/point
          - sinon:
              9.12 €/point
    - si: territoire = 'Bretagne'
      alors:
        variations:
          - si: date >= 01/06/2026
            alors:
              variations:
                - si: coefficient <= 380
                  alors: 9.18 €/point
                - sinon: 8.95 €/point
          - sinon:
              variations:
                - si: coefficient <= 280
                  alors: 9.13 €/point
                - si: coefficient <= 380
                  alors: 9 €/point
                - sinon: 8.88 €/point
    - si: territoire = 'Centre-Val de Loire'
      alors:
        variations:
          - si: date >= 01/04/2026
            alors:
              9.13 €/point
          - sinon:
              9.04 €/point
    - si: territoire = 'Champagne-Ardenne'
      alors:
        variations:
          - si: date >= 01/04/2026
            alors:
              9.05 €/point
          - sinon:
              8.96 €/point
    - si: territoire = 'Corse'
      alors:
        variations:
          - si: date >= 01/05/2026
            alors:
              9.21 €/point
          - sinon:
              9.13 €/point
    - si: territoire = 'Franche-Comté'
      alors:
        variations:
          - si: date >= 01/05/2026
            alors:
              9.18 €/point
          - sinon:
              9 €/point
    - si: territoire = 'Guadeloupe'
      alors:
        variations:
          - si: date >= 01/08/2026
            alors:
              variations:
                - si: coefficient <= 280
                  alors: 9.14 €/point
                - si: coefficient <= 380
                  alors: 9.03 €/point
                - sinon: 8.93 €/point
          - sinon:
              variations:
                - si: coefficient <= 280
                  alors: 9.05 €/point
                - si: coefficient <= 380
                  alors: 8.94 €/point
                - sinon: 8.84 €/point
    - si: territoire = 'Guyane'
      alors:
        variations:
          - si: date >= 01/08/2026
            alors:
              variations:
                - si: coefficient <= 280
                  alors: 9.11 €/point
                - si: coefficient <= 380
                  alors: 8.99 €/point
                - sinon: 8.89 €/point
          - sinon:
              variations:
                - si: coefficient <= 280
                  alors: 9.02 €/point
                - si: coefficient <= 380
                  alors: 8.9 €/point
                - sinon: 8.8 €/point
    - si: territoire = 'Haute-Normandie'
      alors:
        variations:
          - si: date >= 01/04/2026
            alors:
              variations:
                - si: coefficient <= 300
                  alors: 9.34 €/point
                - sinon: 9.14 €/point
          - sinon:
              variations:
                - si: coefficient <= 300
                  alors: 9.25 €/point
                - sinon: 9.03 €/point
    - si: territoire = 'Île-de-France'
      alors:
        variations:
          - si: date >= 01/04/2026
            alors:
              variations:
                - si: zone = 'zone 1'
                  alors:
                    variations:
                      - si: coefficient <= 280
                        alors: 9.95 €/point
                      - si: coefficient <= 380
                        alors: 9.77 €/point
                      - sinon: 9.59 €/point
                - si: zone = 'zone 2'
                  alors:
                    variations:
                      - si: coefficient <= 280
