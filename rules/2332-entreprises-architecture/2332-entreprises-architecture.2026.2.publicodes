salarié . convention collective . entreprises d'architecture . plancher mensuel:
  titre: Salaire minimum mensuel du territoire
  applicable si: convention collective = 'entreprises d'architecture'
  unité: €/mois
  variations:
    - si: territoire = 'Alsace'
      alors:
        variations:
          - si: date >= 01/04/2026
            alors:
              1890 €/mois
          - sinon:
              1850 €/mois
    - si: territoire = 'Champagne-Ardenne'
      alors:
        variations:
          - si: date >= 01/04/2026
            alors:
              1950 €/mois
          - sinon:
              1900 €/mois
    - si: territoire = 'Nord-Pas-de-Calais'
      alors:
        variations:
          - si: date >= 01/04/2026
            alors:
              1880 €/mois
          - sinon:
              1860 €/mois
    - si: territoire = 'Picardie'
      alors:
        variations:
          - si: date >= 01/05/2026
            alors:
              1923 €/mois
          - sinon:
              1900 €/mois
    - si: territoire = 'Rhône-Alpes'
      alors:
        variations:
          - si: date >= 01/06/2026
            alors:
              0 €/mois
          - sinon:
              variations:
                - si: zone = 'zone 1'
                  alors: 1945 €/mois
                - si: zone = 'zone 2'
                  alors: 1892 €/mois
                - sinon: 0 €/mois
    - sinon: 0 €/mois

salarié . convention collective . entreprises d'architecture . grille applicable:
  titre: Un accord territorial fixe la valeur du point
  applicable si: convention collective = 'entreprises d'architecture'
  valeur: valeur du point > 0 €/point

salarié . convention collective . entreprises d'architecture . coefficient hors grille:
  titre: Coefficient absent de la grille de classification
  description: Un accord territorial s'applique, mais le coefficient n'est pas l'un de ceux de la grille (200 à 600, de 20 en 20).
  applicable si: convention collective = 'entreprises d'architecture'
  toutes ces conditions:
    - grille applicable

    - coefficient != 200
    - coefficient != 220
    - coefficient != 240
    - coefficient != 260
    - coefficient != 280
    - coefficient != 300
    - coefficient != 320
    - coefficient != 340
    - coefficient != 360
    - coefficient != 380
    - coefficient != 400
    - coefficient != 420
    - coefficient != 440
    - coefficient != 460
    - coefficient != 480
    - coefficient != 500
    - coefficient != 520
    - coefficient != 540
    - coefficient != 560
    - coefficient != 580
    - coefficient != 600

salarié . convention collective . entreprises d'architecture . minimum mensuel de la grille:
  titre: Minimum mensuel à temps plein
  description: >-
    Coefficient multiplié par la valeur du point du territoire, pour 35 heures par semaine (article
    V.2.1), sans être inférieur au salaire minimum du territoire quand son accord en fixe un ; 0 sans
    accord territorial.
  applicable si: convention collective = 'entreprises d'architecture'
  unité: €/mois
  variations:
    - si: grille applicable = non
      alors: 0 €/mois
    - si: coefficient * valeur du point < plancher mensuel
      alors: plancher mensuel
    - sinon: coefficient * valeur du point

salarié . convention collective . entreprises d'architecture . salaire minimum conventionnel:
  titre: Salaire minimum conventionnel
  description: Minimum mensuel brut proratisé selon la quotité de travail.
  applicable si: convention collective = 'entreprises d'architecture'
  unité: €/mois
  produit:
    - minimum mensuel de la grille
    - contrat . temps de travail . quotité

salarié . convention collective . entreprises d'architecture . zone hors accord:
  titre: Aucun accord territorial
  description: Le territoire n'a pas d'accord sur la valeur du point (Mayotte), ou le département est inconnu.
  applicable si: convention collective = 'entreprises d'architecture'
  valeur: grille applicable = non
