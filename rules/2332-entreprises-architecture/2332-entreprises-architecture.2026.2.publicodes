salarié . convention collective . entreprises d'architecture:
  titre: Entreprises d'architecture (IDCC 2332)
  valeur: convention collective = 'entreprises d'architecture'

salarié . convention collective . entreprises d'architecture . département:
  titre: Département de l'établissement
  description: >-
    Les deux premiers chiffres du code postal de l'établissement, ou les trois premiers outre-mer
    (971 à 976) ; la Corse est 20, 2A ou 2B. Il désigne la commission territoriale paritaire dont la
    valeur du point s'applique (article XV.5.1 de la CCN).
  applicable si: convention collective = 'entreprises d'architecture'
  type: texte
  par défaut: "'non renseigné'"

salarié . convention collective . entreprises d'architecture . Toulouse Métropole:
  titre: Établissement dans Toulouse Métropole
  description: >-
    Oui lorsque l'établissement se trouve dans une commune de Toulouse Métropole (zone CUTM des
    accords Midi-Pyrénées).
  applicable si: territoire = 'Midi-Pyrénées'
  par défaut: non

salarié . convention collective . entreprises d'architecture . territoire:
  titre: Commission territoriale paritaire
  description: Territoire de l'article XV.5.1 de la CCN, d'après le département ; « hors territoire » sans département connu.
  applicable si: convention collective = 'entreprises d'architecture'
  variations:
    - si:
        une de ces conditions:
          - département = '67'
          - département = '68'
      alors: "'Alsace'"
    - si:
        une de ces conditions:
          - département = '24'
          - département = '33'
          - département = '40'
          - département = '47'
          - département = '64'
      alors: "'Aquitaine'"
    - si:
        une de ces conditions:
          - département = '03'
          - département = '15'
          - département = '43'
          - département = '63'
      alors: "'Auvergne'"
    - si:
        une de ces conditions:
          - département = '14'
          - département = '50'
          - département = '61'
      alors: "'Basse-Normandie'"
    - si:
        une de ces conditions:
          - département = '21'
          - département = '58'
          - département = '71'
          - département = '89'
      alors: "'Bourgogne'"
    - si:
        une de ces conditions:
          - département = '22'
          - département = '29'
          - département = '35'
          - département = '56'
      alors: "'Bretagne'"
    - si:
        une de ces conditions:
          - département = '18'
          - département = '28'
          - département = '36'
          - département = '37'
          - département = '41'
          - département = '45'
      alors: "'Centre-Val de Loire'"
    - si:
        une de ces conditions:
          - département = '08'
          - département = '10'
          - département = '51'
          - département = '52'
      alors: "'Champagne-Ardenne'"
    - si:
        une de ces conditions:
          - département = '20'
          - département = '2A'
          - département = '2B'
      alors: "'Corse'"
    - si:
        une de ces conditions:
          - département = '25'
          - département = '39'
          - département = '70'
          - département = '90'
      alors: "'Franche-Comté'"
    - si:
        une de ces conditions:
          - département = '971'
      alors: "'Guadeloupe'"
    - si:
        une de ces conditions:
          - département = '973'
      alors: "'Guyane'"
