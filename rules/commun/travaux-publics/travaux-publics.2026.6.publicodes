              - jours zone 2
              - zone 2 . trajet
          - produit:
              - jours zone 3
              - zone 3 . trajet
          - produit:
              - jours zone 4
              - zone 4 . trajet
          - produit:
              - jours zone 5
              - zone 5 . trajet
          - produit:
              - jours zone 6
              - zone 6 . trajet
          - produit:
              - jours zone 7
              - zone 7 . trajet
    - sinon: 0 €/mois

