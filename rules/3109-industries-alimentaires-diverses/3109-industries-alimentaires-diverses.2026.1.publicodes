# Convention collective nationale des cinq branches industries alimentaires diverses (IDCC 3109, brochure 3384).
# Version 2026.1 : avenant n° 31 du 16 janvier 2026 relatif aux salaires minima conventionnels.
# L'avenant est étendu par arrêté du 2 avril 2026, publié au Journal officiel le 17 avril 2026.
validFrom: 2026-01-01
sources:
  - "Avenant n° 31 du 16 janvier 2026 relatif aux salaires minima conventionnels, article 1er et annexe, texte officiel Légifrance : https://www.legifrance.gouv.fr/conv_coll/article/KALIARTI000054162160"
  - "Arrêté du 2 avril 2026 portant extension de l'avenant n° 31, publié au Journal officiel le 17 avril 2026, JORFTEXT000053907584."
---
salarié . convention collective . industries alimentaires diverses:
  titre: Cinq branches industries alimentaires diverses (IDCC 3109)
  valeur: convention collective = 'industries alimentaires diverses'

salarié . convention collective . industries alimentaires diverses . position:
  titre: Position de classification
  description: Position N1-E1 à N9-E1 de la grille de l'avenant n° 31 relatif aux salaires minima conventionnels.
  applicable si: convention collective = 'industries alimentaires diverses'
  par défaut: "'non renseigné'"

salarié . convention collective . industries alimentaires diverses . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Salaire minimum mensuel correspondant à la position de classification, pour un temps plein.
  applicable si: convention collective = 'industries alimentaires diverses'
  unité: €/mois
  produit:
    - grille
    - contrat . temps de travail . quotité

salarié . convention collective . industries alimentaires diverses . grille:
  titre: Salaire minimum mensuel à temps plein
  description: Grille de l'annexe de l'avenant n° 31 du 16 janvier 2026.
  applicable si: convention collective = 'industries alimentaires diverses'
  unité: €/mois
  variations:
    - si: position = 'N1-E1'
      alors: 1841.03 €/mois
    - si: position = 'N1-E2'
      alors: 1859.03 €/mois
    - si: position = 'N1-E3'
      alors: 1877.03 €/mois
    - si: position = 'N2-E1'
      alors: 1899.03 €/mois
    - si: position = 'N2-E2'
      alors: 1928.03 €/mois
    - si: position = 'N2-E3'
      alors: 1967.03 €/mois
    - si: position = 'N3-E1'
      alors: 2013.03 €/mois
    - si: position = 'N3-E2'
      alors: 2054.03 €/mois
    - si: position = 'N3-E3'
      alors: 2100.03 €/mois
    - si: position = 'N4-E1'
      alors: 2165.03 €/mois
    - si: position = 'N4-E2'
      alors: 2233.03 €/mois
    - si: position = 'N5-E1'
      alors: 2324.03 €/mois
    - si: position = 'N5-E2'
      alors: 2464.03 €/mois
    - si: position = 'N6-E1'
      alors: 2610.03 €/mois
    - si: position = 'N6-E2'
      alors: 2870.03 €/mois
    - si: position = 'N7-E1'
      alors: 2974.03 €/mois
    - si: position = 'N7-E2'
      alors: 3078.03 €/mois
    - si: position = 'N8-E1'
      alors: 3202.03 €/mois
    - si: position = 'N8-E2'
      alors: 4248.03 €/mois
    - si: position = 'N9-E1'
      alors: 5294.03 €/mois
    - sinon: 0 €/mois

salarié . convention collective . industries alimentaires diverses . position hors grille:
  titre: Position absente de la grille
  description: La position n'existe pas dans la grille des salaires minima de l'avenant n° 31.
  applicable si: convention collective = 'industries alimentaires diverses'
  valeur: grille = 0 €/mois
