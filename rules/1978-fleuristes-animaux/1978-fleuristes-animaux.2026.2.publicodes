# Convention collective nationale des fleuristes, de la vente et des services des animaux familiers
# du 21 janvier 1997 (IDCC 1978, brochure 3010).
# Version 2026.2, applicable au 1er août 2026 après extension de l'accord salarial.

validFrom: 2026-08-01
sources:
  - Accord du 10 mars 2026 relatif aux salaires minima conventionnels, applicable au 1er août 2026 après extension ; texte et grille publiés sur Légifrance.
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000054554019
  - Article 1 de l'accord du 10 mars 2026, grille des salaires minima mensuels des niveaux I à VII, échelons 1 à 3.
    https://www.legifrance.gouv.fr/conv_coll/article/KALIARTI000054554022
  - Arrêté du 17 juillet 2026 portant extension de l'accord du 10 mars 2026, publié au JORF le 22 juillet 2026.
    https://www.legifrance.gouv.fr/jorf/id/JORFTEXT000054451384
  - "Article 9.2 de la convention collective actualisée du 29 septembre 2020, étendue par arrêté du 17 décembre 2021 : prime d'ancienneté de 3 %, 6 %, 9 %, 12 % et 15 % après 3, 6, 9, 12 et 15 ans de présence effective, calculée sur le salaire minimum de l'emploi et proportionnelle au temps partiel. https://www.legifrance.gouv.fr/conv_coll/article/KALIARTI000043234490"
---
salarié . convention collective . fleuristes animaux:
  titre: Fleuristes, vente et services des animaux familiers (IDCC 1978)
  valeur: convention collective = 'fleuristes animaux'

salarié . convention collective . fleuristes animaux . niveau:
  titre: Niveau et échelon de classification
  description: Niveau I à VII et échelon 1 à 3, par exemple I.1 ou VII.3.
  applicable si: convention collective = 'fleuristes animaux'
  par défaut: "'non renseigné'"

salarié . convention collective . fleuristes animaux . salaire minimum conventionnel:
  titre: Salaire minimum mensuel garanti
  description: Minimum mensuel pour 151,67 heures, proratisé selon la quotité de travail. Vaut 0 €/mois si la classification est absente de la grille.
  applicable si: convention collective = 'fleuristes animaux'
  unité: €/mois
  produit:
    - grille
    - contrat . temps de travail . quotité

salarié . convention collective . fleuristes animaux . grille:
  titre: Grille mensuelle des minima salariaux
  description: Grille de l'article 1 de l'accord du 10 mars 2026, applicable à compter du 1er août 2026.
  applicable si: convention collective = 'fleuristes animaux'
  unité: €/mois
  variations:
    - si: niveau = 'I.1'
      alors: 1882.18 €/mois
    - si: niveau = 'I.2'
      alors: 1892.63 €/mois
    - si: niveau = 'I.3'
      alors: 1903.08 €/mois
    - si: niveau = 'II.1'
      alors: 1913.55 €/mois
    - si: niveau = 'II.2'
      alors: 1924 €/mois
    - si: niveau = 'II.3'
      alors: 1934.46 €/mois
    - si: niveau = 'III.1'
      alors: 1944.91 €/mois
    - si: niveau = 'III.2'
      alors: 1955.37 €/mois
    - si: niveau = 'III.3'
      alors: 1965.83 €/mois
    - si: niveau = 'IV.1'
      alors: 1976.29 €/mois
    - si: niveau = 'IV.2'
      alors: 2018.11 €/mois
    - si: niveau = 'IV.3'
      alors: 2059.93 €/mois
    - si: niveau = 'V.1'
      alors: 2159.27 €/mois
    - si: niveau = 'V.2'
      alors: 2274.30 €/mois
    - si: niveau = 'V.3'
      alors: 2394.55 €/mois
    - si: niveau = 'VI.1'
      alors: 2514.79 €/mois
    - si: niveau = 'VI.2'
      alors: 2692.56 €/mois
    - si: niveau = 'VI.3'
      alors: 2953.97 €/mois
    - si: niveau = 'VII.1'
      alors: 3701.61 €/mois
    - si: niveau = 'VII.2'
      alors: 3910.74 €/mois
    - si: niveau = 'VII.3'
      alors: 4078.05 €/mois
    - sinon: 0 €/mois

salarié . convention collective . fleuristes animaux . niveau hors grille:
  titre: Classification absente de la grille
  description: Le niveau et l'échelon n'existent pas dans la grille des minima salariaux.
  applicable si: convention collective = 'fleuristes animaux'
  valeur: grille = 0 €/mois

salarié . convention collective . fleuristes animaux . taux de prime d'ancienneté:
  titre: Taux de prime d'ancienneté
  description: Taux conventionnel selon la présence effective dans l'établissement.
  applicable si: convention collective = 'fleuristes animaux'
  unité: "%"
  variations:
    - si: salarié . ancienneté >= 15 an
      alors: 15 %
    - si: salarié . ancienneté >= 12 an
      alors: 12 %
    - si: salarié . ancienneté >= 9 an
      alors: 9 %
    - si: salarié . ancienneté >= 6 an
      alors: 6 %
    - si: salarié . ancienneté >= 3 an
      alors: 3 %
    - sinon: 0 %

salarié . convention collective . fleuristes animaux . prime d'ancienneté:
  titre: Prime d'ancienneté
  description: Prime mensuelle calculée sur le salaire minimum de l'emploi, proratisée selon la quotité de travail.
  applicable si: convention collective = 'fleuristes animaux'
  unité: €/mois
  arrondi: 2 décimales
  valeur: taux de prime d'ancienneté * grille * contrat . temps de travail . quotité
