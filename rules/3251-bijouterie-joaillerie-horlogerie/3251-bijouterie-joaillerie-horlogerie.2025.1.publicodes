salarié . convention collective . bijouterie joaillerie orfèvrerie horlogerie . classification hors grille:
  titre: Classification absente de la grille modélisée
  description: La grille BJOH modélisée couvre les niveaux 1 à 7 et les échelons 1 à 4.
  applicable si: convention collective = 'bijouterie joaillerie orfèvrerie horlogerie'
  toutes ces conditions:
    - classification != '1.1'
    - classification != '1.2'
    - classification != '1.3'
    - classification != '1.4'
    - classification != '2.1'
    - classification != '2.2'
    - classification != '2.3'
    - classification != '2.4'
    - classification != '3.1'
    - classification != '3.2'
    - classification != '3.3'
    - classification != '3.4'
    - classification != '4.1'
    - classification != '4.2'
    - classification != '4.3'
    - classification != '4.4'
    - classification != '5.1'
    - classification != '5.2'
    - classification != '5.3'
    - classification != '5.4'
    - classification != '6.1'
