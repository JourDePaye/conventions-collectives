# Convention collective nationale du personnel navigant du groupement des armateurs de services de passages d'eau (IDCC 3228).
# Version 2022.1 : accord du 14 mars 2022 relatif aux salaires minima, applicable au 1er janvier 2022.
validFrom: 2022-01-01
sources:
  - >-
    Accord du 14 mars 2022 relatif aux salaires minima du personnel navigant du GASPE,
    annexe 1 : barème de rémunération au 1er janvier 2022, base 1 607 heures annuelles,
    publié sur Légifrance : https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000046565704
  - >-
    Arrêté du 26 juillet 2022 portant extension de l'accord du 14 mars 2022,
    mentionné dans le texte officiel Légifrance.
---
salarié . convention collective . groupement armateurs passages eau:
  titre: Personnel navigant du GASPE (IDCC 3228)
  valeur: convention collective = 'groupement armateurs passages eau'

salarié . convention collective . groupement armateurs passages eau . fonction:
  titre: Fonction navigante
  description: Fonction de l'annexe 1 du barème GASPE au 1er janvier 2022.
  applicable si: convention collective = 'groupement armateurs passages eau'
  par défaut: "'non renseigné'"

salarié . convention collective . groupement armateurs passages eau . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Salaire mensuel brut minimal hors accessoires, sur la base de 1 607 heures annuelles, proratisé selon la quotité de travail.
  applicable si: convention collective = 'groupement armateurs passages eau'
  unité: €/mois
  produit:
    - grille mensuelle
    - contrat . temps de travail . quotité

salarié . convention collective . groupement armateurs passages eau . grille mensuelle:
  titre: Barème mensuel GASPE au 1er janvier 2022
  description: Minima mensuels hors accessoires de l'annexe 1 de l'accord du 14 mars 2022.
  applicable si: convention collective = 'groupement armateurs passages eau'
  unité: €/mois
  variations:
    - si: fonction = 'capitaines et chefs mécaniciens 15e catégorie ENIM'
      alors: 2675.39 €/mois
    - si: fonction = 'capitaines chefs mécaniciens moins de 200 ums 12e catégorie ENIM'
      alors: 2388.04 €/mois
    - si: fonction = 'capitaines et chefs mécaniciens 12e catégorie ENIM'
      alors: 2305.64 €/mois
    - si: fonction = 'patrons de vedettes inférieures à 50 ums'
      alors: 1824 €/mois
    - si: fonction = 'maîtres pont et machine'
      alors: 1768.71 €/mois
    - si: fonction = 'mécaniciens ouvriers mécaniciens timoniers'
      alors: 1669.44 €/mois
    - si: fonction = 'matelots qualifiés graisseurs'
      alors: 1624.42 €/mois
    - si: fonction = 'matelots matelots légers'
      alors: 1606.01 €/mois
    - sinon: 0 €/mois

salarié . convention collective . groupement armateurs passages eau . fonction hors grille:
  titre: Fonction absente du barème
  description: La fonction fournie ne correspond pas à une fonction de l'annexe 1.
  applicable si: convention collective = 'groupement armateurs passages eau'
  valeur: grille mensuelle = 0 €/mois

salarié . convention collective . groupement armateurs passages eau . audit paie:
  titre: Audit des rubriques de paie
  description: L'accord salarial et les textes dédiés ont été recherchés pour les cotisations salarié et employeur, taux, assiettes, plafonds, tranches, forfaits, santé, prévoyance, retraite, formation, AT/MP, primes, avantages et frais ; aucun taux conventionnel générique supplémentaire n'est calculé par cette version.
  applicable si: convention collective = 'groupement armateurs passages eau'
  valeur: non
