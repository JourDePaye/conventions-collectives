# Convention collective nationale des activités du déchet du 16 avril 2019 (IDCC 2149,
# brochure 3156).
#
# Version 2026.2, fusionnée avec modele-social par @jourdepaye/payroll-core.
# Une version publiée ne se modifie plus (voir versions.lock.json) : toute évolution ou
# correction passe par une nouvelle version.
#
# Premier document : métadonnées de la version. Second document : règles publicodes, en
# français comme dans modele-social.

# Date de contrôle de la valeur du point de 18,67 €.
validFrom: 2026-01-01
sources:
  - https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000039313034
  - https://www.legifrance.gouv.fr/conv_coll/id/KALIARTI000039313059
  - Valeur du point de 18,67 € applicable au 1er janvier 2025, retenue faute de texte officiel
    publié établissant une valeur 2026 opposable à l'ensemble du champ.
---
salarié . convention collective . activités du déchet:
  titre: Activités du déchet (IDCC 2149)
  valeur: convention collective = 'activités du déchet'

salarié . convention collective . activités du déchet . coefficient:
  titre: Coefficient hiérarchique
  description: |
    Coefficient de la classification : 100 (niveau I), 104, 107, 110 (niveau II), 114, 118, 125,
    132 (niveau III), 150, 167 (niveau IV) ou 170 (niveau V).
  applicable si: convention collective = 'activités du déchet'
  par défaut: 0

salarié . convention collective . activités du déchet . coefficient valide:
  titre: Coefficient de la grille
  applicable si: convention collective = 'activités du déchet'
  une de ces conditions:
    - coefficient = 100
    - coefficient = 104
    - coefficient = 107
    - coefficient = 110
    - coefficient = 114
    - coefficient = 118
    - coefficient = 125
    - coefficient = 132
    - coefficient = 150
    - coefficient = 167
    - coefficient = 170

salarié . convention collective . activités du déchet . valeur du point:
  titre: Valeur du point
  description: Valeur du point officiellement publiée au 1er janvier 2025, maintenue en l'absence d'une nouvelle valeur officielle.
  applicable si: convention collective = 'activités du déchet'
  unité: €/mois
  valeur: 18.67 €/mois

salarié . convention collective . activités du déchet . salaire minimum conventionnel:
  titre: Salaire minimum mensuel garanti
  description: |
    Pour les coefficients 100 à 132, coefficient multiplié par la valeur du point, pour 151,67
    heures par mois, proratisé pour un temps partiel. Les coefficients 150 à 170 relèvent du
    minimum annuel conventionnel ci-dessous.
  applicable si: convention collective = 'activités du déchet'
  unité: €/mois
  valeur: salaire indiciaire * contrat . temps de travail . quotité

salarié . convention collective . activités du déchet . salaire minimum conventionnel . salaire indiciaire:
  titre: Salaire indiciaire à temps plein
  unité: €/mois
  variations:
    - si: coefficient = 100
      alors: coefficient * valeur du point
    - si: coefficient = 104
      alors: coefficient * valeur du point
    - si: coefficient = 107
      alors: coefficient * valeur du point
    - si: coefficient = 110
      alors: coefficient * valeur du point
    - si: coefficient = 114
      alors: coefficient * valeur du point
    - si: coefficient = 118
      alors: coefficient * valeur du point
    - si: coefficient = 125
      alors: coefficient * valeur du point
    - si: coefficient = 132
      alors: coefficient * valeur du point
    - sinon: 0 €/mois

salarié . convention collective . activités du déchet . salaire minimum annuel conventionnel:
  titre: Salaire minimum annuel garanti
  description: |
    Pour les coefficients 150 à 170 (niveaux IV et V), minimum annuel conventionnel calculé
    comme douze fois le coefficient multiplié par la valeur du point. Vaut 0 €/an pour les
    coefficients mensuels ou un coefficient absent de la grille.
  applicable si: convention collective = 'activités du déchet'
  unité: €/an
  valeur: salaire annuel indiciaire * contrat . temps de travail . quotité

salarié . convention collective . activités du déchet . salaire minimum annuel conventionnel . salaire annuel indiciaire:
  titre: Salaire annuel indiciaire à temps plein
  unité: €/an
  variations:
    - si: coefficient = 150
      alors: coefficient * valeur du point
    - si: coefficient = 167
      alors: coefficient * valeur du point
    - si: coefficient = 170
      alors: coefficient * valeur du point
    - sinon: 0 €/an

salarié . convention collective . activités du déchet . coefficient hors grille:
  titre: Coefficient absent de la grille
  description: Le coefficient n'est pas l'un des onze coefficients de la grille.
  applicable si: convention collective = 'activités du déchet'
  valeur: coefficient valide = non
