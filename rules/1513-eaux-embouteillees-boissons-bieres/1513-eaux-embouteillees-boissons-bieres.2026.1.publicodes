    - si: classification = '6-2'
      alors: 3056.73 €/mois
    - si: classification = '6-3'
      alors: 3264.75 €/mois
    - si: classification = '7-1'
      alors: 3505.55 €/mois
    - si: classification = '7-2'
      alors: 3747.26 €/mois
    - si: classification = '7-3'
      alors: 3988.95 €/mois
    - si: classification = '8-1'
