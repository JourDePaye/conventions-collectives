# Convention collective nationale de la fabrication et du commerce des produits à usage
# pharmaceutique, parapharmaceutique et vétérinaire (IDCC 1555).
# Version 2026.1 : accord du 28 janvier 2026 relatif aux rémunérations minimales
# conventionnelles au 1er mars 2026.
validFrom: 2026-03-01
extension: 2026-05-08
sources:
  - https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000054262136
  - https://www.legifrance.gouv.fr/jorf/id/JORFTEXT000054048732
  - https://www.legifrance.gouv.fr/jorf/article_jo/JORFARTI000054048736
---
salarié . convention collective . produits pharmaceutiques:
  titre: Fabrication et commerce des produits à usage pharmaceutique, parapharmaceutique et vétérinaire (IDCC 1555)
  valeur: convention collective = 'produits pharmaceutiques'
salarié . convention collective . produits pharmaceutiques . niveau:
  titre: Niveau de classification
  description: Niveau I.1 à II.7 pour les rémunérations minimales mensuelles garanties, ou III.1 à III.10 pour les rémunérations annuelles garanties. Le classement est fourni par l'application et n'est pas déduit de l'intitulé du poste.
  applicable si: convention collective = 'produits pharmaceutiques'
  par défaut: "'non renseigné'"
salarié . convention collective . produits pharmaceutiques . grille mensuelle:
  applicable si: convention collective = 'produits pharmaceutiques'
  unité: €/mois
  variations:
    - si: niveau = 'I.1'
      alors: 1835 €/mois
    - si: niveau = 'I.2'
      alors: 1848.76 €/mois
    - si: niveau = 'I.3'
      alors: 1876.49 €/mois
    - si: niveau = 'I.4'
      alors: 1914.02 €/mois
    - si: niveau = 'I.5'
      alors: 1961.87 €/mois
    - si: niveau = 'I.6'
      alors: 2020.73 €/mois
    - si: niveau = 'II.1'
      alors: 2121.77 €/mois
    - si: niveau = 'II.2'
      alors: 2232.10 €/mois
    - si: niveau = 'II.3'
      alors: 2352.63 €/mois
    - si: niveau = 'II.4'
      alors: 2484.38 €/mois
    - si: niveau = 'II.5'
      alors: 2625.99 €/mois
    - si: niveau = 'II.6'
      alors: 2778.30 €/mois
    - si: niveau = 'II.7'
      alors: 2942.22 €/mois
    - sinon: 0 €/mois
salarié . convention collective . produits pharmaceutiques . grille annuelle:
  applicable si: convention collective = 'produits pharmaceutiques'
  unité: €/an
  variations:
    - si: niveau = 'III.1'
      alors: 37381 €/an
    - si: niveau = 'III.2'
      alors: 42579 €/an
    - si: niveau = 'III.3'
      alors: 46611 €/an
    - si: niveau = 'III.4'
      alors: 50346 €/an
    - si: niveau = 'III.5'
      alors: 54616 €/an
    - si: niveau = 'III.6'
      alors: 58887 €/an
    - si: niveau = 'III.7'
      alors: 63691 €/an
    - si: niveau = 'III.8'
      alors: 68497 €/an
    - si: niveau = 'III.9'
      alors: 73834 €/an
    - si: niveau = 'III.10'
      alors: 79171 €/an
    - sinon: 0 €/an
salarié . convention collective . produits pharmaceutiques . niveau hors grille:
  applicable si: convention collective = 'produits pharmaceutiques'
  valeur:
    toutes ces conditions:
      - grille mensuelle = 0 €/mois
      - grille annuelle = 0 €/an
salarié . convention collective . produits pharmaceutiques . calcul bloqué:
  applicable si: convention collective = 'produits pharmaceutiques'
  valeur:
    une de ces conditions:
      - niveau hors grille
salarié . convention collective . produits pharmaceutiques . salaire minimum conventionnel:
  titre: Rémunération minimale mensuelle garantie
  description: RMMG au 1er mars 2026 pour 151,67 heures par mois, adaptée à l'horaire effectif par la quotité de travail. Les éléments de rémunération pris en compte et les exclusions de l'article 3 ne sont pas comparés ici.
  applicable si:
    toutes ces conditions:
      - convention collective = 'produits pharmaceutiques'
      - calcul bloqué = non
      - grille mensuelle > 0 €/mois
  unité: €/mois
  valeur: grille mensuelle * contrat . temps de travail . quotité
salarié . convention collective . produits pharmaceutiques . salaire minimum annuel conventionnel:
  titre: Rémunération annuelle garantie
  description: RAG au 1er mars 2026. Elle reste exprimée en euros par an ; aucun douzième n'est inventé par le modèle. Les éléments de rémunération pris en compte et les exclusions de l'article 4 ne sont pas comparés ici.
  applicable si:
    toutes ces conditions:
      - convention collective = 'produits pharmaceutiques'
      - calcul bloqué = non
      - grille annuelle > 0 €/an
  unité: €/an
  valeur: grille annuelle
