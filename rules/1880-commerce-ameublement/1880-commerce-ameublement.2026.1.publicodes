# Convention collective nationale du négoce de l'ameublement du 31 mai 1995 (IDCC 1880).
# Version 2026.1, grille des salaires minima de l'accord du 19 mars 2026.
# Applicable au 1er mai 2026 pour les adhérents de la CNEF ; accord étendu par arrêté du 11 juin 2026.

validFrom: 2026-05-01
sources:
  - Accord du 19 mars 2026 relatif aux salaires minima pour l'année 2026, signé par la CNEF, la FNECS CFE-CGC, la CFTC CSFV et la FS CFDT ; BO 2026-18. Étendu sous réserve de l'application des dispositions réglementaires portant fixation du SMIC.
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000054426659
  - Article 1er de l'accord, grille des salaires minima mensuels sur la base de 151,67 heures, groupes 1 à 9 (23 positions).
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000054426659
  - Article 2 de l'accord, qui annule et remplace la grille de l'accord du 14 mai 2024 ; application au 1er mai 2026 pour les adhérents à la CNEF, et à compter de l'extension pour les entreprises non adhérentes du champ de la convention.
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000054426659
  - Arrêté du 11 juin 2026 portant extension de l'accord, publié au JORF du 27 juin 2026 (mention lue sur la page Légifrance de l'accord ; le texte de l'arrêté n'a pas été ouvert). Pour les employeurs non adhérents, la grille s'applique donc à partir du 28 juin 2026.
---
salarié . convention collective . commerce de l'ameublement:
  titre: Négoce de l'ameublement (IDCC 1880)
  valeur: convention collective = 'commerce de l'ameublement'

salarié . convention collective . commerce de l'ameublement . niveau:
  titre: Groupe et niveau de classification
  description: Groupe et niveau de la grille, par exemple 2.1 ou 9.2. Le groupe 1 n'a qu'un niveau unique, noté 1.
  applicable si: convention collective = 'commerce de l'ameublement'
  par défaut: "'non renseigné'"

salarié . convention collective . commerce de l'ameublement . salaire minimum conventionnel:
  titre: Salaire minimum mensuel garanti
  description: Minimum mensuel pour 151,67 heures, proratisé selon la quotité de travail. Vaut 0 €/mois si la classification est absente de la grille.
  applicable si: convention collective = 'commerce de l'ameublement'
  unité: €/mois
  produit:
    - grille
    - contrat . temps de travail . quotité

salarié . convention collective . commerce de l'ameublement . grille:
  titre: Grille mensuelle des minima salariaux
  description: Grille de l'article 1er de l'accord du 19 mars 2026 (groupes 1 à 9, base 151,67 heures).
  applicable si: convention collective = 'commerce de l'ameublement'
  unité: €/mois
  variations:
    - si: niveau = '1'
      alors: 1830 €/mois
    - si: niveau = '2.1'
      alors: 1835 €/mois
    - si: niveau = '2.2'
      alors: 1839 €/mois
    - si: niveau = '2.3'
      alors: 1845 €/mois
    - si: niveau = '3.1'
      alors: 1863 €/mois
    - si: niveau = '3.2'
      alors: 1885 €/mois
    - si: niveau = '3.3'
      alors: 1916 €/mois
    - si: niveau = '4.1'
      alors: 1956 €/mois
    - si: niveau = '4.2'
      alors: 1986 €/mois
    - si: niveau = '4.3'
      alors: 2016 €/mois
    - si: niveau = '5.1'
      alors: 2098 €/mois
    - si: niveau = '5.2'
      alors: 2139 €/mois
    - si: niveau = '5.3'
      alors: 2244 €/mois
    - si: niveau = '6.1'
      alors: 2395 €/mois
    - si: niveau = '6.2'
      alors: 2468 €/mois
    - si: niveau = '6.3'
      alors: 2541 €/mois
    - si: niveau = '7.1'
      alors: 2725 €/mois
    - si: niveau = '7.2'
      alors: 3129 €/mois
    - si: niveau = '7.3'
      alors: 3354 €/mois
    - si: niveau = '8.1'
      alors: 3545 €/mois
    - si: niveau = '8.2'
      alors: 3862 €/mois
    - si: niveau = '9.1'
      alors: 4507 €/mois
    - si: niveau = '9.2'
      alors: 4970 €/mois
    - sinon: 0 €/mois

salarié . convention collective . commerce de l'ameublement . niveau hors grille:
  titre: Classification absente de la grille
  description: Le groupe et le niveau n'existent pas dans la grille des minima salariaux.
  applicable si: convention collective = 'commerce de l'ameublement'
  valeur: grille = 0 €/mois

salarié . convention collective . commerce de l'ameublement . audit paie:
  titre: Audit de paie
  applicable si: convention collective = 'commerce de l'ameublement'
  valeur: non
