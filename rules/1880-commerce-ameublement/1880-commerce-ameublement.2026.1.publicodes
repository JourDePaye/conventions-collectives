# Convention collective nationale du commerce de l'ameublement du 31 mai 1995
# (IDCC 1880, brochure 3056).
#
# Version 2026.1, fusionnée avec modele-social par @jourdepaye/payroll-core.
# Une version publiée ne se modifie plus (voir versions.lock.json) : toute évolution ou
# correction passe par une nouvelle version.
validFrom: 2026-06-01
sources:
  - >-
    Accord du 16 octobre 2025 relatif aux salaires minima conventionnels, applicable au
    1er janvier 2026, texte KALI KALITEXT000054426659, publié sur Légifrance.
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000054426659
  - >-
    Article de l'accord relatif à l'extension et à l'entrée en vigueur générale au 1er juin
    2026, publié dans la base officielle des conventions collectives de Légifrance.
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000054426659
---
salarié . convention collective . commerce de l'ameublement:
  titre: Commerce de l'ameublement (IDCC 1880)
  valeur: convention collective = 'commerce de l'ameublement'

salarié . convention collective . commerce de l'ameublement . niveau:
  titre: Niveau de classification
  description: Niveaux 1 à 5 de la grille des salaires minima conventionnels des employés.
  applicable si: convention collective = 'commerce de l'ameublement'
  par défaut: "'non renseigné'"

salarié . convention collective . commerce de l'ameublement . salaire minimum conventionnel:
  titre: Salaire minimum conventionnel
  description: |
    Salaire minimum mensuel conventionnel pour 35 heures par semaine. Il est proratisé
    pour un temps partiel. Vaut 0 €/mois si la classification n'existe pas dans la grille
    modélisée (voir « niveau hors grille »).
  applicable si: convention collective = 'commerce de l'ameublement'
  unité: €/mois
  produit:
    - grille
    - contrat . temps de travail . quotité

salarié . convention collective . commerce de l'ameublement . grille:
  titre: Salaire minimum conventionnel à temps plein
  description: Grille de l'accord du 16 octobre 2025 relatif aux salaires minima conventionnels.
  applicable si: convention collective = 'commerce de l'ameublement'
  unité: €/mois
  variations:
    - si: niveau = '1'
      alors: 1823 €/mois
    - si: niveau = '2'
      alors: 1834 €/mois
    - si: niveau = '3'
      alors: 1845 €/mois
    - si: niveau = '4'
      alors: 1857 €/mois
    - si: niveau = '5'
      alors: 1871 €/mois
    - sinon: 0 €/mois

salarié . convention collective . commerce de l'ameublement . niveau hors grille:
  titre: Classification absente de la grille modélisée
  description: Le niveau n'existe pas dans la grille des emplois employés modélisée.
  applicable si: convention collective = 'commerce de l'ameublement'
  valeur: grille = 0 €/mois
