validFrom: '2026-05-01'
sources:
  - https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000054936694
  - https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000054936695
  - https://www.cibtp-centre.fr/entreprise/declarations-cotisations/cotisations-conges-payes
  - https://www.cibtp-centre.fr/entreprise/declarations-cotisations/cotisations-chomage-intemperies
  - https://www.probtp.com/files/live/sites/probtp/files/media/pdf/PRO/declarations/notice-entreprise-assiette-taux.pdf
---
salarié . convention collective . bâtiment ouvriers petites entreprises:
  titre: Bâtiment — ouvriers des entreprises jusqu'à 10 salariés (IDCC 1596)
  valeur: convention collective = 'bâtiment ouvriers petites entreprises'
  description: >-
    Convention collective des ouvriers du bâtiment employés par une entreprise
    occupant jusqu'à 10 salariés. Le salaire minimum est limité à la grille
    régionale Centre-Val de Loire vérifiée dans cette version.
  rend non applicable: rémunération . indemnités CDD . congés payés
salarié . convention collective . bâtiment ouvriers petites entreprises . catégorie:
  question: À quelle catégorie le salarié appartient-il ?
  une possibilité:
    - ouvrier
    - cadre
  par défaut: "'ouvrier'"
  avec:
    ouvrier:
      titre: Ouvrier
    cadre:
      titre: Cadre
salarié . convention collective . bâtiment ouvriers petites entreprises . région:
  question: Dans quelle région l'entreprise est-elle établie pour l'application de la grille ?
  par défaut: "'Centre-Val de Loire'"
salarié . convention collective . bâtiment ouvriers petites entreprises . coefficient:
  question: Quel est le coefficient de l'ouvrier ?
  par défaut: 150
  unité: coefficient
salarié . convention collective . bâtiment ouvriers petites entreprises . date de calcul:
  question: À quelle date le minimum conventionnel doit-il être vérifié ?
  par défaut: 01/05/2026
salarié . convention collective . bâtiment ouvriers petites entreprises . caisse de rattachement:
  question: À quelle caisse CIBTP l'entreprise est-elle rattachée ?
  par défaut: "'centre'"

salarié . convention collective . bâtiment ouvriers petites entreprises . grille régionale:
  applicable si:
    toutes ces conditions:
      - convention collective = 'bâtiment ouvriers petites entreprises'
      - catégorie = 'ouvrier'
      - région = 'Centre-Val de Loire'
      - date de calcul >= 01/05/2026
      - date de calcul <= 31/12/2026
  unité: €/mois
  variations:
    - si: coefficient = 150
      alors: 1823 €/mois
    - si: coefficient = 170
      alors: 1863 €/mois
    - si: coefficient = 185
      alors: 1907 €/mois
    - si: coefficient = 210
      alors: 2056 €/mois
    - si: coefficient = 230
      alors: 2175 €/mois
    - si: coefficient = 250
      alors: 2293 €/mois
    - si: coefficient = 270
      alors: 2412 €/mois
    - sinon: 0 €/mois
salarié . convention collective . bâtiment ouvriers petites entreprises . coefficient hors grille:
  applicable si: convention collective = 'bâtiment ouvriers petites entreprises'
  toutes ces conditions:
    - coefficient != 150
    - coefficient != 170
    - coefficient != 185
    - coefficient != 210
    - coefficient != 230
    - coefficient != 250
    - coefficient != 270
salarié . convention collective . bâtiment ouvriers petites entreprises . région hors grille:
  applicable si: convention collective = 'bâtiment ouvriers petites entreprises'
  valeur: région != 'Centre-Val de Loire'
salarié . convention collective . bâtiment ouvriers petites entreprises . catégorie hors champ:
  applicable si: convention collective = 'bâtiment ouvriers petites entreprises'
  valeur: catégorie != 'ouvrier'
salarié . convention collective . bâtiment ouvriers petites entreprises . période hors couverture:
  applicable si: convention collective = 'bâtiment ouvriers petites entreprises'
  une de ces conditions:
    - date de calcul < 01/05/2026
    - date de calcul > 31/12/2026
salarié . convention collective . bâtiment ouvriers petites entreprises . calcul bloqué:
  applicable si: convention collective = 'bâtiment ouvriers petites entreprises'
  une de ces conditions:
    - coefficient hors grille
    - région hors grille
    - catégorie hors champ
    - période hors couverture
salarié . convention collective . bâtiment ouvriers petites entreprises . salaire minimum conventionnel:
  applicable si:
    toutes ces conditions:
      - convention collective = 'bâtiment ouvriers petites entreprises'
      - calcul bloqué = non
  unité: €/mois
  valeur: grille régionale

salarié . convention collective . bâtiment ouvriers petites entreprises . cotisations employeur:
  remplace: cotisations . employeur
  somme:
    - cotisations . employeur
    - congés intempéries
    - chômage intempéries
    - OPPBTP
salarié . convention collective . bâtiment ouvriers petites entreprises . congés intempéries:
  titre: cotisation congés payés CIBTP
  produit:
    - valeur: cotisations . assiette
    - variations:
        - si: date >= 01/04/2026
          alors: 20.70%
        - sinon: 20.40%
  description: Taux 2026 de la caisse CIBTP du Centre, applicable à la convention bâtiment.
  références:
    CIBTP Centre, cotisations congés payés: https://www.cibtp-centre.fr/entreprise/declarations-cotisations/cotisations-conges-payes
salarié . convention collective . bâtiment ouvriers petites entreprises . chômage intempéries:
  titre: cotisation chômage intempéries
  produit:
    - valeur: cotisations . assiette
      plafond: temps de travail . plafond sécurité sociale
    - taux
  description: >-
    Cotisation patronale CIBTP assise sur les salaires plafonnés. L'abattement
    annuel par entreprise n'est pas calculé salarié par salarié.
  références:
    CIBTP Centre, cotisations chômage intempéries: https://www.cibtp-centre.fr/entreprise/declarations-cotisations/cotisations-chomage-intemperies
salarié . convention collective . bâtiment ouvriers petites entreprises . chômage intempéries . taux:
  unité: '%'
  variations:
    - si: secteur = 'gros œuvre'
      alors: 0.68%
    - si: secteur = 'second œuvre'
      alors: 0.13%
    - sinon: 0%
salarié . convention collective . bâtiment ouvriers petites entreprises . chômage intempéries . secteur:
  question: Quelle est l'activité de l'entreprise pour la cotisation chômage intempéries ?
  une possibilité:
    - gros œuvre
    - second œuvre
    - non exposée
  par défaut: "'second œuvre'"
  avec:
    gros œuvre:
      titre: Gros œuvre ou travaux publics
    second œuvre:
      titre: Second œuvre
    non exposée:
      titre: Activité non exposée aux intempéries
salarié . convention collective . bâtiment ouvriers petites entreprises . OPPBTP:
  produit:
    - valeur: contrat . salaire brut * 1.1314
    - 0.11%

salarié . convention collective . bâtiment ouvriers petites entreprises . prévoyance cadre:
  applicable si:
    toutes ces conditions:
      - convention collective = 'bâtiment ouvriers petites entreprises'
      - catégorie = 'cadre'
  rend non applicable: cotisations . prévoyances . employeur . cadres
  somme:
    - employeur
    - salarié
  avec:
    employeur:
      barème:
        assiette: contrat . salaire brut
        multiplicateur: plafond sécurité sociale
        tranches:
          - taux: 1.50%
            plafond: 1
          - taux: 50% * 2.40%
            plafond: 4
      remplace: cotisations . prévoyances . employeur . cadres
    salarié:
      barème:
        assiette: contrat . salaire brut
        multiplicateur: plafond sécurité sociale
        tranches:
          - taux: 0%
            plafond: 1
          - taux: 50% * 2.40%
            plafond: 4
      remplace: cotisations . prévoyances . employeur . cadres
  description: >-
    Régime national de prévoyance des cadres du BTP. La tranche A employeur de
    1,50 % remplace la prévoyance cadre de droit commun ; la tranche C de 3,60 %
    est optionnelle et n'est pas calculée.
  références:
    PRO BTP, notice entreprise assiette et taux: https://www.probtp.com/files/live/sites/probtp/files/media/pdf/PRO/declarations/notice-entreprise-assiette-taux.pdf
salarié . convention collective . bâtiment ouvriers petites entreprises . prévoyance cadre . tranche C incluse:
  applicable si: convention collective = 'bâtiment ouvriers petites entreprises'
  par défaut: non
