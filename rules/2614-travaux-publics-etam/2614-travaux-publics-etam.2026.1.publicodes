validFrom: '2026-04-17'
sources:
  - https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000054162121
  - https://www.cibtp.fr/actualite-/-presse/actualites/actualite/principales-revalorisations-pour-2026
  - https://www.cibtp.fr/documentation/reglementation
  - https://www.oppbtp.com/app/uploads/2025/12/arrete-2025-taux-2026.pdf
---
salarié . convention collective . travaux publics ETAM:
  titre: Travaux publics — ETAM (IDCC 2614)
  valeur: convention collective = 'travaux publics ETAM'
  description: >-
    Convention collective nationale des employés, techniciens et agents de
    maîtrise des travaux publics. Cette version est limitée à la grille 2026
    étendue d'Île-de-France.
salarié . convention collective . travaux publics ETAM . catégorie:
  question: À quelle catégorie le salarié appartient-il ?
  une possibilité:
    - "'ETAM'"
    - "'cadre'"
  par défaut: "'ETAM'"
salarié . convention collective . travaux publics ETAM . région:
  question: Dans quelle région l'entreprise est-elle établie pour l'application de la grille ?
  par défaut: "'Île-de-France'"
salarié . convention collective . travaux publics ETAM . niveau:
  question: Quel est le niveau de l'ETAM ?
  une possibilité:
    - "'A'"
    - "'B'"
    - "'C'"
    - "'D'"
    - "'E'"
    - "'F'"
    - "'G'"
    - "'H'"
  par défaut: "'A'"
salarié . convention collective . travaux publics ETAM . forfait jours:
  question: L'ETAM bénéficie-t-il d'une convention de forfait en jours sur l'année ?
  par défaut: non
salarié . convention collective . travaux publics ETAM . date de calcul:
  question: À quelle date le minimum conventionnel doit-il être vérifié ?
  par défaut: 17/04/2026
salarié . convention collective . travaux publics ETAM . caisse de rattachement:
  question: À quelle caisse CIBTP l'entreprise est-elle rattachée ?
  par défaut: "'à déterminer'"

salarié . convention collective . travaux publics ETAM . grille annuelle:
  applicable si:
    toutes ces conditions:
      - convention collective = 'travaux publics ETAM'
      - catégorie = 'ETAM'
      - région = 'Île-de-France'
      - date de calcul >= 17/04/2026
      - date de calcul <= 31/12/2026
  unité: €/an
  variations:
    - si: niveau = 'A'
      alors: 23545 €/an
    - si: niveau = 'B'
      alors: 25372 €/an
    - si: niveau = 'C'
      alors: 27185 €/an
    - si: niveau = 'D'
      alors: 29847 €/an
    - si: niveau = 'E'
      alors: 33260 €/an
    - si: niveau = 'F'
      alors: 37255 €/an
    - si: niveau = 'G'
      alors: 39628 €/an
    - si: niveau = 'H'
      alors: 40624 €/an
    - sinon: 0 €/an
salarié . convention collective . travaux publics ETAM . grille forfait jours:
  applicable si: grille annuelle
  unité: €/an
  variations:
    - si: niveau = 'F'
      alors: 42843 €/an
    - si: niveau = 'G'
      alors: 45572 €/an
    - si: niveau = 'H'
      alors: 46718 €/an
    - sinon: grille annuelle
salarié . convention collective . travaux publics ETAM . niveau hors grille:
  applicable si: convention collective = 'travaux publics ETAM'
  toutes ces conditions:
    - niveau != 'A'
    - niveau != 'B'
    - niveau != 'C'
    - niveau != 'D'
    - niveau != 'E'
    - niveau != 'F'
    - niveau != 'G'
    - niveau != 'H'
salarié . convention collective . travaux publics ETAM . région hors grille:
  applicable si: convention collective = 'travaux publics ETAM'
  valeur: région != 'Île-de-France'
salarié . convention collective . travaux publics ETAM . catégorie hors champ:
  applicable si: convention collective = 'travaux publics ETAM'
  valeur: catégorie != 'ETAM'
salarié . convention collective . travaux publics ETAM . période hors couverture:
  applicable si: convention collective = 'travaux publics ETAM'
  une de ces conditions:
    - date de calcul < 17/04/2026
    - date de calcul > 31/12/2026
salarié . convention collective . travaux publics ETAM . calcul bloqué:
  applicable si: convention collective = 'travaux publics ETAM'
  une de ces conditions:
    - niveau hors grille
    - région hors grille
    - catégorie hors champ
    - période hors couverture
salarié . convention collective . travaux publics ETAM . salaire minimum annuel conventionnel:
  applicable si:
    toutes ces conditions:
      - convention collective = 'travaux publics ETAM'
      - calcul bloqué = non
  unité: €/an
  valeur:
    variations:
      - si: forfait jours = oui
        alors: grille forfait jours
      - sinon: grille annuelle

salarié . convention collective . travaux publics ETAM . cotisations employeur:
  remplace: cotisations . employeur
  somme:
    - cotisations . employeur
    - congés intempéries
    - chômage intempéries
    - OPPBTP
salarié . convention collective . travaux publics ETAM . congés intempéries:
  titre: cotisation congés payés CIBTP
  produit:
    - valeur: cotisations . assiette
    - 20.70%
  description: Taux CIBTP 2026 appliqué dans l'espace de noms de cette version.
salarié . convention collective . travaux publics ETAM . chômage intempéries:
  titre: cotisation chômage intempéries
  produit:
    - valeur: cotisations . assiette
      plafond: temps de travail . plafond sécurité sociale
    - taux
  description: >-
    Cotisation patronale chômage intempéries, plafonnée au PMSS. L'abattement
    annuel et sa limite sont déterminés au niveau de l'entreprise et ne sont
    pas imputés artificiellement salarié par salarié.
salarié . convention collective . travaux publics ETAM . chômage intempéries . taux:
  unité: '%'
  variations:
    - si: secteur = 'gros œuvre'
      alors: 0.68%
    - si: secteur = 'second œuvre'
      alors: 0.13%
    - sinon: 0%
salarié . convention collective . travaux publics ETAM . chômage intempéries . secteur:
  question: Quelle est l'activité de l'entreprise pour la cotisation chômage intempéries ?
  une possibilité:
    - gros œuvre
    - second œuvre
    - non exposée
  par défaut: "'second œuvre'"
  avec:
    gros œuvre:
      titre: Gros œuvre ou travaux publics
    second œuvre:
      titre: Second œuvre
    non exposée:
      titre: Activité non exposée aux intempéries
salarié . convention collective . travaux publics ETAM . OPPBTP:
  produit:
    - contrat . salaire brut * 1.1314
    - 0.11%
  description: Cotisation OPPBTP 2026, dans l'espace de noms IDCC 2614.
