salarié . convention collective . transports routiers . maintien de salaire . accident du travail:
  valeur: motif = 'accident du travail'

salarié . convention collective . transports routiers . maintien de salaire . éligible:
  titre: Droit au maintien
  description: Après 3 ans d'ancienneté, en cas de maladie ou d'accident.
  valeur:
    toutes ces conditions:
      - ancienneté >= 36 mois
      - une de ces conditions:
            - motif = 'maladie'
            - motif = 'accident du travail'
            - motif = 'accident de trajet'

salarié . convention collective . transports routiers . maintien de salaire . ancienneté en cours d'absence:
  valeur: non

salarié . convention collective . transports routiers . maintien de salaire . carence:
  titre: Délai de franchise
  description: Cinq jours pour la maladie des ouvriers et des employés.
  unité: jour
  variations:
    - si:
        une de ces conditions:
          - accident du travail
          - maîtrise
          - cadre
      alors: 0 jour
    - sinon: 5 jour

salarié . convention collective . transports routiers . maintien de salaire . première période . durée:
  unité: jour
  variations:
    - si: haute maîtrise
      alors:
        variations:
          - si: ancienneté >= 120 mois
            alors: 120 jour
          - si: ancienneté >= 60 mois
            alors: 90 jour
          - sinon: 60 jour
    - si: accident du travail
      alors:
        variations:
          - si: ancienneté >= 120 mois
            alors: 90 jour
          - si: ancienneté >= 60 mois
            alors: 60 jour
          - sinon: 30 jour
    - si: maîtrise
      alors:
        variations:
          - si: ancienneté >= 120 mois
            alors: 90 jour
          - si: ancienneté >= 60 mois
            alors: 60 jour
          - sinon: 30 jour
    - sinon:
        variations:
          - si: ancienneté >= 120 mois
            alors: 95 jour
          - si: ancienneté >= 60 mois
            alors: 65 jour
          - sinon: 35 jour

salarié . convention collective . transports routiers . maintien de salaire . première période . taux:
  unité: '%'
  valeur: 100%

salarié . convention collective . transports routiers . maintien de salaire . seconde période . durée:
  unité: jour
  variations:
    - si:
