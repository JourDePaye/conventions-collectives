        variations:
          - si: ancienneté >= 120 mois
            alors: 120 jour
          - si: ancienneté >= 60 mois
            alors: 90 jour
          - sinon: 60 jour
    - si: accident du travail
      alors:
        variations:
          - si: ancienneté >= 120 mois
            alors: 120 jour
          - si: ancienneté >= 60 mois
            alors: 90 jour
          - sinon: 60 jour
    - si: maîtrise
      alors:
        variations:
          - si: ancienneté >= 120 mois
            alors: 90 jour
          - si: ancienneté >= 60 mois
            alors: 60 jour
          - sinon: 30 jour
    - sinon:
