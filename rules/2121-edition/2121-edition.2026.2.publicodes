# Convention collective nationale de l'édition du 14 janvier 2000 (IDCC 2121, brochure 3076).
#
# Version 2026.2: same grid as 2026.1, effective from 1 June 2026. Avenant n° 18 of 26 June 2026,
# art. 6: in force on 1 June 2026, retroactive when applied on the July 2026 payroll.
# Version 2026.1 (validFrom 2026-07-01) is kept unchanged; the grid is identical, so the
# result is the same after 1 July 2026. Rule names and classification keys are unchanged.
validFrom: 2026-06-01
extension: 2026-09-19
sources:
  - >-
    Avenant n° 18 du 26 juin 2026 relatif aux salaires minima conventionnels au 1er juin 2026,
    KALITEXT000054951908, article 3 (minima mensuels au 1er juin 2026), IDCC 2121.
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000054951908
  - >-
    Article 6 de l'avenant n° 18, entrée en vigueur le 1er juin 2026 ; en cas de mise en oeuvre sur la paie
    de juillet 2026, application rétroactive à compter du 1er juin 2026.
  - >-
    Arrêté du 7 septembre 2026 portant extension de l'avenant n° 18, JORF du 19 septembre 2026, avec réserve
    sur l'article 8 (clause de non-dérogation) ; BO 2026-29.
  - >-
    Convention collective nationale de l'édition du 14 janvier 2000, conteneur KALICONT000005635096.
---
salarié . convention collective . édition:
  titre: Édition (IDCC 2121)
  valeur: convention collective = 'édition'

salarié . convention collective . édition . niveau:
  titre: Catégorie de classification
  description: |
    E5 à E9 pour les employés, AM/T 1 à AM/T 4 pour les agents de maîtrise et techniciens,
    Cl A, Cl B, C2A, C2 B, C3A, C3 B et C4 pour les cadres.
  applicable si: convention collective = 'édition'
  par défaut: "'non renseigné'"

salarié . convention collective . édition . salaire minimum conventionnel:
  titre: Salaire minimum mensuel garanti
  description: |
    Minimum mensuel conventionnel à temps complet selon l'avenant n° 18 du 26 juin 2026,
    proratisé par la quotité de travail. Le montant vaut 0 €/mois si la catégorie n'est pas
    dans la grille (voir « niveau hors grille »). Le minimum légal (SMIC) reste dû s'il
    est supérieur.
  applicable si: convention collective = 'édition'
  unité: €/mois
  produit:
    - grille
    - contrat . temps de travail . quotité

salarié . convention collective . édition . salaire minimum conventionnel . grille:
  titre: Salaire minimum mensuel à temps complet
  unité: €/mois
  variations:
    - si: niveau = 'E5'
      alors: 1868 €/mois
    - si: niveau = 'E6'
      alors: 1883 €/mois
    - si: niveau = 'E7'
      alors: 1898 €/mois
    - si: niveau = 'E8'
      alors: 1913 €/mois
    - si: niveau = 'E9'
      alors: 1928 €/mois
    - si: niveau = 'AM/T 1'
      alors: 1958 €/mois
    - si: niveau = 'AM/T 2'
      alors: 2025 €/mois
    - si: niveau = 'AM/T 3'
      alors: 2094 €/mois
    - si: niveau = 'AM/T 4'
      alors: 2165 €/mois
    - si: niveau = 'Cl A'
      alors: 2241 €/mois
    - si: niveau = 'Cl B'
      alors: 2327 €/mois
    - si: niveau = 'C2A'
      alors: 2494 €/mois
    - si: niveau = 'C2 B'
      alors: 2678 €/mois
    - si: niveau = 'C3A'
      alors: 2964 €/mois
    - si: niveau = 'C3 B'
      alors: 3341 €/mois
    - si: niveau = 'C4'
      alors: 3847 €/mois
    - sinon: 0 €/mois

salarié . convention collective . édition . niveau hors grille:
  titre: Catégorie absente de la grille
  description: La catégorie n'existe pas dans la grille des salaires minima de l'avenant n° 18.
  applicable si: convention collective = 'édition'
  valeur: salaire minimum conventionnel . grille = 0 €/mois
