# Version 2026.1 : accord du 26 février 2026 (valeur du point 1,26, valeur de base 1 830),
# mêmes niveaux et mêmes règles que 2025.2.
validFrom: 2026-01-01
extension: 2026-05-29
sources:
  - >-
    Accord du 26 février 2026 relatif à l'évolution des salaires minima conventionnels des
    personnels ouvriers, ETAM et cadres, IDCC 1558, texte officiel Légifrance (BO 2026-15) :
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000054370714 . Article 7 : entrée en
    vigueur le 1er janvier 2026. Étendu par arrêté du 19 mai 2026, JORF du 29 mai 2026 (mention
    de la page Légifrance du texte ; l'identifiant JORFTEXT de l'arrêté n'a pas été lu).
  - >-
    Annexe I (minima mensuels NA à NF, 151,67 heures) et annexe II (minima annuels NG à J et
    colonne forfait) du même accord, lues sur la page Légifrance.
  - >-
    L'indemnité de panier de 16 € (accord du 14 janvier 2025, article 6, KALITEXT000051580202)
    n'est pas modifiée par l'accord de 2026, qui ne la mentionne pas.
---
salarié . convention collective . industries céramiques:
  titre: Industries céramiques de France (IDCC 1558)
  valeur: convention collective = 'industries céramiques'

salarié . convention collective . industries céramiques . classification:
  titre: Niveau et échelon de classification
  description: Niveau et échelon de la grille de l'accord salarial du 26 février 2026.
  applicable si: convention collective = 'industries céramiques'
  par défaut: "'non renseigné'"

salarié . convention collective . industries céramiques . forfait annuel en jours:
  titre: Salarié au forfait annuel en jours
  description: Sélectionner oui pour les minima annuels spécifiques au forfait jours des cadres.
  applicable si: convention collective = 'industries céramiques'
  par défaut: non

salarié . convention collective . industries céramiques . salarié éligible à l'indemnité de panier:
  titre: Salarié éligible à l'indemnité de panier
  description: Éligibilité à déclarer lorsque les conditions conventionnelles de panier sont remplies.
  applicable si: convention collective = 'industries céramiques'
  par défaut: non

salarié . convention collective . industries céramiques . grille mensuelle:
  titre: Salaire minimum mensuel conventionnel à temps plein
  description: Minima mensuels des niveaux NA à NF pour 151,67 heures.
  applicable si: convention collective = 'industries céramiques'
  unité: €/mois
  variations:
    - si: classification = 'NA-E1'
      alors: 1831.26 €/mois
    - si: classification = 'NA-E2'
      alors: 1838.82 €/mois
    - si: classification = 'NB-E1'
      alors: 1848.90 €/mois
    - si: classification = 'NB-E2'
      alors: 1861.50€/mois
    - si: classification = 'NB-E3'
      alors: 1874.10 €/mois
    - si: classification = 'NC-E1'
      alors: 1886.70 €/mois
    - si: classification = 'NC-E2'
      alors: 1911.90 €/mois
    - si: classification = 'NC-E3'
      alors: 1949.70 €/mois
    - si: classification = 'NC-E4'
      alors: 2000.10 €/mois
    - si: classification = 'ND-E1'
      alors: 2050.50€/mois
    - si: classification = 'ND-E2'
      alors: 2113.50€/mois
    - si: classification = 'ND-E3'
      alors: 2176.50€/mois
    - si: classification = 'ND-E4'
      alors: 2239.50€/mois
    - si: classification = 'NE-E1'
      alors: 2315.10 €/mois
    - si: classification = 'NE-E2'
      alors: 2390.70 €/mois
    - si: classification = 'NE-E3'
      alors: 2466.30 €/mois
    - si: classification = 'NE-E4'
      alors: 2541.90 €/mois
    - si: classification = 'NF-E1'
      alors: 2630.10 €/mois
    - si: classification = 'NF-E2'
      alors: 2718.30 €/mois
    - si: classification = 'NF-E3'
      alors: 2806.50€/mois
    - sinon: 0 €/mois

salarié . convention collective . industries céramiques . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Minimum mensuel des niveaux NA à NF, proratisé selon la quotité de travail. Les niveaux cadres sont annuels.
  applicable si:
    toutes ces conditions:
      - convention collective = 'industries céramiques'
      - grille mensuelle > 0 €/mois
  unité: €/mois
  valeur: grille mensuelle * contrat . temps de travail . quotité

salarié . convention collective . industries céramiques . grille annuelle:
  titre: Salaire minimum annuel conventionnel à temps plein
  description: Minima annuels 2026 des niveaux NG à J ; la colonne forfait jours est choisie explicitement.
  applicable si: convention collective = 'industries céramiques'
  unité: €/an
  variations:
    - si:
        toutes ces conditions:
          - classification = 'NG-E1'
          - forfait annuel en jours = non
      alors: 32619.60 €/an
    - si:
        toutes ces conditions:
          - classification = 'NG-E1'
          - forfait annuel en jours = oui
      alors: 34902.97 €/an
    - si:
        toutes ces conditions:
          - classification = 'NG-E2'
          - forfait annuel en jours = non
      alors: 34736.40 €/an
    - si:
        toutes ces conditions:
          - classification = 'NG-E2'
          - forfait annuel en jours = oui
      alors: 37167.95 €/an
    - si:
        toutes ces conditions:
          - classification = 'H'
          - forfait annuel en jours = non
      alors: 39423.60 €/an
    - si:
        toutes ces conditions:
          - classification = 'H'
          - forfait annuel en jours = oui
      alors: 43365.96 €/an
    - si:
        toutes ces conditions:
          - classification = 'I'
          - forfait annuel en jours = non
      alors: 47905.92 €/an
    - si:
        toutes ces conditions:
          - classification = 'I'
          - forfait annuel en jours = oui
      alors: 52696.51 €/an
    - si:
        toutes ces conditions:
          - classification = 'J'
          - forfait annuel en jours = non
      alors: 59382 €/an
    - si:
        toutes ces conditions:
          - classification = 'J'
          - forfait annuel en jours = oui
      alors: 65320.20 €/an
    - sinon: 0 €/an

salarié . convention collective . industries céramiques . salaire minimum annuel conventionnel:
  titre: Salaire minimum annuel conventionnel
  description: Minimum annuel brut des cadres, proratisé selon la quotité de travail.
  applicable si:
    toutes ces conditions:
      - convention collective = 'industries céramiques'
      - grille annuelle > 0 €/an
  unité: €/an
  valeur: grille annuelle * contrat . temps de travail . quotité

salarié . convention collective . industries céramiques . indemnité de panier:
  titre: Indemnité conventionnelle de panier
  description: Montant par journée éligible, lorsque l'éligibilité est déclarée ; l'application doit fournir le nombre de jours.
  applicable si: convention collective = 'industries céramiques'
  unité: €/jour
  valeur: 16 €/jour * salarié éligible à l'indemnité de panier

salarié . convention collective . industries céramiques . niveau hors grille:
  titre: Niveau ou échelon absent de la grille conventionnelle
  description: >-
    La classification ne figure ni dans la grille mensuelle des niveaux NA à NF ni dans la
    grille annuelle des cadres NG à J.
  applicable si: convention collective = 'industries céramiques'
  toutes ces conditions:
    - grille mensuelle = 0 €/mois
    - grille annuelle = 0 €/an
