# Convention collective nationale de l'inspection d'assurance du 27 juillet 1992 (IDCC 1679).
# Version 2007.1 : protocole d'accord du 21 mars 2007 relatif aux RMA 2007.
validFrom: 2007-01-01
sources:
  - https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000017890005
  - https://www.legifrance.gouv.fr/conv_coll/id/KALICONT000005635475
---
salarié . convention collective . inspection assurance:
  titre: Inspection d'assurance (IDCC 1679)
  valeur: convention collective = 'inspection assurance'

salarié . convention collective . inspection assurance . classe:
  titre: Classe de classification
  description: Classe 5 à 7 du barème des rémunérations minimales annuelles des fonctions d'inspection.
  applicable si: convention collective = 'inspection assurance'
  par défaut: "'non renseigné'"

salarié . convention collective . inspection assurance . date de calcul:
  titre: Date de calcul
  description: Date de référence pour le protocole salarial du 21 mars 2007.
  applicable si: convention collective = 'inspection assurance'
  par défaut: 01/01/1900

salarié . convention collective . inspection assurance . accord salarial applicable:
  titre: Accord salarial applicable
  description: Le protocole fixe le barème avec effet au 1er janvier 2007 ; il est publié comme texte non étendu.
  applicable si: convention collective = 'inspection assurance'
  valeur: date de calcul >= 01/01/2007

salarié . convention collective . inspection assurance . grille annuelle:
  titre: Rémunération minimale annuelle à temps plein
  description: RMA 2007 des classes 5 à 7, en euros par an, pour les inspecteurs en fonction à la date de signature.
  applicable si: convention collective = 'inspection assurance'
  variations:
    - si: classe = '5'
      alors: 27120
    - si: classe = '6'
      alors: 35800
    - si: classe = '7'
      alors: 49970
    - sinon: 0

salarié . convention collective . inspection assurance . salaire minimum annuel conventionnel:
  titre: Rémunération minimale annuelle conventionnelle
  description: Minimum annuel à temps plein, proratisé selon la quotité ; la comparaison reste annuelle.
  applicable si:
    toutes ces conditions:
      - convention collective = 'inspection assurance'
      - accord salarial applicable = oui
      - grille annuelle > 0 €/an
  unité: €/an
  arrondi: 2 décimales
  valeur: grille annuelle * contrat . temps de travail . quotité

salarié . convention collective . inspection assurance . salaire minimum mensuel indicatif:
  titre: Équivalent mensuel indicatif
  description: Douzième informatif de la RMA annuelle ; il ne remplace pas la comparaison annuelle.
  applicable si: convention collective = 'inspection assurance'
  unité: €/mois
  arrondi: 2 décimales
  valeur: grille annuelle / 12 * contrat . temps de travail . quotité

salarié . convention collective . inspection assurance . classe hors grille:
  titre: Classe absente de la grille
  applicable si: convention collective = 'inspection assurance'
  valeur: grille annuelle = 0 €/an

salarié . convention collective . inspection assurance . audit paie:
  titre: Audit des rubriques de paie
  description: Les textes salariaux consultés ne fixent pas de taux générique salarié/employeur, assiette, plafond, tranche, forfait, santé, prévoyance, formation, AT/MP, prime ou avantage calculable par ce modèle ; ces éléments restent externes.
  applicable si: convention collective = 'inspection assurance'
  valeur: non
