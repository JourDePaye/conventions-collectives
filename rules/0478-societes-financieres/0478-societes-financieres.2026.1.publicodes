validFrom: 2026-06-01
sources:
  - "Accord du 7 mai 2026 relatif aux salaires minima conventionnels, texte officiel Légifrance : https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000054825266"
  - "Convention collective nationale des sociétés financières, IDCC 478, texte officiel Légifrance : https://www.legifrance.gouv.fr/conv_coll/id/KALICONT000005635162"
---
salarié . convention collective . sociétés financières:
  titre: Sociétés financières (IDCC 478)
  valeur: convention collective = 'sociétés financières'

salarié . convention collective . sociétés financières . coefficient:
  titre: Coefficient de classification
  description: Coefficient de 230 à 1000 prévu par la grille de l'accord salarial du 7 mai 2026.
  applicable si: convention collective = 'sociétés financières'
  par défaut: 230

salarié . convention collective . sociétés financières . champ juridique:
  titre: Champ juridique de l'accord salarial
  description: L'accord du 7 mai 2026 est modélisé pour les employeurs signataires ou adhérents. Aucun arrêté d'extension n'est modélisé.
  applicable si: convention collective = 'sociétés financières'
  une possibilité:
    - "'employeur signataire ou adhérent'"
    - "'autre employeur'"
  par défaut: "'employeur signataire ou adhérent'"

salarié . convention collective . sociétés financières . date de calcul:
  titre: Date de vérification du minimum
  applicable si: convention collective = 'sociétés financières'
  par défaut: 01/06/2026

salarié . convention collective . sociétés financières . salaire minimum annuel conventionnel:
  titre: Salaire minimum annuel conventionnel
  description: Salaire minimum annuel, colonne 0 à 3 ans, proratisé selon la quotité de travail.
  applicable si:
    toutes ces conditions:
      - convention collective = 'sociétés financières'
      - calcul bloqué = non
  unité: €/an
  produit:
    - grille annuelle
    - contrat . temps de travail . quotité

salarié . convention collective . sociétés financières . grille annuelle:
  titre: Salaire minimum annuel à temps plein
  description: Grille de l'accord du 7 mai 2026, colonne 0 à 3 ans, applicable à compter du 1er juin 2026 pour les employeurs signataires ou adhérents.
  applicable si:
    toutes ces conditions:
      - convention collective = 'sociétés financières'
      - champ juridique = 'employeur signataire ou adhérent'
      - date de calcul >= 01/06/2026
  unité: €/an
  variations:
    - si: coefficient = 230
      alors: 22381 €/an
    - si: coefficient = 240
      alors: 22474 €/an
    - si: coefficient = 250
      alors: 22567 €/an
    - si: coefficient = 260
      alors: 22660 €/an
    - si: coefficient = 270
      alors: 22753 €/an
    - si: coefficient = 280
      alors: 22846 €/an
    - si: coefficient = 300
      alors: 23032 €/an
    - si: coefficient = 325
      alors: 23264 €/an
    - si: coefficient = 350
      alors: 23496 €/an
    - si: coefficient = 375
      alors: 23728 €/an
    - si: coefficient = 400
      alors: 23960 €/an
    - si: coefficient = 450
      alors: 24424 €/an
    - si: coefficient = 500
      alors: 24888 €/an
    - si: coefficient = 550
      alors: 25352 €/an
    - si: coefficient = 600
      alors: 25816 €/an
    - si: coefficient = 650
      alors: 26280 €/an
    - si: coefficient = 700
      alors: 26744 €/an
    - si: coefficient = 750
      alors: 27208 €/an
    - si: coefficient = 800
      alors: 27672 €/an
    - si: coefficient = 900
      alors: 28600 €/an
    - si: coefficient = 1000
      alors: 30456 €/an
    - sinon: 0 €/an

salarié . convention collective . sociétés financières . coefficient hors grille:
  titre: Coefficient absent de la grille
  description: Le coefficient n'existe pas dans la colonne 0 à 3 ans de l'accord modélisé.
  applicable si: convention collective = 'sociétés financières'
  toutes ces conditions:
    - coefficient != 230
    - coefficient != 240
    - coefficient != 250
    - coefficient != 260
    - coefficient != 270
    - coefficient != 280
    - coefficient != 300
    - coefficient != 325
    - coefficient != 350
    - coefficient != 375
    - coefficient != 400
    - coefficient != 450
    - coefficient != 500
    - coefficient != 550
    - coefficient != 600
    - coefficient != 650
    - coefficient != 700
    - coefficient != 750
    - coefficient != 800
    - coefficient != 900
    - coefficient != 1000

salarié . convention collective . sociétés financières . période hors couverture:
  titre: Date hors période modélisée
  applicable si:
    toutes ces conditions:
      - convention collective = 'sociétés financières'
      - date de calcul < 01/06/2026

salarié . convention collective . sociétés financières . champ hors couverture:
  titre: Employeur hors champ de l'accord
  applicable si:
    toutes ces conditions:
      - convention collective = 'sociétés financières'
      - champ juridique = 'autre employeur'

salarié . convention collective . sociétés financières . calcul bloqué:
  titre: Calcul du minimum bloqué
  applicable si: convention collective = 'sociétés financières'
  une de ces conditions:
    - coefficient hors grille
    - période hors couverture
    - champ hors couverture
