# Convention collective nationale des industries et du commerce de la récupération (IDCC 1589).
# Version 2026.1 : accord du 26 février 2026 relatif aux salaires minima conventionnels, applicable au 1er avril 2026.
validFrom: 2026-04-01
sources:
  - >-
    Accord du 26 février 2026 relatif aux salaires minima conventionnels, Légifrance,
    KALITEXT000054066611.
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000054066611
  - >-
    Article 1 de l'accord du 26 février 2026, grille des salaires minima conventionnels,
    Légifrance, KALIARTI000054066614.
    https://www.legifrance.gouv.fr/conv_coll/article/KALIARTI000054066614
  - >-
    Arrêté du 22 juin 2026 portant extension de l'accord du 26 février 2026, publié au Journal officiel.
---
salarié . convention collective . industries récupération:
  titre: Industries et commerce de la récupération (IDCC 1589)
  valeur: convention collective = 'industries récupération'

salarié . convention collective . industries récupération . niveau:
  titre: Niveau de classification
  description: Niveau 1 à 12 de la grille des salaires minima conventionnels.
  applicable si: convention collective = 'industries récupération'
  par défaut: 1

salarié . convention collective . industries récupération . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Minimum mensuel brut pour 151,67 heures, proratisé selon la quotité de travail.
  applicable si: convention collective = 'industries récupération'
  unité: €/mois
  produit:
    - grille mensuelle
    - contrat . temps de travail . quotité

salarié . convention collective . industries récupération . grille mensuelle:
  titre: Grille mensuelle des salaires minima conventionnels au 1er avril 2026
  applicable si: convention collective = 'industries récupération'
  unité: €/mois
  variations:
    - si: niveau = 1
      alors: 1830 €/mois
    - si: niveau = 2
      alors: 1840 €/mois
    - si: niveau = 3
      alors: 1855 €/mois
    - si: niveau = 4
      alors: 1875 €/mois
    - si: niveau = 5
      alors: 1900 €/mois
    - si: niveau = 6
      alors: 1930 €/mois
    - si: niveau = 7
      alors: 1980 €/mois
    - si: niveau = 8
      alors: 2040 €/mois
    - si: niveau = 9
      alors: 2140 €/mois
    - si: niveau = 10
      alors: 2280 €/mois
    - si: niveau = 11
      alors: 2500 €/mois
    - si: niveau = 12
      alors: 2800 €/mois
    - sinon: 0 €/mois

salarié . convention collective . industries récupération . niveau hors grille:
  titre: Niveau absent de la grille
  applicable si: convention collective = 'industries récupération'
  valeur: grille mensuelle = 0 €/mois
