# Convention collective nationale des sucreries, sucreries-distilleries et raffineries de sucre (IDCC 2728).
# Version 2026.1 : accord du 11 février 2026 relatif aux salaires minima annuels au 1er avril 2026.
validFrom: 2026-04-01
sources:
  - https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000052643609
  - https://www.legifrance.gouv.fr/conv_coll/id/KALICONT000005635183
---
salarié . convention collective . sucreries:
  titre: Sucreries, sucreries-distilleries et raffineries de sucre (IDCC 2728)
  valeur: convention collective = 'sucreries'
salarié . convention collective . sucreries . classe:
  titre: Classe de classification
  description: Classes et groupes de la grille de l'accord salarial. La classe est fournie par l'application et n'est pas déduite de l'intitulé du poste.
  applicable si: convention collective = 'sucreries'
  par défaut: "'non renseigné'"
salarié . convention collective . sucreries . date de calcul:
  titre: Date de calcul
  description: Date à laquelle l'application vérifie l'opposabilité de l'accord salarial.
  applicable si: convention collective = 'sucreries'
  par défaut: 01/01/1900
salarié . convention collective . sucreries . champ juridique:
  titre: Champ juridique de l'accord
  description: Utiliser « employeur signataire ou adhérent » avant l'extension, ou « tous employeurs après extension » à compter du 27 juin 2026, date de publication de l'arrêté d'extension.
  applicable si: convention collective = 'sucreries'
  par défaut: "'non renseigné'"
salarié . convention collective . sucreries . accord applicable:
  applicable si: convention collective = 'sucreries'
  une de ces conditions:
    - toutes ces conditions:
        - champ juridique = 'employeur signataire ou adhérent'
        - date de calcul >= 01/04/2026
    - toutes ces conditions:
        - champ juridique = 'tous employeurs après extension'
        - date de calcul >= 27/06/2026
salarié . convention collective . sucreries . grille annuelle:
  titre: Salaire minimum annuel à temps plein, en euros
  description: Salaires minima annuels bruts de l'accord du 11 février 2026, applicables au 1er avril 2026.
  applicable si: convention collective = 'sucreries'
  unité: €/an
  variations:
    - si: classe = '1A'
      alors: 23005.08 €/an
    - si: classe = '1B'
      alors: 23417.5 €/an
    - si: classe = '2A'
      alors: 23925.49 €/an
    - si: classe = '2B'
      alors: 24536.45 €/an
    - si: classe = '3A'
      alors: 25262.66 €/an
    - si: classe = '3B'
      alors: 26108.63 €/an
    - si: classe = '4A'
      alors: 27083.47 €/an
    - si: classe = '4B'
      alors: 28200.41 €/an
    - si: classe = '5A'
      alors: 29473.9 €/an
    - si: classe = '5B'
      alors: 30921.04 €/an
    - si: classe = '6A'
      alors: 32561.61 €/an
    - si: classe = '6B'
      alors: 34417.91 €/an
    - si: classe = '7A'
      alors: 36516.26 €/an
    - si: classe = '7B'
      alors: 38889.62 €/an
    - si: classe = '8'
      alors: 41572.1 €/an
    - si: classe = '9'
      alors: 49665.63 €/an
    - si: classe = '10'
      alors: 61807.31 €/an
    - sinon: 0 €/an
salarié . convention collective . sucreries . salaire minimum annuel conventionnel:
  titre: Salaire minimum annuel conventionnel
  description: Minimum annuel brut de la classe, exprimé en euros par an. Le modèle ne convertit pas ce minimum annuel en mensualité.
  applicable si:
    toutes ces conditions:
      - convention collective = 'sucreries'
      - accord applicable = oui
      - grille annuelle > 0 €/an
  unité: €/an
  valeur: grille annuelle
