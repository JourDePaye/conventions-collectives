validFrom: 2026-05-29
sources:
  - "Avenant n° 75 du 23 février 2026 relatif aux salaires minima au 1er mars 2026, texte officiel Légifrance : https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000054370576"
  - "Arrêté du 18 mai 2026 portant extension de l'avenant n° 75, publié au Journal officiel du 29 mai 2026 : https://www.legifrance.gouv.fr/jorf/id/JORFTEXT000054149349"
---
salarié . convention collective . sociétés d'expertises et d'évaluations:
  titre: Sociétés d'expertises et d'évaluations (IDCC 915)
  valeur: convention collective = 'sociétés d'expertises et d'évaluations'

salarié . convention collective . sociétés d'expertises et d'évaluations . niveau:
  titre: Niveau de classification
  description: Niveau de la grille des salaires minima conventionnels 2026.
  applicable si: convention collective = 'sociétés d'expertises et d'évaluations'
  par défaut: "'non renseigné'"

salarié . convention collective . sociétés d'expertises et d'évaluations . salaire minimum annuel conventionnel:
  titre: Salaire minimum annuel conventionnel
  description: Minimum annuel brut à temps plein, proratisé selon la quotité de travail.
  applicable si: convention collective = 'sociétés d'expertises et d'évaluations'
  unité: €/an
  produit:
    - grille annuelle
    - contrat . temps de travail . quotité

salarié . convention collective . sociétés d'expertises et d'évaluations . grille annuelle:
  titre: Grille annuelle des salaires minima conventionnels 2026
  description: Grille étendue à compter du 29 mai 2026.
  applicable si: convention collective = 'sociétés d'expertises et d'évaluations'
  unité: €/an
  variations:
    - si: niveau = 'N 1'
      alors: 23831 €/an
    - si: niveau = 'N 2'
      alors: 24158 €/an
    - si: niveau = 'N 3'
      alors: 24463 €/an
    - si: niveau = 'N 4'
      alors: 24989 €/an
    - si: niveau = 'N 5'
      alors: 27039 €/an
    - si: niveau = 'N 6'
      alors: 28990 €/an
    - si: niveau = 'N 7'
      alors: 32215 €/an
    - si: niveau = 'N 8'
      alors: 36365 €/an
    - si: niveau = 'N 9'
      alors: 42801 €/an
    - si: niveau = 'N 10'
      alors: 52943 €/an
    - sinon: 0 €/an

salarié . convention collective . sociétés d'expertises et d'évaluations . niveau hors grille:
  titre: Niveau absent de la grille
  description: Le niveau n'existe pas dans la grille salariale 2026 modélisée.
  applicable si: convention collective = 'sociétés d'expertises et d'évaluations'
  toutes ces conditions:
    - niveau != 'N 1'
    - niveau != 'N 2'
    - niveau != 'N 3'
    - niveau != 'N 4'
    - niveau != 'N 5'
    - niveau != 'N 6'
    - niveau != 'N 7'
    - niveau != 'N 8'
    - niveau != 'N 9'
    - niveau != 'N 10'
