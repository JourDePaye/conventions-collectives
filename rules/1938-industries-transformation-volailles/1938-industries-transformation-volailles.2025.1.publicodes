# Convention collective nationale des industries de la transformation des volailles du 10 juillet 1996 (IDCC 1938).
# Version 2025.1, fusionnée avec modele-social.
# Une version publiée ne se modifie plus : toute évolution passe par une nouvelle version.
#
# Accord du 6 février 2025 relatif aux salaires minima mensuels au 1er février 2025,
# étendu par arrêté du 9 avril 2025 publié au Journal officiel du 26 avril 2025.
validFrom: 2025-02-01
extension: 2025-04-26
sources:
  - Accord du 6 février 2025 relatif aux salaires minima mensuels au 1er février 2025,
    applicable au 1er février 2025, étendu par arrêté du 9 avril 2025 publié au Journal officiel
    du 26 avril 2025 (JORF n° 0099, texte n° 97).
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000051537817
    https://www.legifrance.gouv.fr/jorf/id/JORFTEXT000051521357
---
salarié . convention collective . industries de la transformation des volailles:
  titre: Industries de la transformation des volailles (IDCC 1938)
  valeur: convention collective = 'industries de la transformation des volailles'

salarié . convention collective . industries de la transformation des volailles . coefficient:
  titre: Coefficient de classification
  description: Coefficient de la grille nationale des salaires minima mensuels.
  applicable si: convention collective = 'industries de la transformation des volailles'
  par défaut: 0

salarié . convention collective . industries de la transformation des volailles . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Minimum mensuel brut pour 151,67 heures, proratisé selon la quotité de travail.
  applicable si: convention collective = 'industries de la transformation des volailles'
  unité: €/mois
  produit:
    - grille mensuelle
    - contrat . temps de travail . quotité

