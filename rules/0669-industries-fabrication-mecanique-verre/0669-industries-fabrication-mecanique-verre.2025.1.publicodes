validFrom: 2025-04-01
extension: 2025-07-03
sources:
  - "Accord du 6 mars 2025 relatif aux salaires minima, texte officiel Légifrance : https://www.legifrance.gouv.fr/conv_coll/article/KALIARTI000051947463"
  - "Convention collective nationale des industries de fabrication mécanique du verre du 8 juin 1972, IDCC 669 : https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000051947437"
  - "Arrêté du 1er juillet 2025 portant extension, publié au Journal officiel le 3 juillet 2025, JORFTEXT000051837212 : https://www.legifrance.gouv.fr/jorf/id/JORFTEXT000051837212"
---
salarié . convention collective . industries fabrication mecanique verre:
  titre: Industries de fabrication mécanique du verre (IDCC 669)
  valeur: convention collective = 'industries fabrication mecanique verre'

salarié . convention collective . industries fabrication mecanique verre . coefficient:
  titre: Coefficient hiérarchique
  description: Coefficient de la grille des appointements garantis de l'accord du 6 mars 2025.
  applicable si: convention collective = 'industries fabrication mecanique verre'
  par défaut: 0

salarié . convention collective . industries fabrication mecanique verre . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Appointement mensuel garanti à temps complet, proratisé selon la quotité de travail.
  applicable si: convention collective = 'industries fabrication mecanique verre'
  unité: €/mois
  produit:
    - grille
    - contrat . temps de travail . quotité

salarié . convention collective . industries fabrication mecanique verre . grille:
  titre: Appointement mensuel garanti à temps plein
  description: Les éléments conventionnellement inclus sont le salaire de base, la compensation pour réduction d'horaire et les majorations ayant le caractère de complément de salaire ; les majorations de dimanche, jours fériés, nuit, heures supplémentaires et la prime d'ancienneté sont exclues.
  applicable si: convention collective = 'industries fabrication mecanique verre'
  unité: €/mois
  variations:
    - si: coefficient = 125
      alors: 1801.84 €/mois
    - si: coefficient = 135
      alors: 1823.64 €/mois
    - si: coefficient = 145
      alors: 1843.19 €/mois
    - si: coefficient = 155
      alors: 1860.74 €/mois
    - si: coefficient = 165
      alors: 1880.94 €/mois
    - si: coefficient = 180
      alors: 1901.78 €/mois
    - si: coefficient = 190
      alors: 1922.70 €/mois
    - si: coefficient = 200
      alors: 1945.93 €/mois
    - si: coefficient = 215
      alors: 2023.82 €/mois
    - si: coefficient = 230
      alors: 2100.33 €/mois
    - si: coefficient = 250
      alors: 2252.23 €/mois
    - si: coefficient = 270
      alors: 2409.67 €/mois
    - si: coefficient = 290
      alors: 2567.08 €/mois
    - si: coefficient = 315
      alors: 2723.60 €/mois
    - si: coefficient = 345
      alors: 2956.31 €/mois
    - si: coefficient = 375
      alors: 3189.01 €/mois
    - si: coefficient = 390
      alors: 3272.64 €/mois
    - si: coefficient = 410
      alors: 3426.23 €/mois
    - si: coefficient = 450
      alors: 3733.43 €/mois
    - si: coefficient = 550
      alors: 4501.45 €/mois
