# Convention collective nationale des industries de carrières et matériaux de construction (IDCC 3249).
# Version 2026.2 : accord Île-de-France du 19 mars 2026, applicable au 1er janvier 2026.
# Remplace 2026.1 (même date d'effet) : la grille de 2026.1 inventait un échelon 1.3 et décalait
# toutes les clés suivantes ; le niveau 1 n'a que deux échelons et le niveau 7 en a trois.
validFrom: 2026-01-01
sources:
  - >-
    Île-de-France, accord du 19 mars 2026 relatif aux salaires minimaux au 1er janvier 2026,
    CCN des industries de carrières et matériaux de construction du 6 juillet 2022, container
    KALICONT000050551393, IDCC 3249, KALITEXT000054337807 (étendu par arrêté du 21 mai 2026,
    JORF du 29 mai 2026, BO 2026-16). Article 3 : grille mensuelle des niveaux 1 à 7 (niveau 1 :
    échelons 1 et 2 ; niveaux 2 à 7 : échelons 1 à 3, soit 20 valeurs) ; article 4 : base de
    35 heures par semaine ou 151,67 heures par mois ; article 5 : entrée en vigueur le
    1er janvier 2026 ; article 2 : départements 75, 77, 78, 91, 92, 93, 94, 95 ; article 1er :
    fabrication d'éléments en béton et préfabriqués en béton (code 2361.Z) exclue.
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000054337807/
  - >-
    Arrêté du 21 mai 2026 portant extension de l'accord du 19 mars 2026, publié au Journal
    officiel du 29 mai 2026, NOR TSSD2612437A.
---
salarié . convention collective . carrières et matériaux de construction:
  titre: Industries de carrières et matériaux de construction (IDCC 3249)
  valeur: convention collective = 'carrières et matériaux de construction'

salarié . convention collective . carrières et matériaux de construction . niveau et échelon:
  titre: Niveau et échelon de classification
  description: Niveaux 1 à 7 de la grille ouvriers et ETAM, échelons 1 et 2 pour le niveau 1 et 1 à 3 pour les niveaux 2 à 7 (par exemple 1.2 ou 7.3).
  applicable si: convention collective = 'carrières et matériaux de construction'
  par défaut: "'non renseigné'"

salarié . convention collective . carrières et matériaux de construction . région:
  titre: Région d'emploi
  description: Cette version modélise exclusivement la grille étendue en Île-de-France.
  une possibilité:
    - "'Île-de-France'"
    - "'hors Île-de-France'"
  applicable si: convention collective = 'carrières et matériaux de construction'
  par défaut: "'non renseigné'"

salarié . convention collective . carrières et matériaux de construction . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Minimum mensuel brut à 151,67 heures, proratisé selon la quotité de travail.
  applicable si:
    toutes ces conditions:
      - convention collective = 'carrières et matériaux de construction'
      - région = 'Île-de-France'
  unité: €/mois
  produit:
    - grille Île-de-France
    - contrat . temps de travail . quotité

salarié . convention collective . carrières et matériaux de construction . grille Île-de-France:
  titre: Grille mensuelle Île-de-France 2026 (article 3)
  applicable si:
    toutes ces conditions:
      - convention collective = 'carrières et matériaux de construction'
      - région = 'Île-de-France'
  unité: €/mois
  variations:
    - si: niveau et échelon = '1.1'
      alors: 1840 €/mois
    - si: niveau et échelon = '1.2'
      alors: 1866 €/mois
    - si: niveau et échelon = '2.1'
      alors: 1874 €/mois
    - si: niveau et échelon = '2.2'
      alors: 1903 €/mois
    - si: niveau et échelon = '2.3'
      alors: 1957 €/mois
    - si: niveau et échelon = '3.1'
      alors: 1969 €/mois
    - si: niveau et échelon = '3.2'
      alors: 2000 €/mois
    - si: niveau et échelon = '3.3'
      alors: 2060 €/mois
    - si: niveau et échelon = '4.1'
      alors: 2069 €/mois
    - si: niveau et échelon = '4.2'
      alors: 2104 €/mois
    - si: niveau et échelon = '4.3'
      alors: 2178 €/mois
    - si: niveau et échelon = '5.1'
      alors: 2187 €/mois
    - si: niveau et échelon = '5.2'
      alors: 2252 €/mois
    - si: niveau et échelon = '5.3'
      alors: 2409 €/mois
    - si: niveau et échelon = '6.1'
      alors: 2451 €/mois
    - si: niveau et échelon = '6.2'
      alors: 2546 €/mois
    - si: niveau et échelon = '6.3'
      alors: 2748 €/mois
    - si: niveau et échelon = '7.1'
      alors: 2814 €/mois
    - si: niveau et échelon = '7.2'
      alors: 2975 €/mois
    - si: niveau et échelon = '7.3'
      alors: 3240 €/mois
    - sinon: 0 €/mois

salarié . convention collective . carrières et matériaux de construction . niveau et échelon hors grille:
  titre: Niveau et échelon absent de la grille
  description: Le niveau et l'échelon n'existent pas dans la grille Île-de-France 2026.
  applicable si:
    toutes ces conditions:
      - convention collective = 'carrières et matériaux de construction'
      - région = 'Île-de-France'
  valeur: grille Île-de-France = 0 €/mois
