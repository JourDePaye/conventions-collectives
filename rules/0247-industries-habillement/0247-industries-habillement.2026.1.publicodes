salarié . convention collective . industries habillement . salaire minimum annuel conventionnel:
  titre: Minimum annuel conventionnel des ingénieurs et cadres
  description: Minimum annuel brut 2026 de l’annexe IV, non converti en minimum mensuel.
  applicable si: convention collective = 'industries habillement'
  unité: €/an
  variations:
    - si: niveau = 'IV.3'
      alors: 29310 €/an
    - si: niveau = 'V.1'
      alors: 32766 €/an
    - si: niveau = 'V.2'
      alors: 35953 €/an
    - si: niveau = 'V.3'
      alors: 40477 €/an
    - si: niveau = 'V.4'
      alors: 43157 €/an
    - si: niveau = 'VI.1'
      alors: 46155 €/an
    - si: niveau = 'VI.2'
      alors: 50040 €/an
    - si: niveau = 'VI.3'
      alors: 57263 €/an
    - si: niveau = 'VI.4'
      alors: 66652 €/an
    - sinon: 0 €/an

salarié . convention collective . industries habillement . niveau hors grille:
  titre: Niveau absent de la grille
  applicable si: convention collective = 'industries habillement'
  valeur: minimum mensuel = 0 €/mois
