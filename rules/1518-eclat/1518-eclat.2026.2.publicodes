validFrom: 2026-01-01
sources:
  - >-
    Avenant n° 208 du 23 juin 2025 relatif à la négociation salariale annuelle obligatoire,
    étendu par arrêté du 9 octobre 2025, JORF du 15 octobre 2025.
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000052447622
  - >-
    Annexe I : rémunération, valeurs V1 et V2, formule de salaire et ancienneté.
    https://www.legifrance.gouv.fr/conv_coll/article/KALIARTI000053180432
  - >-
    Annexe I : grille générale de classification.
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000005681230
  - >-
    Avenant n° 209 du 9 juillet 2025 relatif à l'harmonisation des dispositions
    conventionnelles en matière de formation professionnelle et d'apprentissage,
    étendu par arrêté du 26 mars 2026, JORF du 3 avril 2026.
    https://www.legifrance.gouv.fr/conv_coll/article/KALIARTI000052447643
---
salarié . convention collective . éclat:
  titre: ÉCLAT (IDCC 1518)
  valeur: convention collective = 'éclat'
salarié . convention collective . éclat . groupe:
  applicable si: convention collective = 'éclat'
  par défaut: "'non renseigné'"
salarié . convention collective . éclat . coordination habituelle:
  applicable si: convention collective = 'éclat'
  par défaut: non
salarié . convention collective . éclat . points de coordination du groupe C:
  applicable si: convention collective = 'éclat'
  variations:
    - si: coordination habituelle
      alors: 10
    - sinon: 0
salarié . convention collective . éclat . coefficient:
  applicable si: convention collective = 'éclat'
  variations:
    - si: groupe = 'A'
      alors: 257
    - si: groupe = 'B'
      alors: 265
    - si: groupe = 'C'
      alors: 285 + points de coordination du groupe C
    - si: groupe = 'D'
      alors: 305
    - si: groupe = 'E'
      alors: 325
    - si: groupe = 'F'
      alors: 350
    - si: groupe = 'G'
      alors: 375
    - si: groupe = 'H'
      alors: 400
    - si: groupe = 'I'
      alors: 450
    - si: groupe = 'J'
      alors: 500
    - sinon: 0
salarié . convention collective . éclat . salaire minimum conventionnel . grille:
  applicable si: convention collective = 'éclat'
  unité: €/mois
  variations:
    - si: coefficient > 0
      alors: coefficient * 6.81 €/mois + 257 * (7.23 €/mois - 6.81 €/mois)
    - sinon: 0 €/mois
salarié . convention collective . éclat . salaire minimum conventionnel:
  applicable si: convention collective = 'éclat'
  unité: €/mois
  produit:
    - grille
    - contrat . temps de travail . quotité
salarié . convention collective . éclat . groupe hors grille:
  applicable si: convention collective = 'éclat'
  valeur: coefficient = 0
salarié . convention collective . éclat . années complètes d'ancienneté:
  applicable si: convention collective = 'éclat'
  par défaut: 0
salarié . convention collective . éclat . points d'ancienneté:
  applicable si: convention collective = 'éclat'
  valeur: années complètes d'ancienneté * 2
salarié . convention collective . éclat . complément d'ancienneté:
  applicable si: convention collective = 'éclat'
  unité: €/mois
  valeur: points d'ancienneté * 7.23 €/mois * contrat . temps de travail . quotité
salarié . convention collective . éclat . cotisations:
  applicable si: convention collective = 'éclat'
salarié . convention collective . éclat . cotisations . formation professionnelle:
  applicable si: convention collective = 'éclat'
  remplace: salarié . cotisations . formation professionnelle
  produit:
    - cotisations . assiette
    - 2.10%
  description: Contribution totale de formation professionnelle de la branche, légale et conventionnelle comprises.
  références:
    Avenant n° 209 du 9 juillet 2025, article 5 remplaçant l'article 7.1: https://www.legifrance.gouv.fr/conv_coll/article/KALIARTI000052447643
salarié . convention collective . éclat . cotisations . formation dirigeants bénévoles:
  applicable si: convention collective = 'éclat'
  unité: €/mois
  produit:
    - cotisations . assiette
    - 0.05%
  description: Contribution conventionnelle dédiée à la formation des dirigeants bénévoles.
  références:
    Avenant n° 209 du 9 juillet 2025, article 12 remplaçant l'article 7.9: https://www.legifrance.gouv.fr/conv_coll/article/KALIARTI000052447694
