            alors: 34518
          - si: ancienneté >= 10 an
            alors: 33532
          - si: ancienneté >= 5 an
            alors: 32560
          - sinon: 31801
    - si: niveau = 'I'
      alors:
        variations:
          - si: ancienneté >= 20 an
            alors: 43352
