# Convention collective nationale des industries de la maroquinerie, articles de voyage,
# chasse-sellerie, gainerie, bracelets en cuir du 9 septembre 2005
# (IDCC 2528, brochure 3153).
# Version 2026.1 : accord du 18 février 2026, applicable au 1er janvier 2026.
validFrom: 2026-01-01
sources:
  - >-
    Accord du 18 février 2026 relatif aux salaires minima au 1er janvier 2026,
    secteur maroquinerie, ganterie de peau, article 1 et grille 1.2,
    IDCC 2528, publié sur Légifrance.
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000054262272?idConteneur=KALICONT000005635109
  - >-
    Arrêté du 4 mai 2026 portant extension de l'accord du 18 février 2026,
    publié au Journal officiel du 8 mai 2026.
    https://www.legifrance.gouv.fr/jorf/id/JORFTEXT000054048692
  - >-
    Convention collective nationale des industries de la maroquinerie,
    articles de voyage, chasse-sellerie, gainerie, bracelets en cuir du 9 septembre 2005,
    IDCC 2528, publiée sur Légifrance.
    https://www.legifrance.gouv.fr/conv_coll/id/KALICONT000005635109
---
salarié . convention collective . maroquinerie:
  titre: Industries de la maroquinerie (IDCC 2528)
  valeur: convention collective = 'maroquinerie'

salarié . convention collective . maroquinerie . classification:
  titre: Classification conventionnelle
  description: Catégorie et niveau de la grille maroquinerie 2026, par exemple TAM III ou cadre IV.
  applicable si: convention collective = 'maroquinerie'
  par défaut: "'non renseigné'"

salarié . convention collective . maroquinerie . grille:
  titre: Salaire minimum mensuel conventionnel à temps plein
  description: Grille 1.2 de l'accord du 18 février 2026, applicable au 1er janvier 2026.
  applicable si: convention collective = 'maroquinerie'
  unité: €/mois
  variations:
    - si: classification = 'ouvrier I'
      alors: 1867 €/mois
    - si: classification = 'employé I'
      alors: 1867 €/mois
    - si: classification = 'ouvrier II'
      alors: 1888 €/mois
    - si: classification = 'employé II'
      alors: 1888 €/mois
    - si: classification = 'ouvrier III'
      alors: 1899 €/mois
    - si: classification = 'employé III'
      alors: 1899 €/mois
    - si: classification = 'TAM III'
      alors: 1953 €/mois
    - si: classification = 'TAM IV'
      alors: 2124 €/mois
    - si: classification = 'cadre IV'
      alors: 2736 €/mois
    - si: classification = 'TAM V'
      alors: 2262 €/mois
    - si: classification = 'cadre V'
      alors: 3590 €/mois
    - si: classification = 'cadre VI'
      alors: 4130 €/mois
    - sinon: 0 €/mois

salarié . convention collective . maroquinerie . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Minimum mensuel brut à temps plein, proratisé selon la quotité de travail.
  applicable si: convention collective = 'maroquinerie'
  unité: €/mois
  valeur: grille * contrat . temps de travail . quotité

salarié . convention collective . maroquinerie . classification hors grille:
  titre: Classification absente de la grille
  description: La catégorie et le niveau ne figurent pas dans la grille maroquinerie modélisée.
  applicable si: convention collective = 'maroquinerie'
  valeur: grille = 0 €/mois
