# Convention collective nationale des employés, techniciens et cadres des agences de presse
# du 7 avril 2017 (IDCC 3221). Elle a remplacé la convention du 1er juin 1998.
# Version 2026.2 : avenant n° 10 du 1er juin 2026 relatif aux salaires minima.
# L'accord s'applique aux employeurs signataires ou adhérents au 1er juillet 2026,
# puis à tous les employeurs à compter de l'extension publiée le 4 septembre 2026.
validFrom: 2026-07-01
sources:
  - "Avenant n° 10 du 1er juin 2026 relatif aux salaires minima, publié au Bulletin officiel des conventions collectives 2026/26, texte officiel DILA : https://www.legifrance.gouv.fr/download/pdf/bocc?id=boc_20260026_0000_0009.pdf&isForGlobalBocc=false"
  - "Article 6.4 de la convention collective : prime d'ancienneté mensuelle calculée sur le salaire minimum conventionnel garanti ; texte officiel Légifrance : https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000046565704"
  - "Arrêté du 29 août 2026 portant extension de l'avenant n° 10, publié au Journal officiel le 4 septembre 2026, JORFTEXT000054794445."
---
salarié . convention collective . agences de presse:
  titre: Agences de presse (IDCC 3221)
  valeur: convention collective = 'agences de presse'

salarié . convention collective . agences de presse . groupe:
  titre: Groupe de classification
  description: Groupe 1 à 9 de la grille de l'avenant n° 10 relatif aux salaires minima.
  applicable si: convention collective = 'agences de presse'
  par défaut: "'non renseigné'"

salarié . convention collective . agences de presse . date de calcul:
  titre: Date de calcul
  description: Date à laquelle l'application vérifie l'opposabilité de l'avenant salarial.
  applicable si: convention collective = 'agences de presse'
  par défaut: 01/01/1900

salarié . convention collective . agences de presse . champ juridique:
  titre: Champ juridique de l'accord
  description: Utiliser « employeur signataire ou adhérent » avant l'extension, ou « tous employeurs après extension » à compter du 4 septembre 2026.
  applicable si: convention collective = 'agences de presse'
  par défaut: "'non renseigné'"

salarié . convention collective . agences de presse . accord applicable:
  applicable si: convention collective = 'agences de presse'
  une de ces conditions:
    - toutes ces conditions:
        - champ juridique = 'employeur signataire ou adhérent'
        - date de calcul >= 01/07/2026
    - toutes ces conditions:
        - champ juridique = 'tous employeurs après extension'
        - date de calcul >= 04/09/2026

salarié . convention collective . agences de presse . grille:
  titre: Salaire minimum mensuel à temps plein
  description: Grille mensuelle de l'avenant n° 10 du 1er juin 2026, en euros pour 151,67 heures.
  applicable si:
    toutes ces conditions:
      - convention collective = 'agences de presse'
      - accord applicable = oui
  unité: €/mois
  variations:
    - si: groupe = '1'
      alors: 1873.86 €/mois
    - si: groupe = '2'
      alors: 1905.50 €/mois
    - si: groupe = '3'
      alors: 1929.10 €/mois
    - si: groupe = '4'
      alors: 1995.02 €/mois
    - si: groupe = '5'
      alors: 2142.63 €/mois
    - si: groupe = '6'
      alors: 2272.02 €/mois
    - si: groupe = '7'
      alors: 2500.03 €/mois
    - si: groupe = '8'
      alors: 2888.55 €/mois
    - si: groupe = '9'
      alors: 3260.89 €/mois
    - sinon: 0 €/mois

salarié . convention collective . agences de presse . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Salaire minimum mensuel du groupe pour 151,67 heures, proratisé selon la quotité de travail.
  applicable si:
    toutes ces conditions:
      - convention collective = 'agences de presse'
      - accord applicable = oui
      - grille > 0 €/mois
  unité: €/mois
  produit:
    - grille
    - contrat . temps de travail . quotité

salarié . convention collective . agences de presse . groupe hors grille:
  titre: Groupe absent de la grille
  description: Le groupe n'existe pas dans la grille des salaires minima.
  applicable si: convention collective = 'agences de presse'
  valeur: grille = 0 €/mois
