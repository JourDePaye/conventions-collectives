# Convention collective nationale des casinos du 29 mars 2002 (IDCC 2257).
# Version 2025.1 : avenant n° 24 du 29 janvier 2025, étendu le 9 avril 2025, applicable au 1er mai 2025.
validFrom: 2025-05-01
sources:
  - >-
    Avenant n° 24 du 29 janvier 2025 à l'accord du 23 décembre 1996 relatif aux
    rémunérations minimales mensuelles du personnel des jeux traditionnels,
    Légifrance KALITEXT000051447213.
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000051447213
  - >-
    Arrêté du 9 avril 2025 portant extension de l'avenant n° 24, publié au
    Journal officiel du 26 avril 2025 ; l'article 3 fixe l'entrée en vigueur au
    premier jour du mois suivant la publication de l'arrêté d'extension.
  - >-
    Convention collective nationale des casinos du 29 mars 2002, étendue par
    arrêté du 2 avril 2003, conteneur Légifrance KALICONT000005635618.
---
salarié . convention collective . casinos:
  titre: Casinos (IDCC 2257)
  valeur: convention collective = 'casinos'
  description: >-
    Modèle borné à l'avenant n° 24 étendu du personnel des jeux traditionnels.
    Les montants sont des minima mensuels bruts pour un temps complet ; les
    autres filières et les paliers postérieurs au 1er juillet 2025 ne sont pas
    couverts par cette version.

salarié . convention collective . casinos . indice:
  titre: Indice de classification des jeux traditionnels
  question: Quel est l'indice conventionnel ?
  unité: unité
  applicable si: convention collective = 'casinos'
  par défaut: 0

salarié . convention collective . casinos . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Minimum mensuel brut à temps complet, proratisé selon la quotité de travail.
  unité: €/mois
  applicable si: convention collective = 'casinos'
  produit:
    - grille
    - contrat . temps de travail . quotité

salarié . convention collective . casinos . grille:
  titre: Salaire minimum mensuel à temps complet
  unité: €/mois
  variations:
    - si: indice = 100
      alors: 1818 €/mois
    - si: indice = 105
      alors: 1829 €/mois
    - si: indice = 110
      alors: 1839 €/mois
    - si: indice = 120
      alors: 1864 €/mois
    - si: indice = 130
      alors: 1879 €/mois
    - si: indice = 140
      alors: 1991 €/mois
    - si: indice = 150
      alors: 2133 €/mois
    - si: indice = 160
      alors: 2276 €/mois
    - si: indice = 170
      alors: 2418 €/mois
    - si: indice = 175
      alors: 2516 €/mois
    - si: indice = 180
      alors: 2578 €/mois
    - si: indice = 190
      alors: 2713 €/mois
    - si: indice = 200
      alors: 2878 €/mois
    - sinon: 0 €/mois

salarié . convention collective . casinos . indice hors grille:
  titre: Indice absent de la grille modélisée
  applicable si: convention collective = 'casinos'
  toutes ces conditions:
    - indice != 100
    - indice != 105
    - indice != 110
    - indice != 120
    - indice != 130
    - indice != 140
    - indice != 150
    - indice != 160
    - indice != 170
    - indice != 175
    - indice != 180
    - indice != 190
    - indice != 200

salarié . convention collective . casinos . audit paie:
  titre: Audit explicite des rubriques conventionnelles de paie
  description: >-
    Les textes de la convention, l'avenant salarial dédié et son arrêté
    d'extension ont été recherchés pour les taux de cotisations salarié et
    employeur, assiettes, plafonds, tranches, forfaits, santé, prévoyance,
    retraite complémentaire et supplémentaire, formation, AT/MP, primes,
    indemnités, avantages en nature et frais professionnels. Aucun changement
    conventionnel calculable et suffisamment déterminé n'a été trouvé pour ces
    rubriques dans les sources examinées ; aucun taux, base, plafond, tranche,
    forfait, exonération, prime, avantage ou frais n'est inventé ou mis à zéro.
    Seuls les minima mensuels du personnel des jeux traditionnels sont calculés.
  applicable si: convention collective = 'casinos'
  valeur: oui
