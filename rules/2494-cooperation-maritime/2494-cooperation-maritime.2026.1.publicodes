# Convention collective nationale de la coopération maritime du 7 décembre 2004
# (IDCC 2494, brochure 3326).
# Version 2026.1 : accord du 31 mars 2026 relatif aux salaires minima
# conventionnels au 1er avril 2026, étendu par arrêté du 11 juin 2026 (JORF du 27 juin 2026).
validFrom: 2026-07-01
sources:
  - >-
    Accord du 31 mars 2026 relatif aux salaires minima conventionnels au 1er avril 2026,
    texte publié dans la convention collective IDCC 2494 sur Légifrance.
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000054426738 (conteneur KALICONT000018563634, BO 2026-18).
  - >-
    Arrêté du 11 juin 2026 portant extension d'un accord conclu dans le cadre de la
    convention collective nationale de la coopération maritime, publié au JORF du 27 juin 2026.
    https://www.legifrance.gouv.fr/conv_coll/id/KALICONT000018563634
---
salarié . convention collective . coopération maritime:
  titre: Coopération maritime (IDCC 2494)
  valeur: convention collective = 'coopération maritime'

salarié . convention collective . coopération maritime . niveau et échelon:
  titre: Niveau et échelon de classification
  description: |
    Niveau et échelon de la grille des salaires minima annuels : niveaux 1 à 3 avec
    échelons, niveaux 4 et 5 pour les agents de maîtrise, et niveaux 6 à 9 pour les cadres.
  applicable si: convention collective = 'coopération maritime'
  par défaut: "'non renseigné'"

salarié . convention collective . coopération maritime . ancienneté cadre:
  titre: Ancienneté dans la fonction pour les cadres
  description: Pour les niveaux 6 et 7, choisir A avant trois ans ou B à partir de trois ans.
  applicable si: convention collective = 'coopération maritime'
  par défaut: "'non renseigné'"

salarié . convention collective . coopération maritime . grille annuelle:
  titre: Salaire minimum annuel conventionnel à temps plein
  description: Grille de l'accord du 31 mars 2026, en euros bruts annuels pour 35 heures hebdomadaires.
  applicable si: convention collective = 'coopération maritime'
  unité: €/an
  variations:
    - si: niveau et échelon = '1.1'
      alors: 21876.36 €/an
    - si: niveau et échelon = '1.2'
      alors: 22327 €/an
    - si: niveau et échelon = '2.1'
      alors: 22527 €/an
    - si: niveau et échelon = '2.2'
      alors: 23965 €/an
    - si: niveau et échelon = '3.1'
      alors: 24961 €/an
    - si: niveau et échelon = '3.2'
      alors: 26273 €/an
    - si: niveau et échelon = '3.3'
      alors: 27251 €/an
    - si: niveau et échelon = '4'
      alors: 28174 €/an
    - si: niveau et échelon = '5'
      alors: 32704 €/an
    - si: niveau et échelon = '6.A'
      alors: 34358 €/an
    - si: niveau et échelon = '6.B'
      alors: 38275 €/an
    - si: niveau et échelon = '7.A'
      alors: 36220 €/an
    - si: niveau et échelon = '7.B'
      alors: 42101 €/an
    - si: niveau et échelon = '8'
      alors: 46779 €/an
    - si: niveau et échelon = '9'
      alors: 53161 €/an
    - sinon: 0 €/an

salarié . convention collective . coopération maritime . salaire minimum annuel conventionnel:
  titre: Salaire minimum annuel conventionnel
  description: Minimum annuel brut, proratisé selon la quotité de travail. La comparaison juridique doit rester annuelle.
  applicable si: convention collective = 'coopération maritime'
  unité: €/an
  valeur: grille annuelle * contrat . temps de travail . quotité

salarié . convention collective . coopération maritime . niveau hors grille:
  titre: Classification absente de la grille
  description: Le niveau et l'échelon ne figurent pas dans le barème modélisé.
  applicable si: convention collective = 'coopération maritime'
  valeur: grille annuelle = 0 €/an
