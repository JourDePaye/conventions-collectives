# Convention collective nationale de l'industrie pharmaceutique (IDCC 176).
# Version 2026.1 : accord du 13 novembre 2025 relatif aux salaires minima conventionnels au 1er janvier 2026.
validFrom: 2026-01-01
sources:
  - https://www.legifrance.gouv.fr/conv_coll/id/KALIARTI000053721382
  - https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000053721378
---
salarié . convention collective . industrie pharmaceutique:
  titre: Industrie pharmaceutique (IDCC 176)
  valeur: convention collective = 'industrie pharmaceutique'
salarié . convention collective . industrie pharmaceutique . groupe:
  titre: Groupe et niveau de classification
  description: Groupe et niveau de classification fourni par l'application, de 1A/1B à 11.
  applicable si: convention collective = 'industrie pharmaceutique'
  par défaut: "'non renseigné'"
salarié . convention collective . industrie pharmaceutique . salaire minimum de la grille:
  titre: Salaire minimum conventionnel pour 151,67 heures
  unité: €/mois
  applicable si: convention collective = 'industrie pharmaceutique'
  variations:
    - si: groupe = '1A'
      alors: 1837.34 €/mois
    - si: groupe = '1B'
      alors: 1837.34 €/mois
    - si: groupe = '1C'
      alors: 1856.06 €/mois
    - si: groupe = '2A'
      alors: 1856.06 €/mois
    - si: groupe = '2B'
      alors: 1893.51 €/mois
    - si: groupe = '2C'
      alors: 1977.76 €/mois
    - si: groupe = '3A'
      alors: 1977.76 €/mois
    - si: groupe = '3B'
      alors: 2024.57 €/mois
    - si: groupe = '3C'
      alors: 2193.07 €/mois
    - si: groupe = '4A'
      alors: 2193.07 €/mois
    - si: groupe = '4B'
      alors: 2267.96 €/mois
    - si: groupe = '4C'
      alors: 2483.27 €/mois
    - si: groupe = '5A'
      alors: 2483.27 €/mois
    - si: groupe = '5B'
      alors: 2586.24 €/mois
    - si: groupe = '5C'
      alors: 2867.08 €/mois
    - si: groupe = '6A'
      alors: 2867.08 €/mois
    - si: groupe = '6B'
      alors: 2998.14 €/mois
    - si: groupe = '6C'
      alors: 3344.51 €/mois
    - si: groupe = '7A'
      alors: 3475.57 €/mois
    - si: groupe = '7B'
      alors: 4065.33 €/mois
    - si: groupe = '8A'
      alors: 4196.39 €/mois
    - si: groupe = '8B'
      alors: 4898.49 €/mois
    - si: groupe = '9A'
      alors: 5029.55 €/mois
    - si: groupe = '9B'
      alors: 5862.70 €/mois
    - si: groupe = '10'
      alors: 6386.93 €/mois
    - si: groupe = '11'
      alors: 6911.17 €/mois
    - sinon: 0 €/mois
salarié . convention collective . industrie pharmaceutique . groupe hors grille:
  applicable si: convention collective = 'industrie pharmaceutique'
  valeur: salaire minimum de la grille = 0 €/mois
salarié . convention collective . industrie pharmaceutique . salaire minimum conventionnel:
  titre: Salaire minimum conventionnel
  description: Minimum mensuel pour 151,67 heures, proratisé selon la quotité de travail. La convention fixe les minima à partir du 1er janvier 2026.
  applicable si:
    toutes ces conditions:
      - convention collective = 'industrie pharmaceutique'
      - groupe hors grille = non
  unité: €/mois
  valeur: salaire minimum de la grille * contrat . temps de travail . quotité
