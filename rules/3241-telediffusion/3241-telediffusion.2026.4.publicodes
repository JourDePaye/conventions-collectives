# Convention collective nationale de la télédiffusion du 2 juillet 2021 (IDCC 3241).
# Version 2026.4: the rules of 2026.2 (daily minimums of the CDDU, list 1) and the monthly minimums
# of the permanent employees (articles 22.1 and 22.2) of the accord of 11 May 2026, from 1 June 2026
# for the employers of a signatory organisation, and from the publication of its extension order
# (JORF of 24 July 2026) for the others.
validFrom: 2026-06-01
extension: 2026-07-24
sources:
  - >-
    Accord du 11 mai 2026 relatif aux salaires minima des salariés employés sous CDDU,
    NOR ASET2650556M, BOCC 2026-23, applicable à compter du 1er juin 2026.
  - >-
    Barème officiel des minima journaliers bruts (8 heures), liste 1 : niveaux 1 à 7-2, colonnes M1
    et M2 ; le niveau 8 est de gré à gré, avec un plancher égal au M1 du niveau 7-2.
  - >-
    Convention collective nationale de la télédiffusion du 2 juillet 2021, KALITEXT000044226308 :
    article 21.2.2, niveaux I à V et échelons A, B et C, niveau VI sans échelon ; articles 22.1 et
    22.2, grilles selon l'effectif et l'appartenance à un groupe.
  - >-
    Accord du 11 mai 2026 relatif aux salaires minima, KALITEXT000054880861 (NOR ASET2650557M,
    BOCC 2026-23), étendu par arrêté du 15 juillet 2026 (JORF du 24 juillet 2026) : article 4,
    revalorisation à compter du 1er juin 2026 ; annexe 1, salaires minima mensuels de moins et de
    plus de 50 salariés.
---
salarié . convention collective . télédiffusion . classification:
  titre: Niveau et échelon des salariés permanents
  description: >-
    Niveau I à V et échelon A, B ou C (article 21.2.2 de la CCN), écrits « I-A » à « V-C », ou
    niveau VI, sans échelon (postes de direction).
  applicable si: convention collective = 'télédiffusion'
  par défaut: "'non renseigné'"

salarié . convention collective . télédiffusion . entreprise d'un groupe:
  titre: Entreprise d'un groupe de plus de 50 salariés
  description: >-
    L'entreprise appartient à un groupe de sociétés au sens de l'article L. 233-1 du code de
    commerce comprenant lui-même plus de 50 salariés (article 22.2 de la CCN).
  applicable si: convention collective = 'télédiffusion'
  par défaut: non

salarié . convention collective . télédiffusion . grille des entreprises de 50 salariés et plus:
  titre: Grille de l'article 22.2
  description: >-
    L'entreprise compte au moins 50 salariés ou appartient à un groupe de plus de 50 salariés
    (article 22.2) ; sinon la grille de l'article 22.1 s'applique.
  applicable si: convention collective = 'télédiffusion'
  une de ces conditions:
    - entreprise . salariés . effectif >= 50
    - entreprise d'un groupe

salarié . convention collective . télédiffusion . salaire minimum mensuel:
  titre: Salaire minimum mensuel des salariés permanents, à temps plein
  description: >-
    Minimum conventionnel mensuel brut pour 35 heures du niveau et de l'échelon (articles 22.1 et
    22.2) ; 0 pour une classification absente de la grille.
  applicable si: convention collective = 'télédiffusion'
  unité: €/mois
  variations:
    - si: grille des entreprises de 50 salariés et plus
      alors:
        variations:
          - si: classification = 'I-A'
            alors: 1870.00 €/mois
          - si: classification = 'I-B'
            alors: 1875.00 €/mois
          - si: classification = 'I-C'
            alors: 1920.00 €/mois
          - si: classification = 'II-A'
            alors: 2018.60 €/mois
          - si: classification = 'II-B'
            alors: 2133.95 €/mois
          - si: classification = 'II-C'
            alors: 2244.05 €/mois
          - si: classification = 'III-A'
            alors: 2291.24 €/mois
          - si: classification = 'III-B'
            alors: 2343.67 €/mois
          - si: classification = 'III-C'
            alors: 2401.35 €/mois
          - si: classification = 'IV-A'
            alors: 2485.24 €/mois
          - si: classification = 'IV-B'
            alors: 2595.34 €/mois
          - si: classification = 'IV-C'
            alors: 2700.20 €/mois
          - si: classification = 'V-A'
            alors: 3135.38 €/mois
          - si: classification = 'V-B'
            alors: 3455.21 €/mois
          - si: classification = 'V-C'
            alors: 3890.39 €/mois
          - si: classification = 'VI'
            alors: 4320.32 €/mois
          - sinon: 0 €/mois
    - sinon:
        variations:
          - si: classification = 'I-A'
            alors: 1870.00 €/mois
          - si: classification = 'I-B'
            alors: 1875.00 €/mois
          - si: classification = 'I-C'
            alors: 1880.00 €/mois
          - si: classification = 'II-A'
            alors: 1890.00 €/mois
          - si: classification = 'II-B'
            alors: 1908.49 €/mois
          - si: classification = 'II-C'
            alors: 1929.47 €/mois
          - si: classification = 'III-A'
            alors: 1966.17 €/mois
          - si: classification = 'III-B'
            alors: 2018.60 €/mois
          - si: classification = 'III-C'
            alors: 2071.03 €/mois
          - si: classification = 'IV-A'
            alors: 2291.24 €/mois
          - si: classification = 'IV-B'
            alors: 2375.13 €/mois
          - si: classification = 'IV-C'
            alors: 2485.24 €/mois
          - si: classification = 'V-A'
            alors: 3077.71 €/mois
          - si: classification = 'V-B'
            alors: 3292.67 €/mois
          - si: classification = 'V-C'
            alors: 3512.89 €/mois
          - si: classification = 'VI'
            alors: 3780.28 €/mois
          - sinon: 0 €/mois

salarié . convention collective . télédiffusion . salaire minimum conventionnel:
  titre: Salaire minimum conventionnel des salariés permanents
  description: Minimum mensuel du niveau et de l'échelon, proratisé selon la quotité de travail.
  applicable si: convention collective = 'télédiffusion'
  unité: €/mois
  produit:
    - salaire minimum mensuel
    - contrat . temps de travail . quotité

salarié . convention collective . télédiffusion . classification hors grille:
  titre: Classification absente de la grille des salariés permanents
  applicable si: convention collective = 'télédiffusion'
  valeur: salaire minimum mensuel = 0 €/mois

salarié . convention collective . télédiffusion:
  titre: Télédiffusion (IDCC 3241)
  valeur: convention collective = 'télédiffusion'

salarié . convention collective . télédiffusion . niveau:
  titre: Niveau CDDU
  description: Niveau de la liste 1 du barème des minima journaliers CDDU applicable au 1er juin 2026.
  applicable si: convention collective = 'télédiffusion'
  par défaut: "'non renseigné'"

salarié . convention collective . télédiffusion . minimum:
  titre: Colonne du barème CDDU
  description: Colonne M1 ou M2 du barème des minima journaliers CDDU, selon la fonction exercée.
  applicable si: convention collective = 'télédiffusion'
  par défaut: "'M1'"

salarié . convention collective . télédiffusion . salaire minimum journalier:
  titre: Salaire minimum journalier CDDU
  description: Minimum brut pour une journée de 8 heures selon la liste 1 et la colonne du barème salarial.
  applicable si: convention collective = 'télédiffusion'
  unité: €/jour
  valeur: grille

salarié . convention collective . télédiffusion . grille:
  titre: Grille des minima journaliers CDDU, liste 1
  unité: €/jour
  variations:
    - si: minimum = 'M2'
      alors:
        variations:
          - si: niveau = '1'
            alors: 125.82 €/jour
          - si: niveau = '2'
            alors: 145.63 €/jour
          - si: niveau = '3'
            alors: 158.85 €/jour
          - si: niveau = '4-1'
            alors: 170.43 €/jour
          - si: niveau = '4-2'
            alors: 176.71 €/jour
          - si: niveau = '5-1'
            alors: 189.16 €/jour
          - si: niveau = '5-2'
            alors: 202.70 €/jour
          - si: niveau = '5-3'
            alors: 207.89 €/jour
          - si: niveau = '6-1'
            alors: 215.27 €/jour
          - si: niveau = '6-2'
            alors: 223.49 €/jour
          - si: niveau = '7-1'
            alors: 234.82 €/jour
          - si: niveau = '7-2'
            alors: 298.58 €/jour
          - sinon: 0 €/jour
    - si: niveau = '1'
      alors: 119.83 €/jour
    - si: niveau = '2'
      alors: 138.68 €/jour
    - si: niveau = '3'
      alors: 151.30 €/jour
    - si: niveau = '4-1'
      alors: 162.32 €/jour
    - si: niveau = '4-2'
      alors: 168.30 €/jour
    - si: niveau = '5-1'
      alors: 180.16 €/jour
    - si: niveau = '5-2'
      alors: 193.05 €/jour
    - si: niveau = '5-3'
      alors: 198 €/jour
    - si: niveau = '6-1'
      alors: 205.01 €/jour
    - si: niveau = '6-2'
      alors: 212.83 €/jour
    - si: niveau = '7-1'
      alors: 223.65 €/jour
    - si: niveau = '7-2'
      alors: 284.38 €/jour
    - si: niveau = '8'
      alors: 284.38 €/jour
    - sinon: 0 €/jour

salarié . convention collective . télédiffusion . niveau hors grille:
  titre: Niveau absent de la grille CDDU
  description: Le niveau 8 est de gré à gré, avec un plancher égal au M1 du niveau 7-2.
  applicable si: convention collective = 'télédiffusion'
  valeur: niveau = '8'
