# Convention collective nationale de l'industrie textile du 1er février 1951 (IDCC 18,
# brochure 3106).
#
# Version 2026.3, fusionnée avec modele-social par @jourdepaye/payroll-core.
# Une version publiée ne se modifie plus (voir versions.lock.json) : toute évolution ou
# correction passe par une nouvelle version.
#
# Premier document : métadonnées de la version. Second document : règles publicodes, en
# français comme dans modele-social.

# Date d'application de l'accord du 17 juin 2026 pour l'industrie textile (grille de la
# version 2026.1, inchangée) ; le secteur des textiles artificiels et synthétiques garde le
# barème de l'accord du 12 janvier 2026. Extension : publication de l'arrêté qui étend
# l'accord du 17 juin 2026 (JORF du 4 septembre 2026).
validFrom: 2026-06-01
extension: 2026-09-04
sources:
  - >-
    Accord national du 17 juin 2026 relatif aux salaires minima (grille des 21 positions des
    niveaux 1 à 6 en échelons et des positions I à IV, montants mensuels bruts), applicable à
    compter du 1er juin 2026, étendu par arrêté du 24 août 2026 (JORF n° 0206 du 4 septembre
    2026, JORFTEXT000054794573, NOR TRST2621209A). Grille reprise de la version 2026.1, dont
    les montants viennent de deux pages de synthèse concordantes (juristique.org et
    salaire-minimum.com) : le texte de l'accord n'est ni dans KALI ni dans les BOCC en ligne
    (jusqu'au 2026/30), à vérifier dès sa publication.
  - >-
    Accord du 12 janvier 2026 relatif aux salaires minima (secteur des textiles artificiels et
    synthétiques et produits assimilés), applicable au 1er janvier 2026, BO 2026-7 : barème
    mensuel des 21 coefficients de 210 à 800, base de 152,19 heures pour 35 heures par semaine
    (article 1er). Les classifications de la convention du 6 juin 1996 sont maintenues jusqu'au
    31 décembre 2026. Étendu par arrêté du 17 mars 2026 (JORF du 19 mars 2026,
    JORFTEXT000053701332). https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000053973002
  - >-
    L'accord du 15 juillet 2026 relatif aux salaires minima du secteur des textiles artificiels
    et synthétiques, étendu par arrêté publié au JORF du 30 septembre 2026
    (JORFTEXT000054914182), n'est pas modélisé : son texte n'est pas encore publié.
---
salarié . convention collective . industries textiles:
  titre: Industries textiles (IDCC 18)
  valeur: convention collective = 'industries textiles'

salarié . convention collective . industries textiles . secteur:
  titre: Secteur de la grille
  description: |
    « industrie textile » (barème de la convention du 1er février 1951) ou « textiles
    artificiels et synthétiques » (entreprises qui relevaient de la convention du 6 juin 1996,
    dont les classifications sont maintenues jusqu'au 31 décembre 2026).
  applicable si: convention collective = 'industries textiles'
  par défaut: "'industrie textile'"

salarié . convention collective . industries textiles . niveau:
  titre: Niveau et échelon, ou coefficient
  description: |
    Industrie textile : niveau 1 (1), niveaux 2 à 6 avec leur échelon de 1 à 3 (2.1 à 6.3),
    position I avec son échelon de 1 ou 2 (I.1, I.2), positions II, III et IV (II, III, IV).
    Textiles artificiels et synthétiques : coefficient de 210 à 800 (210, 225… 450, 500, 600,
    700, 800).
  applicable si: convention collective = 'industries textiles'
  par défaut: "'non renseigné'"

salarié . convention collective . industries textiles . salaire minimum conventionnel:
  titre: Salaire minimum mensuel garanti
  description: |
    Salaire mensuel minimum du niveau ou du coefficient pour 35 heures par semaine, proratisé
    pour un temps partiel. Vaut 0 €/mois si la classification n'existe pas dans la grille du
    secteur (voir « niveau hors grille »).
  applicable si: convention collective = 'industries textiles'
  unité: €/mois
  produit:
    - grille
    - contrat . temps de travail . quotité

salarié . convention collective . industries textiles . salaire minimum conventionnel . grille:
  titre: Salaire mensuel minimum à temps plein
  unité: €/mois
  variations:
    - si: secteur = 'textiles artificiels et synthétiques'
      alors: textiles artificiels
    - sinon: industrie textile

salarié . convention collective . industries textiles . salaire minimum conventionnel . grille . industrie textile:
  titre: Grille de l'industrie textile
  description: |
    Grille de l'accord du 17 juin 2026, de 1 898 € (niveau 1) à 5 029 € (position IV).
  unité: €/mois
  variations:
    - si: niveau = '1'
      alors: 1898 €/mois
    - si: niveau = '2.1'
      alors: 1901 €/mois
    - si: niveau = '2.2'
      alors: 1906 €/mois
    - si: niveau = '2.3'
      alors: 1915 €/mois
    - si: niveau = '3.1'
      alors: 1916 €/mois
    - si: niveau = '3.2'
      alors: 1920 €/mois
    - si: niveau = '3.3'
      alors: 1931 €/mois
    - si: niveau = '4.1'
      alors: 1933 €/mois
    - si: niveau = '4.2'
      alors: 1996 €/mois
    - si: niveau = '4.3'
      alors: 2080 €/mois
    - si: niveau = '5.1'
      alors: 2087 €/mois
    - si: niveau = '5.2'
      alors: 2143 €/mois
    - si: niveau = '5.3'
      alors: 2293 €/mois
    - si: niveau = '6.1'
      alors: 2304 €/mois
    - si: niveau = '6.2'
      alors: 2420 €/mois
    - si: niveau = '6.3'
      alors: 2615 €/mois
    - si: niveau = 'I.1'
      alors: 2620 €/mois
    - si: niveau = 'I.2'
      alors: 2923 €/mois
    - si: niveau = 'II'
      alors: 3527 €/mois
    - si: niveau = 'III'
      alors: 4280 €/mois
    - si: niveau = 'IV'
      alors: 5029 €/mois
    - sinon: 0 €/mois

salarié . convention collective . industries textiles . salaire minimum conventionnel . grille . textiles artificiels:
  titre: Grille des textiles artificiels et synthétiques
  description: |
    Barème de l'accord du 12 janvier 2026, de 1 857 € (coefficient 210) à 6 780 €
    (coefficient 800).
  unité: €/mois
  variations:
    - si: niveau = '210'
      alors: 1857 €/mois
    - si: niveau = '225'
      alors: 1863 €/mois
    - si: niveau = '240'
      alors: 1868 €/mois
    - si: niveau = '255'
      alors: 1878 €/mois
    - si: niveau = '270'
      alors: 1888 €/mois
    - si: niveau = '285'
      alors: 1900 €/mois
    - si: niveau = '300'
      alors: 1912 €/mois
    - si: niveau = '315'
      alors: 1922 €/mois
    - si: niveau = '330'
      alors: 1932 €/mois
    - si: niveau = '345'
      alors: 2034 €/mois
    - si: niveau = '360'
      alors: 2170 €/mois
    - si: niveau = '375'
      alors: 2305 €/mois
    - si: niveau = '390'
      alors: 2437 €/mois
    - si: niveau = '405'
      alors: 2626 €/mois
    - si: niveau = '420'
      alors: 2765 €/mois
    - si: niveau = '435'
      alors: 2955 €/mois
    - si: niveau = '450'
      alors: 3145 €/mois
