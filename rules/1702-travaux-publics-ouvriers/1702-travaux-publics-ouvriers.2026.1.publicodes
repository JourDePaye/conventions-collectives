---
salarié . convention collective . travaux publics ouvriers:
  titre: Travaux publics — ouvriers (IDCC 1702)
  valeur: convention collective = 'travaux publics ouvriers'
salarié . convention collective . travaux publics ouvriers . catégorie:
  applicable si: convention collective = 'travaux publics ouvriers'
  par défaut: "'non renseignée'"
salarié . convention collective . travaux publics ouvriers . région:
  applicable si: convention collective = 'travaux publics ouvriers'
  par défaut: "'non renseignée'"
salarié . convention collective . travaux publics ouvriers . coefficient:
  applicable si: convention collective = 'travaux publics ouvriers'
  par défaut: 0
salarié . convention collective . travaux publics ouvriers . date de calcul:
  applicable si: convention collective = 'travaux publics ouvriers'
  par défaut: 01/01/1900
salarié . convention collective . travaux publics ouvriers . grille annuelle:
  applicable si:
    toutes ces conditions:
      - convention collective = 'travaux publics ouvriers'
      - calcul bloqué = non
  unité: €/an
  variations:
    - si: région = 'Bretagne'
      alors:
        variations:
          - si: coefficient = 100
            alors: 23863 €/an
          - si: coefficient = 110
            alors: 24133 €/an
          - si: coefficient = 125
            alors: 24621 €/an
          - si: coefficient = 140
            alors: 27126 €/an
          - si: coefficient = 150
            alors: 29020 €/an
          - si: coefficient = 165
            alors: 31711 €/an
          - si: coefficient = 180
            alors: 34529 €/an
          - sinon: 0 €/an
    - si: région = 'Nouvelle-Aquitaine'
      alors:
