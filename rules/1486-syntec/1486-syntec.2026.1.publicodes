# Convention collective nationale des bureaux d'études techniques, des cabinets
# d'ingénieurs-conseils et des sociétés de conseils (Syntec, IDCC 1486).
#
# Version 2026.1, fusionnée avec modele-social.
# Une version publiée ne se modifie plus : toute évolution ou correction passe par une nouvelle version.

validFrom: 2026-01-01
sources:
  - "Accord du 26 juin 2024 sur les salaires minimaux, étendu par arrêté du 8 novembre 2024 (JORF du 27 novembre 2024), applicable au 1er janvier 2025."
  - "Accord du 31 octobre 2019 relatif à la formation professionnelle, modifié par avenant n° 3 du 27 octobre 2022 et étendu par arrêté du 31 mars 2023 (JORF du 13 avril 2023) : contribution conventionnelle de 0,05 % pour les entreprises de moins de 50 salariés et de 0,10 % à partir de 50 salariés, avec un minimum annuel de 25 € par entreprise."
  - "Avenant n° 8 du 16 décembre 2025 relatif au régime de prévoyance lourde, étendu par arrêté du 21 mai 2026 (JORF du 5 juin 2026) : taux globaux du régime de branche applicables aux entreprises adhérentes à compter du 1er juillet 2026. La répartition employeur/salarié et l'adhésion au contrat ne sont pas modélisées."
---
salarié . convention collective . syntec:
  titre: Bureaux d'études techniques (Syntec, IDCC 1486)
  valeur: convention collective = 'syntec'

salarié . convention collective . syntec . coefficient:
  titre: Coefficient de classification Syntec
  description: |
    ETAM : 240 (1.1), 250 (1.2), 275 (2.1), 310 (2.2), 355 (2.3), 400 (3.1), 450 (3.2),
    500 (3.3). Ingénieurs et cadres : 95 (1.1), 100 (1.2), 105 (2.1, moins de 26 ans),
    115 (2.1, 26 ans et plus), 130 (2.2), 150 (2.3), 170 (3.1), 210 (3.2), 270 (3.3).
  applicable si: convention collective = 'syntec'
  par défaut: 0

salarié . convention collective . syntec . salaire minimum conventionnel:
  titre: Salaire minimum conventionnel Syntec
  description: Salaire mensuel brut minimum pour un temps plein, selon la catégorie et le coefficient.
  applicable si: convention collective = 'syntec'
  unité: €/mois
  variations:
    - si: contrat . statut cadre
      alors: grille ingénieurs et cadres
    - sinon: grille ETAM

salarié . convention collective . syntec . salaire minimum conventionnel . grille ETAM:
  unité: €/mois
  variations:
    - si: coefficient = 240
      alors: 1815 €/mois
    - si: coefficient = 250
      alors: 1845 €/mois
    - si: coefficient = 275
      alors: 1875 €/mois
    - si: coefficient = 310
      alors: 1905 €/mois
    - si: coefficient = 355
      alors: 2045 €/mois
    - si: coefficient = 400
      alors: 2185 €/mois
    - si: coefficient = 450
      alors: 2340 €/mois
    - si: coefficient = 500
      alors: 2490 €/mois
    - sinon: 0 €/mois

salarié . convention collective . syntec . salaire minimum conventionnel . grille ingénieurs et cadres:
  unité: €/mois
  variations:
    - si: coefficient = 95
      alors: 2135 €/mois
    - si: coefficient = 100
      alors: 2240 €/mois
    - si: coefficient = 105
      alors: 2315 €/mois
    - si: coefficient = 115
      alors: 2530 €/mois
    - si: coefficient = 130
      alors: 2850 €/mois
    - si: coefficient = 150
      alors: 3275 €/mois
    - si: coefficient = 170
      alors: 3650 €/mois
    - si: coefficient = 210
      alors: 4495 €/mois
    - si: coefficient = 270
      alors: 5755 €/mois
    - sinon: 0 €/mois

salarié . convention collective . syntec . coefficient hors grille:
  titre: Coefficient absent de la grille Syntec
  description: Le coefficient n'existe pas dans la grille de la catégorie du salarié.
  applicable si: convention collective = 'syntec'
  valeur: salaire minimum conventionnel = 0 €/mois

salarié . convention collective . syntec . cotisations:
  applicable si: convention collective = 'syntec'
  valeur: oui

salarié . convention collective . syntec . cotisations . formation professionnelle:
  applicable si: convention collective = 'syntec'
  remplace: salarié . cotisations . formation professionnelle
  produit:
    - cotisations . assiette
    - variations:
        - si: entreprise . salariés . effectif >= 50
          alors: 0.10%
        - sinon: 0.05%
  description: Contribution conventionnelle Syntec additionnelle à la contribution légale de formation professionnelle.
  références:
    Accord du 31 octobre 2019 et avenant n° 3 du 27 octobre 2022 relatifs à la formation professionnelle: https://www.legifrance.gouv.fr/conv_coll/article/KALIARTI000047441163
    Arrêté du 31 mars 2023 portant extension: https://www.legifrance.gouv.fr/jorf/id/JORFTEXT000047434427