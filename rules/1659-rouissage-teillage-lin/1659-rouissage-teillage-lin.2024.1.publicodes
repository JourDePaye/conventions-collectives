# Convention collective nationale du rouissage-teillage de lin du 28 janvier 1992 (IDCC 1659).
# Version 2024.1 : avenant n° 37 du 10 janvier 2024 relatif aux salaires,
# étendu en juillet 2024 ; application au 1er janvier 2024.
validFrom: 2024-01-01
sources:
  - >-
    Avenant n° 37 du 10 janvier 2024 relatif aux salaires, article 1er et
    annexe salariale : revalorisation de 3,5 % au 1er janvier 2024 ; texte
    officiel Légifrance KALIARTI000049271188.
    https://www.legifrance.gouv.fr/conv_coll/article/KALIARTI000049271188
  - >-
    Annexe salariale et texte officiel de la convention collective nationale du
    rouissage-teillage de lin, IDCC 1659, Légifrance KALITEXT000005654162,
    conteneur KALICONT000005635927.
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000005654162
  - >-
    Arrêté d'extension publié au Journal officiel le 17 juillet 2024, JORF
    n° 0164 du 11 juillet 2024 ; extension de l'avenant salarial au champ IDCC
    1659. Les accords et avenants dédiés aux cotisations, santé, prévoyance,
    retraite, formation, AT/MP, primes, indemnités, avantages et frais ont été
    recherchés pour l'audit de paie.
    https://www.legifrance.gouv.fr/jorf/jo/2024/07/11/0164
  - >-
    Convention collective nationale du rouissage-teillage de lin du 28 janvier
    1992, IDCC 1659, conteneur officiel Légifrance KALICONT000005635927.
    https://www.legifrance.gouv.fr/conv_coll/id/KALICONT000005635927
---
salarié . convention collective . rouissage teillage lin:
  titre: Rouissage-teillage de lin (IDCC 1659)
  valeur: convention collective = 'rouissage teillage lin'

salarié . convention collective . rouissage teillage lin . coefficient:
  titre: Coefficient de classification
  description: Coefficient de l'annexe salariale 2024.1.
  applicable si: convention collective = 'rouissage teillage lin'
  par défaut: 120

salarié . convention collective . rouissage teillage lin . salaire minimum conventionnel:
  titre: Rémunération minimale garantie mensuelle
  description: >-
    Rémunération minimale garantie mensuelle 2024.1 pour 151,67 heures,
    proratisée par la quotité de travail.
  applicable si:
    toutes ces conditions:
      - convention collective = 'rouissage teillage lin'
      - salaire minimum conventionnel . grille > 0 €/mois
  unité: €/mois
  produit:
    - salaire minimum conventionnel . grille
    - contrat . temps de travail . quotité

salarié . convention collective . rouissage teillage lin . salaire minimum conventionnel . grille:
  titre: Rémunération minimale garantie mensuelle à temps plein
  unité: €/mois
  variations:
    - si: coefficient = 600
      alors: 4529.68 €/mois
    - si: coefficient = 500
      alors: 3909.12 €/mois
    - si: coefficient = 400
      alors: 3190.50 €/mois
    - si: coefficient = 300
      alors: 2558.05 €/mois
    - si: coefficient = 270
      alors: 2406.37 €/mois
    - si: coefficient = 240
      alors: 2189.02 €/mois
    - si: coefficient = 190
      alors: 2122.41 €/mois
    - si: coefficient = 170
      alors: 2034.51 €/mois
    - si: coefficient = 160
      alors: 1994.55 €/mois
    - si: coefficient = 150
      alors: 1959.39 €/mois
    - si: coefficient = 140
      alors: 1892.26 €/mois
    - si: coefficient = 130
      alors: 1882.67 €/mois
    - si: coefficient = 125
      alors: 1871.48 €/mois
    - si: coefficient = 120
      alors: 1833.13 €/mois
    - sinon: 0 €/mois

salarié . convention collective . rouissage teillage lin . coefficient hors grille:
  titre: Coefficient hors grille modélisée
  description: Coefficient absent de l'annexe salariale 2024.1.
  applicable si: convention collective = 'rouissage teillage lin'
  variations:
    - si: coefficient = 120
      alors: non
    - si: coefficient = 125
      alors: non
    - si: coefficient = 130
      alors: non
    - si: coefficient = 140
      alors: non
    - si: coefficient = 150
      alors: non
    - si: coefficient = 160
      alors: non
    - si: coefficient = 170
      alors: non
    - si: coefficient = 190
      alors: non
    - si: coefficient = 240
      alors: non
    - si: coefficient = 270
      alors: non
    - si: coefficient = 300
      alors: non
    - si: coefficient = 400
      alors: non
    - si: coefficient = 500
      alors: non
    - si: coefficient = 600
      alors: non
    - sinon: oui

salarié . convention collective . rouissage teillage lin . audit paie:
  titre: Audit des rubriques conventionnelles de paie
  description: >-
    Une recherche dédiée a porté sur les taux de cotisations salarié et
    employeur, assiettes, plafonds, tranches, forfaits et exonérations, ainsi
    que sur les accords et avenants dédiés à la santé, prévoyance, retraite,
    formation professionnelle, AT/MP, primes, indemnités, avantages en nature,
    frais et leurs arrêtés d'extension. Aucun taux ou assiette conventionnel
    générique supplémentaire n'est calculé ici : ces éléments nécessitent des
    paramètres de régime, de catégorie, de contrat ou des entrées externes.
    Les règles générales de modele-social restent inchangées ; les omissions
    sont intentionnelles et testées par isolation.
  applicable si: convention collective = 'rouissage teillage lin'
  valeur: oui
