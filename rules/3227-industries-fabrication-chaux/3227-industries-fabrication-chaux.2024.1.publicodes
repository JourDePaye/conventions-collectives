validFrom: 2024-01-01
sources:
  - >-
    Accord du 27 février 2024 relatif aux salaires minimums et à la prime de vacances
    dans la convention collective nationale des industries de la fabrication de la chaux
    (IDCC 3227, brochure 3064), applicable au 1er janvier 2024.
  - >-
    Convention collective nationale des industries de la fabrication de la chaux du
    16 janvier 2018, textes et champ publiés dans la base officielle Légifrance/KALI.
---
salarié . convention collective . industries de la fabrication de la chaux:
  titre: Industries de la fabrication de la chaux (IDCC 3227)
  valeur: convention collective = 'industries de la fabrication de la chaux'

salarié . convention collective . industries de la fabrication de la chaux . catégorie:
  titre: Catégorie professionnelle
  description: Ouvriers, ETDAM ou cadres.
  applicable si: convention collective = 'industries de la fabrication de la chaux'
  par défaut: "'ouvriers'"

salarié . convention collective . industries de la fabrication de la chaux . coefficient:
  titre: Coefficient de classification
  applicable si: convention collective = 'industries de la fabrication de la chaux'
  par défaut: 130

salarié . convention collective . industries de la fabrication de la chaux . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Minimum mensuel ou douzième du minimum annuel selon la catégorie, proratisé selon la quotité de travail.
  unité: €/mois
  applicable si: convention collective = 'industries de la fabrication de la chaux'
  valeur: salaire minimum mensuel grille * contrat . temps de travail . quotité

salarié . convention collective . industries de la fabrication de la chaux . salaire minimum annuel conventionnel:
  titre: Salaire minimum annuel conventionnel
  unité: €/an
  applicable si: convention collective = 'industries de la fabrication de la chaux'
  valeur: salaire minimum annuel grille * contrat . temps de travail . quotité

salarié . convention collective . industries de la fabrication de la chaux . salaire minimum mensuel grille:
  titre: Grille mensuelle des ouvriers et ETDAM
  unité: €/mois
  applicable si: convention collective = 'industries de la fabrication de la chaux'
  variations:
    - si: catégorie = 'ouvriers'
      alors: salaire minimum mensuel ouvriers grille
    - si: catégorie = 'ETDAM'
      alors: salaire minimum annuel grille / 12
    - sinon: 0 €/mois

salarié . convention collective . industries de la fabrication de la chaux . salaire minimum mensuel ouvriers grille:
  titre: Grille mensuelle des ouvriers
  unité: €/mois
  applicable si: convention collective = 'industries de la fabrication de la chaux'
  variations:
    - si: coefficient = 130
      alors: 1995.59 €/mois
    - si: coefficient = 145
      alors: 2032.40 €/mois
    - si: coefficient = 155
      alors: 2056.98 €/mois
    - si: coefficient = 160
      alors: 2069.24 €/mois
    - si: coefficient = 170
      alors: 2093.80 €/mois
    - si: coefficient = 185
      alors: 2182.20 €/mois
    - si: coefficient = 205
      alors: 2405.36 €/mois
    - sinon: 0 €/mois

salarié . convention collective . industries de la fabrication de la chaux . salaire minimum annuel grille:
  titre: Grille annuelle des ETDAM
  unité: €/an
  applicable si:
    toutes ces conditions:
      - convention collective = 'industries de la fabrication de la chaux'
      - catégorie = 'ETDAM'
  variations:
    - si: coefficient = 150
      alors: 22795.73 €/an
    - si: coefficient = 155
      alors: 23003.27 €/an
    - si: coefficient = 160
      alors: 23240.45 €/an
    - si: coefficient = 165
      alors: 23507.30 €/an
    - si: coefficient = 170
      alors: 23803.43 €/an
    - si: coefficient = 175
      alors: 24129.74 €/an
    - si: coefficient = 180
      alors: 24485.35 €/an
    - si: coefficient = 185
      alors: 24870.79 €/an
    - si: coefficient = 190
      alors: 25286.05 €/an
    - si: coefficient = 195
      alors: 25730.98 €/an
    - si: coefficient = 200
      alors: 26205.36 €/an
    - si: coefficient = 205
      alors: 26709.02 €/an
    - si: coefficient = 210
      alors: 27242.71 €/an
    - si: coefficient = 215
      alors: 27806.04 €/an
    - si: coefficient = 220
      alors: 28389.32 €/an
    - si: coefficient = 225
      alors: 29012.12 €/an
    - si: coefficient = 230
      alors: 29664.60 €/an
    - si: coefficient = 235
      alors: 30346.34 €/an
    - si: coefficient = 240
      alors: 31057.37 €/an
    - si: coefficient = 250
      alors: 31826.96 €/an
    - sinon: 0 €/an

salarié . convention collective . industries de la fabrication de la chaux . prime de vacances:
  titre: Prime de vacances
  description: Montant annuel maintenu par l'accord salarial du 27 février 2024.
  unité: €/an
  applicable si: convention collective = 'industries de la fabrication de la chaux'
  valeur: 2200 €/an

salarié . convention collective . industries de la fabrication de la chaux . coefficient hors grille:
  titre: Coefficient absent de la grille modélisée
  applicable si: convention collective = 'industries de la fabrication de la chaux'
  variations:
    - si: catégorie = 'ouvriers'
      alors: salaire minimum mensuel ouvriers grille = 0 €/mois
    - si: catégorie = 'ETDAM'
      alors: salaire minimum annuel grille = 0 €/an
    - sinon: oui

salarié . convention collective . industries de la fabrication de la chaux . audit paie:
  titre: Audit conventionnel des rubriques de paie
  description: >-
    Audit explicite des taux salarié et employeur, assiettes, plafonds, tranches,
    forfaits, cotisations, santé, prévoyance, retraite, formation, AT/MP, primes,
    avantages en nature, exonérations et frais. L'accord du 27 février 2024 ne fixe
    pas de taux ou base conventionnels génériques calculables pour ces cotisations,
    ni de régime santé/prévoyance ou AT/MP ; ces éléments dépendent des textes dédiés,
    de la catégorie, de l'effectif, du risque et de paramètres externes. Les salaires
    minima et la prime de vacances sont modélisés séparément. Les cadres et toute
    classification absente des tableaux consultés restent non modélisés plutôt que
    déduits d'une autre catégorie.
  applicable si: convention collective = 'industries de la fabrication de la chaux'
  valeur: oui
