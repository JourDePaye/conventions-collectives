validFrom: '2026-02-01'
sources:
  - https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000054092365
  - https://www.legifrance.gouv.fr/conv_coll/article/KALIARTI000054092368
  - https://www.legifrance.gouv.fr/conv_coll/id/KALICONT000017941839?facetteEtat=VIGUEUR_ETEN
  - https://www.probtp.com/files/live/sites/probtp/files/media/pdf/PRO/declarations/notice-entreprise-assiette-taux.pdf
---
salarié . convention collective . bâtiment cadres:
  titre: Bâtiment — cadres (IDCC 2420)
  valeur: convention collective = 'bâtiment cadres'
  description: >-
    Convention collective nationale des cadres du bâtiment. Cette version
    reproduit exclusivement l'avenant n° 78 du 19 janvier 2026 relatif aux
    appointements minimaux au 1er février 2026, pour un horaire hebdomadaire de
    39 heures. L'avenant est indiqué en vigueur non étendu : ces minima ne sont
    pas présentés comme universellement étendus.
salarié . convention collective . bâtiment cadres . coefficient:
  question: Quel est le coefficient du cadre ?
  par défaut: 60
  unité: coefficient
salarié . convention collective . bâtiment cadres . champ juridique:
  question: L'employeur est-il signataire ou adhérent au texte non étendu ?
  une possibilité:
    - "'employeur signataire ou adhérent'"
    - "'autre employeur'"
  par défaut: "'employeur signataire ou adhérent'"
salarié . convention collective . bâtiment cadres . date de calcul:
  question: À quelle date le minimum mensuel doit-il être vérifié ?
  par défaut: 01/02/2026
salarié . convention collective . bâtiment cadres . grille mensuelle:
  applicable si:
    toutes ces conditions:
      - convention collective = 'bâtiment cadres'
      - champ juridique = 'employeur signataire ou adhérent'
      - date de calcul >= 01/02/2026
      - date de calcul <= 31/12/2026
  unité: €/mois
  variations:
    - si: coefficient = 60
      alors: 2356 €/mois
    - si: coefficient = 65
      alors: 2553 €/mois
    - si: coefficient = 70
      alors: 2740 €/mois
    - si: coefficient = 75
      alors: 2853 €/mois
    - si: coefficient = 80
      alors: 3036 €/mois
    - si: coefficient = 85
      alors: 3197 €/mois
    - si: coefficient = 90
      alors: 3353 €/mois
    - si: coefficient = 95
      alors: 3504 €/mois
    - si: coefficient = 100
      alors: 3622 €/mois
    - si: coefficient = 103
      alors: 3693 €/mois
    - si: coefficient = 108
      alors: 3827 €/mois
    - si: coefficient = 120
      alors: 4145 €/mois
    - si: coefficient = 130
      alors: 4411 €/mois
    - si: coefficient = 162
      alors: 5472 €/mois
    - sinon: 0 €/mois
salarié . convention collective . bâtiment cadres . coefficient hors grille:
  applicable si: convention collective = 'bâtiment cadres'
  toutes ces conditions:
    - coefficient != 60
    - coefficient != 65
    - coefficient != 70
    - coefficient != 75
    - coefficient != 80
    - coefficient != 85
    - coefficient != 90
    - coefficient != 95
    - coefficient != 100
    - coefficient != 103
    - coefficient != 108
    - coefficient != 120
    - coefficient != 130
    - coefficient != 162
salarié . convention collective . bâtiment cadres . période hors couverture:
  applicable si: convention collective = 'bâtiment cadres'
  une de ces conditions:
    - date de calcul < 01/02/2026
    - date de calcul > 31/12/2026
salarié . convention collective . bâtiment cadres . champ hors couverture:
  applicable si:
    toutes ces conditions:
      - convention collective = 'bâtiment cadres'
      - champ juridique = 'autre employeur'
salarié . convention collective . bâtiment cadres . calcul bloqué:
  applicable si: convention collective = 'bâtiment cadres'
  une de ces conditions:
    - coefficient hors grille
    - période hors couverture
    - champ hors couverture
    - champ juridique = 'autre employeur'
salarié . convention collective . bâtiment cadres . salaire minimum conventionnel:
  applicable si:
    toutes ces conditions:
      - convention collective = 'bâtiment cadres'
      - calcul bloqué = non
  unité: €/mois
  valeur: grille mensuelle
salarié . convention collective . bâtiment cadres . prévoyance cadre:
  applicable si:
    toutes ces conditions:
      - convention collective = 'bâtiment cadres'
      - contrat . statut cadre = oui
  rend non applicable: cotisations . prévoyances . employeur . cadres
  somme:
    - employeur
    - salarié
  avec:
    employeur:
      barème:
        assiette: contrat . salaire brut
        multiplicateur: plafond sécurité sociale
        tranches:
          - taux: 1.50%
            plafond: 1
          - taux: 50% * 2.40%
            plafond: 4
      remplace: cotisations . prévoyances . employeur . cadres
    salarié:
      barème:
        assiette: contrat . salaire brut
        multiplicateur: plafond sécurité sociale
        tranches:
          - taux: 0%
            plafond: 1
          - taux: 50% * 2.40%
            plafond: 4
      remplace: cotisations . prévoyances . employeur . cadres
  description: >-
    Régime national de prévoyance des cadres du BTP : tranche A employeur à
    1,50 % et tranche B partagée à 50 % de 2,40 % jusqu'à quatre plafonds de
    sécurité sociale. La tranche C optionnelle n'est pas calculée.
salarié . convention collective . bâtiment cadres . tranche C incluse:
  applicable si: convention collective = 'bâtiment cadres'
  par défaut: non
