# Convention collective nationale des activités industrielles de boulangerie et pâtisserie
# et des professionnels de l'œuf du 1er octobre 2024 (IDCC 3255, KALICONT000051160618).
# Version 2026.1 : grille de l'avenant n° 4 du 22 janvier 2026, applicable au 1er mars 2026.

validFrom: 2026-03-01
extension: 2026-04-17
sources:
  - "Avenant n° 4 du 22 janvier 2026 relatif à la modification de l'article 21 « Salaires minima conventionnels » de la convention collective nationale du 1er octobre 2024 (IDCC 3255), grille applicable à compter du 1er mars 2026 ; étendu par arrêté du 2 avril 2026 (JORF du 17 avril 2026), BOCC 2026-8. KALITEXT000054162284, https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000054162284"
  - "Convention collective nationale du 1er octobre 2024, étendue par arrêté du 20 novembre 2025 (JORF du 27 novembre 2025), conteneur KALICONT000051160618. https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000051150351"
  - "L'avenant n° 4 ne reprend que la grille de la nouvelle classification : les grilles sectorielles transitoires (OE1 à CA5 et œufs I-1 à IX-3) ne sont plus publiées à partir du 1er mars 2026 et sont donc hors grille."
---
salarié . convention collective . boulangerie industrielle:
  titre: Activités industrielles de boulangerie et pâtisserie et professionnels de l'œuf (IDCC 3255)
  valeur: convention collective = 'boulangerie industrielle'

salarié . convention collective . boulangerie industrielle . niveau:
  titre: Niveau et échelon de classification
  description: Niveau et échelon de la grille de la nouvelle classification, de A1 à M (par exemple C2, I ou M).
  applicable si: convention collective = 'boulangerie industrielle'
  par défaut: "'non renseigné'"

salarié . convention collective . boulangerie industrielle . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Salaire minimum conventionnel brut mensuel pour 151,67 heures, proratisé selon la quotité de travail. Vaut 0 €/mois si la classification est absente de la grille.
  applicable si: convention collective = 'boulangerie industrielle'
  unité: €/mois
  produit:
    - grille
    - contrat . temps de travail . quotité

salarié . convention collective . boulangerie industrielle . salaire minimum conventionnel . grille:
  titre: Salaire mensuel minimum à temps plein
  description: Grille mensuelle des niveaux A1 à M, article 21 de la convention modifié par l'avenant n° 4 du 22 janvier 2026, applicable au 1er mars 2026 pour 151,67 heures mensuelles.
  applicable si: convention collective = 'boulangerie industrielle'
  unité: €/mois
  variations:
    - si: niveau = 'A1'
      alors: 1826.03 €/mois
    - si: niveau = 'A2'
      alors: 1835.74 €/mois
    - si: niveau = 'B1'
      alors: 1846.55 €/mois
    - si: niveau = 'B2'
      alors: 1861.32 €/mois
    - si: niveau = 'C1'
      alors: 1877.42 €/mois
    - si: niveau = 'C2'
      alors: 1894.32 €/mois
    - si: niveau = 'C3'
      alors: 1915.16 €/mois
    - si: niveau = 'D1'
      alors: 1940.35 €/mois
    - si: niveau = 'D2'
      alors: 1955.88 €/mois
    - si: niveau = 'D3'
      alors: 1977.39 €/mois
    - si: niveau = 'E1'
      alors: 2012.29 €/mois
    - si: niveau = 'E2'
      alors: 2044.48 €/mois
    - si: niveau = 'E3'
      alors: 2098.66 €/mois
    - si: niveau = 'F1'
      alors: 2227.46 €/mois
    - si: niveau = 'F2'
      alors: 2248.61 €/mois
    - si: niveau = 'F3'
      alors: 2280.1 €/mois
    - si: niveau = 'G1'
      alors: 2326.72 €/mois
    - si: niveau = 'G2'
      alors: 2369.76 €/mois
    - si: niveau = 'G3'
      alors: 2440.85 €/mois
    - si: niveau = 'H1'
      alors: 2574.03 €/mois
    - si: niveau = 'H2'
      alors: 2640.95 €/mois
    - si: niveau = 'H3'
      alors: 2750.55 €/mois
    - si: niveau = 'I'
      alors: 2925.42 €/mois
    - si: niveau = 'J1'
      alors: 3107.05 €/mois
    - si: niveau = 'J2'
      alors: 3212.69 €/mois
    - si: niveau = 'J3'
      alors: 3318.7 €/mois
    - si: niveau = 'K1'
      alors: 3502.38 €/mois
    - si: niveau = 'K2'
      alors: 3691.5 €/mois
    - si: niveau = 'K3'
      alors: 3879.77 €/mois
    - si: niveau = 'L1'
