validFrom: 2024-01-01
sources:
  - >-
    Convention collective nationale du personnel navigant technique des exploitants d'hélicoptères,
    IDCC 1612, avenant n° 8 du 21 novembre 2023 relatif aux salaires minima,
    Légifrance, texte KALITEXT000049938920.
    https://www.legifrance.gouv.fr/conv_coll/id/KALITEXT000049938920
  - >-
    Avenant n° 8 du 21 novembre 2023, article 4 et annexe salaires minima,
    KALIARTI000049938925.
    https://www.legifrance.gouv.fr/conv_coll/id/KALIARTI000049938925
  - >-
    Convention collective nationale du 13 novembre 1996, IDCC 1612,
    KALICONT000005635114.
    https://www.legifrance.gouv.fr/conv_coll/id/KALICONT000005635114
---
salarié . convention collective . personnel navigant technique hélicoptères:
  titre: Personnel navigant technique des exploitants d'hélicoptères (IDCC 1612)
  valeur: convention collective = 'personnel navigant technique hélicoptères'

salarié . convention collective . personnel navigant technique hélicoptères . classification:
  titre: Classification conventionnelle
  description: Classification FTR de l'avenant n° 8 relatif aux salaires minima.
  applicable si: convention collective = 'personnel navigant technique hélicoptères'
  par défaut: "'FTR1-1'"

salarié . convention collective . personnel navigant technique hélicoptères . minimum mensuel de la grille:
  titre: Salaire minimum mensuel conventionnel avant proratisation
  description: Minimum mensuel brut pour 151,67 heures publié par l'avenant n° 8.
  applicable si: convention collective = 'personnel navigant technique hélicoptères'
  unité: €/mois
  variations:
    - si: classification = 'FTR1-1'
      alors: 2813 €/mois
    - si: classification = 'FTR1-2'
      alors: 3198 €/mois
    - si: classification = 'FTR1-3'
      alors: 3541 €/mois
    - si: classification = 'FTR2-1'
      alors: 3954 €/mois
    - si: classification = 'FTR2-2'
      alors: 4427 €/mois
    - si: classification = 'FTR2-3'
      alors: 4831 €/mois
    - si: classification = 'FTR3-1'
      alors: 5144 €/mois
    - si: classification = 'FTR3-2'
      alors: 5757 €/mois
    - si: classification = 'FTR3-3'
      alors: 6473 €/mois
    - si: classification = 'FTR4-1'
      alors: 6761 €/mois
    - si: classification = 'FTR4-2'
      alors: 7408 €/mois
    - si: classification = 'FTR4-3'
      alors: 8242 €/mois
    - si: classification = 'FTR5-1'
      alors: 9002 €/mois
    - si: classification = 'FTR5-2'
      alors: 10239 €/mois
    - si: classification = 'FTR5-3'
      alors: 11712 €/mois
    - si: classification = 'FTR6-1'
      alors: 12941 €/mois
    - si: classification = 'FTR6-2'
      alors: 14026 €/mois
    - si: classification = 'FTR6-3'
      alors: 15067 €/mois
    - si: classification = 'FTR7-1'
      alors: 15769 €/mois
    - si: classification = 'FTR7-2'
      alors: 17090 €/mois
    - si: classification = 'FTR7-3'
      alors: 18562 €/mois
    - si: classification = 'FTR8-1'
      alors: 19172 €/mois
    - si: classification = 'FTR8-2'
      alors: 20862 €/mois
    - si: classification = 'FTR8-3'
      alors: 22624 €/mois
    - sinon: salaire minimum conventionnel hors grille

salarié . convention collective . personnel navigant technique hélicoptères . salaire minimum conventionnel:
  titre: Salaire minimum mensuel conventionnel
  description: Minimum mensuel brut pour 151,67 heures, proratisé selon la quotité de travail.
  applicable si: convention collective = 'personnel navigant technique hélicoptères'
  unité: €/mois
  valeur: minimum mensuel de la grille * contrat . temps de travail . quotité

salarié . convention collective . personnel navigant technique hélicoptères . salaire minimum conventionnel hors grille:
  titre: Classification absente de la grille
  description: La classification doit être une entrée FTR1-1 à FTR8-3 publiée par l'avenant n° 8.
  applicable si: convention collective = 'personnel navigant technique hélicoptères'
  valeur: non

salarié . convention collective . personnel navigant technique hélicoptères . audit paie:
  titre: Audit des rubriques de paie
  description: Les textes de base, salaires, avenants dédiés et extensions ont été recherchés pour les taux et assiettes salarié/employeur, plafonds et tranches, forfaits, santé, prévoyance, formation, AT/MP, retraite, primes, avantages et frais ; aucun taux conventionnel générique supplémentaire n'est calculé par cette version.
  applicable si: convention collective = 'personnel navigant technique hélicoptères'
  valeur: non
